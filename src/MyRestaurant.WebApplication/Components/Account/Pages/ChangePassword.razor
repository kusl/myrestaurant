@page "/account/change-password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]
@using MyRestaurant.Domain.Authentication
@inject UserManager<Person> UserManager
@inject SignInManager<Person> SignInManager
@inject ISecurityEventLog SecurityEventLog
@inject NavigationManager Navigation

@* The voluntary password page (TECHNICAL_SPECIFICATION §3.2, §4.6, §11.6) — the "password" half of
   the profile page's credential management, alongside the authenticator and passkey pages.

   Distinct from ChangePasswordRequired.razor, which is obligation (1) of the §3.5 pipeline: that page
   is reachable only while must_change_password is set, is exempt from the pipeline, and clears the
   flag. This one is an ordinary authenticated destination — a person with an outstanding obligation
   is routed to the forced page by the middleware and never lands here.

   Two branches, two named forms, because a password-less account (passkey-only, §3.2) has no current
   password to confirm and DataAnnotations cannot make [Required] conditional:
     • "change-password" — current + new + confirm → UserManager.ChangePasswordAsync;
     • "add-password"    — new + confirm          → UserManager.AddPasswordAsync.
   Both record `password_changed` (§8.2 has no separate "password added" type, and from the audit's
   point of view that is what happened), and both re-issue the cookie: the framework rotates the
   security stamp inside UpdatePasswordHash, so without RefreshSignInAsync the person would be signed
   out of their own session within the five-minute revalidation window (§3.1). Static SSR for exactly
   that reason — a circuit cannot write the cookie. *@

<PageTitle>@(_hasPassword ? "Change your password" : "Add a password")</PageTitle>

@* Guarded on _person for the same reason as every other static-SSR account page: the intermediate
   render that fires when OnInitializedAsync suspends must not dereference anything. *@
@if (_person is not null)
{
    <section class="panel account-panel">
        <p class="eyebrow">Your account</p>

        @if (_hasPassword)
        {
            <h1>Change your password</h1>
            <p class="lede">
                Pick something at least 12 characters long — length is the only rule, so a short
                sentence works well. Your other sign-in methods are unaffected.
            </p>
        }
        else
        {
            <h1>Add a password</h1>
            <p class="lede">
                This account signs in without a password today. Adding one gives you a way in from a
                device that does not hold one of your passkeys. At least 12 characters — length is
                the only rule.
            </p>
        }

        @if (_errors.Count > 0)
        {
            <ul class="status-error" role="alert">
                @foreach (string error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        @if (_hasPassword)
        {
            <EditForm Model="ChangeInput" method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="current-password">Current password</label>
                    <InputText id="current-password" type="password" @bind-Value="ChangeInput.CurrentPassword"
                               autocomplete="current-password" autofocus />
                    <ValidationMessage For="@(() => ChangeInput.CurrentPassword)" />
                </div>

                <div class="form-field">
                    <label for="new-password">New password</label>
                    <InputText id="new-password" type="password" @bind-Value="ChangeInput.NewPassword"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => ChangeInput.NewPassword)" />
                </div>

                <div class="form-field">
                    <label for="confirm-password">New password, again</label>
                    <InputText id="confirm-password" type="password" @bind-Value="ChangeInput.ConfirmPassword"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => ChangeInput.ConfirmPassword)" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="button-primary">Change password</button>
                    <a class="button-secondary" href="@AccountRoutes.Profile">Cancel</a>
                </div>
            </EditForm>
        }
        else
        {
            <EditForm Model="AddInput" method="post" OnValidSubmit="AddAsync" FormName="add-password">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="add-new-password">Password</label>
                    <InputText id="add-new-password" type="password" @bind-Value="AddInput.NewPassword"
                               autocomplete="new-password" autofocus />
                    <ValidationMessage For="@(() => AddInput.NewPassword)" />
                </div>

                <div class="form-field">
                    <label for="add-confirm-password">Password, again</label>
                    <InputText id="add-confirm-password" type="password" @bind-Value="AddInput.ConfirmPassword"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => AddInput.ConfirmPassword)" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="button-primary">Set password</button>
                    <a class="button-secondary" href="@AccountRoutes.Profile">Cancel</a>
                </div>
            </EditForm>
        }

        <p class="form-footnote">
            Forgotten your password? There is no self-service reset — ask the counter, who will
            identify you in person and have an administrator issue a temporary one (§4.5).
        </p>
    </section>
}

@code {
    private readonly List<string> _errors = [];

    private Person? _person;
    private bool _hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordInputModel ChangeInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "add-password")]
    private AddPasswordInputModel AddInput { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // BL0008: the form POSTs bind these themselves and may assign null, so the defaults live here.
        ChangeInput ??= new();
        AddInput ??= new();

        Person? user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo(AccountRoutes.SignIn);
            return;
        }

        _person = user;
        _hasPassword = user.PasswordHash is not null;
    }

    private async Task ChangeAsync()
    {
        Person? user = _person;
        if (user is null)
        {
            Navigation.NavigateTo(AccountRoutes.SignIn);
            return;
        }

        IdentityResult result = await UserManager.ChangePasswordAsync(
            user,
            ChangeInput.CurrentPassword,
            ChangeInput.NewPassword);

        if (!result.Succeeded)
        {
            _errors.Clear();
            _errors.AddRange(result.Errors.Select(error => error.Description));
            return;
        }

        await CompleteAsync(user, "password-changed");
    }

    private async Task AddAsync()
    {
        Person? user = _person;
        if (user is null)
        {
            Navigation.NavigateTo(AccountRoutes.SignIn);
            return;
        }

        // AddPasswordAsync re-reads the stored hash and refuses if one is already set, so a stale form
        // posted after a password was added elsewhere fails cleanly rather than overwriting it.
        IdentityResult result = await UserManager.AddPasswordAsync(user, AddInput.NewPassword);

        if (!result.Succeeded)
        {
            _errors.Clear();
            _errors.AddRange(result.Errors.Select(error => error.Description));
            return;
        }

        await CompleteAsync(user, "password-added");
    }

    private async Task CompleteAsync(Person user, string outcome)
    {
        // The subject is also the actor: this is the person changing their own password, so
        // actorPersonIdentifier stays null (the §8.2 convention — a non-null actor means somebody
        // else did it, as an administrative reset does).
        await SecurityEventLog.RecordAsync(
            user.PersonIdentifier,
            actorPersonIdentifier: null,
            SecurityEventType.PasswordChanged);

        // UpdatePasswordHash rotated the security stamp; re-issue the cookie so this session survives
        // the change instead of being cut at the next revalidation (§3.1).
        await SignInManager.RefreshSignInAsync(user);

        Navigation.NavigateTo($"{AccountRoutes.Profile}?done={outcome}");
    }

    private sealed class ChangePasswordInputModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Choose a new password.")]
        [MinLength(12, ErrorMessage = "Passwords are at least 12 characters (§3.2) — a short sentence works.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Repeat the new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two entries do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class AddPasswordInputModel
    {
        [Required(ErrorMessage = "Choose a password.")]
        [MinLength(12, ErrorMessage = "Passwords are at least 12 characters (§3.2) — a short sentence works.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Repeat the password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two entries do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
