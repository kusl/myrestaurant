@using System.Globalization
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.DataAccess.Orders
@using MyRestaurant.DataAccess.Sittings
@using MyRestaurant.Domain.Identifiers
@using MyRestaurant.Domain.LiveUpdates
@using MyRestaurant.Domain.Orders
@using MyRestaurant.WebApplication.Menu
@using MyRestaurant.WebApplication.Orders
@implements IDisposable
@inject IMenuDirectory MenuDirectory
@inject IMenuItemImageDirectory MenuItemPictures
@inject IMenuItemReactionDirectory MenuItemReactionReads
@inject IMenuItemReactions MenuItemReactionWrites
@inject IMenuItemCommentDirectory MenuItemCommentReads
@inject IMenuItemComments MenuItemCommentWrites
@inject IOrderReadModel OrderReads
@inject IOrderEventLog EventLog
@inject IOrderWorkflow Workflow
@inject ISittingDirectory Sittings
@inject IDomainEventBroadcaster Broadcaster
@inject IIdentifierFactory Identifiers
@inject RestaurantOptions Options
@inject RestaurantTime RestaurantClock

<div class="order-surface" id="table-order-surface"
     data-live="@IsLiveAttributeValue"
     data-loaded="@IsLoadedAttributeValue">
    @if (!_loaded)
    {
        <p class="lede">Loading your table…</p>
    }
    else if (_person is null)
    {
        <p class="status-error" role="alert">
            Your session has ended. Please <a href="@AccountRoutes.SignIn">sign in</a> again to see your order.
        </p>
    }
    else
    {
        <h2 class="table-heading">Who is here</h2>

        @if (_sitting is not null)
        {
            <p class="lede">
                Open since @RestaurantClock.Time(_sitting.OpenedAt) —
                @_roster.Count @(_roster.Count == 1 ? "person" : "people") at the table.
            </p>
        }

        <ul class="table-roster">
            @foreach (SittingMemberSummary member in _roster)
            {
                <li @key="member.PersonIdentifier">
                    <span class="table-roster-name">@member.RosterName</span>
                    @if (member.PersonIdentifier == Person)
                    {
                        <span class="chip">you</span>
                    }
                    <span class="table-roster-joined">joined @RestaurantClock.Time(member.JoinedAt)</span>
                </li>
            }
        </ul>

        <hr class="table-rule" />

        @if (_sitting is null)
        {
            <h2 class="table-heading order-settled-heading">This sitting has been settled</h2>
            <p class="lede">
                The counter has closed and settled this table, so nothing more can be ordered against it.
                What was ordered is below, and stays on <a href="/table/history">your order history</a>.
            </p>
        }
        else
        {
            <h2 class="table-heading">Your order</h2>

            @if (_sendStatus is { } sendStatus)
            {
                <p class="status-success" role="status">@sendStatus</p>
            }

            @if (_rejection is { Count: > 0 })
            {
                <div class="status-error" role="alert">
                    <p class="order-reject-lede">
                        <strong>Nothing was sent.</strong> A send is accepted or refused as a whole, so your
                        basket is exactly as you left it. Fix these and send again.
                    </p>
                    <ul class="order-reject-list">
                        @foreach (RejectedOperation problem in _rejection)
                        {
                            <li><strong>@problem.What</strong> — @problem.Reason</li>
                        }
                    </ul>
                </div>
            }

            @if (_pruneNotice is { } pruneNotice)
            {
                <p class="status-error order-prune-notice" role="status">@pruneNotice</p>
            }

            <div class="order-picker">
                <h3 class="order-picker-heading" id="order-picker-menu-heading">What would you like?</h3>

                @if (GroupedMenu.Count == 0)
                {
                    <p class="muted order-menu-empty">
                        There is nothing on the menu yet. Please ask a member of staff.
                    </p>
                }
                else
                {
                    <p class="order-picker-lede muted">
                        Tap an item to see what is in it. Nothing reaches the kitchen until you press Send.
                    </p>

                    int headingIndex = -1;

                    @foreach (MenuHeadingGroup menuSection in GroupedMenu)
                    {
                        headingIndex++;

                        <div class="order-menu-section" @key="menuSection.MenuSectionIdentifier">
                            <h4 class="order-menu-section-name" id="@SectionHeadingId(menuSection)">
                                @menuSection.MenuSectionName
                            </h4>

                            @if (menuSection.MenuSectionDescription.Length > 0)
                            {
                                <p class="order-menu-section-description">@menuSection.MenuSectionDescription</p>
                            }

                            <ul class="order-menu" aria-labelledby="@SectionHeadingId(menuSection)">
                                @foreach (MenuItemSummary item in menuSection.Items)
                                {
                                    bool isChosen = _pickedMenuItemIdentifier == item.MenuItemIdentifier;

                                    MenuItemImageMetadata? picture = PictureFor(item);

                                    <li class="order-menu-item @(isChosen ? "is-chosen" : string.Empty) @(item.IsActive ? string.Empty : "is-unavailable") @(picture is null ? string.Empty : "has-picture")"
                                        @key="item.MenuItemIdentifier">
                                        <button type="button" class="order-menu-choice"
                                                data-menu-item="@item.MenuItemIdentifier"
                                                aria-pressed="@(isChosen ? "true" : "false")"
                                                disabled="@(!item.IsActive)"
                                                @onclick="() => ChooseItem(item)">

                                            <span class="order-menu-body">
                                                <span class="order-menu-line">
                                                    <span class="order-menu-name">@item.Name</span>
                                                    <span class="order-menu-price">@Money(item.PriceAmount)</span>
                                                </span>

                                                @if (item.Description.Length > 0)
                                                {
                                                    <span class="order-menu-description">@item.Description</span>
                                                }

                                                @if (!item.IsActive)
                                                {
                                                    <span class="chip chip-warn">Currently unavailable</span>
                                                }
                                                else if (isChosen)
                                                {
                                                    <span class="chip chip-ok">Chosen</span>
                                                }
                                            </span>

                                            @if (picture is not null)
                                            {
                                                <img class="order-menu-thumbnail"
                                                     src="@MenuImageRoutes.ForImage(picture.MenuItemImageIdentifier)"
                                                     alt="@picture.AltText"
                                                     loading="@ThumbnailLoading(headingIndex)"
                                                     decoding="async" />
                                            }
                                        </button>

                                        @if (!item.IsActive)
                                        {
                                            <button type="button" class="order-menu-inspect"
                                                    data-menu-item-inspect="@item.MenuItemIdentifier"
                                                    aria-pressed="@(isChosen ? "true" : "false")"
                                                    @onclick="() => ChooseItem(item)">
                                                Read about<span class="visually-hidden"> @item.Name</span>
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }

                @if (PickedMenuItem is { } chosenItem)
                {
                    <div class="order-menu-detail" id="order-picker-detail" aria-live="polite">
                        <h4 class="order-menu-detail-name">@chosenItem.Name</h4>

                        @if (PictureFor(chosenItem) is { } chosenPicture)
                        {
                            <img class="order-menu-detail-picture"
                                 src="@MenuImageRoutes.ForImage(chosenPicture.MenuItemImageIdentifier)"
                                 alt=""
                                 decoding="async" />
                        }

                        <dl class="order-menu-facts">
                            <div>
                                <dt>Price</dt>
                                <dd>@Money(chosenItem.PriceAmount)</dd>
                            </div>
                            <div>
                                <dt>Available</dt>
                                <dd>@(chosenItem.IsActive ? "Yes — order away" : "Not right now")</dd>
                            </div>
                            <div>
                                <dt>On the menu since</dt>
                                <dd>@RestaurantClock.Date(chosenItem.CreatedAt)</dd>
                            </div>
                        </dl>

                        @if (chosenItem.Description.Length > 0)
                        {
                            <p class="order-menu-detail-description">@chosenItem.Description</p>
                        }
                        else
                        {
                            <p class="muted order-menu-detail-none">
                                Nothing else has been written down about this one yet. Ask a member of
                                staff if you would like to know more.
                            </p>
                        }

                        <div class="order-menu-detail-actions">
                            <button type="button"
                                    class="order-menu-like @(IsLikedByMe(chosenItem) ? "is-liked" : string.Empty)"
                                    data-menu-item-like="@chosenItem.MenuItemIdentifier"
                                    aria-pressed="@(IsLikedByMe(chosenItem) ? "true" : "false")"
                                    @onclick="() => ToggleLikeAsync(chosenItem)">
                                <span class="order-menu-like-glyph" aria-hidden="true">
                                    @(IsLikedByMe(chosenItem) ? "\u2665" : "\u2661")
                                </span>
                                <span class="order-menu-like-label">Like</span>
                            </button>
                        </div>

                        <div class="order-menu-comment">
                            <label class="order-menu-comment-label" for="order-menu-comment-body">
                                What did you think?
                                <span class="optional">(optional — only staff read it)</span>
                            </label>

                            <textarea id="order-menu-comment-body" class="order-menu-comment-body"
                                      rows="3" maxlength="@_commentBodyCap"
                                      data-menu-item-comment="@chosenItem.MenuItemIdentifier"
                                      placeholder="Best thing on the menu…"
                                      @key="chosenItem.MenuItemIdentifier"
                                      @bind="_commentDraft"></textarea>

                            <div class="order-menu-comment-actions">
                                <button type="button" class="order-menu-comment-save"
                                        @onclick="() => SaveCommentAsync(chosenItem)">
                                    Save
                                </button>

                                @if (HasStandingComment(chosenItem))
                                {
                                    <button type="button" class="order-menu-comment-withdraw"
                                            @onclick="() => WithdrawCommentAsync(chosenItem)">
                                        Withdraw
                                    </button>
                                }
                            </div>

                            @if (_commentNotice is { } commentNotice)
                            {
                                <p class="order-menu-comment-notice" role="status"
                                   data-comment-outcome="@_commentOutcome">@commentNotice</p>
                            }
                        </div>
                    </div>
                }

                <div class="form-field order-picker-quantity">
                    <label for="order-picker-quantity">Quantity</label>
                    <input id="order-picker-quantity" type="number" inputmode="numeric"
                           min="@OrderStaging.MinimumQuantity" max="@OrderStaging.MaximumQuantity" step="1"
                           @bind="_pickedQuantity" />
                </div>

                <div class="form-field">
                    <label for="order-picker-note">Anything to note? <span class="optional">(optional)</span></label>
                    <input id="order-picker-note" type="text" maxlength="200" autocomplete="off"
                           placeholder="No onions, extra hot…" @bind="_pickedNote" />
                </div>

                <div class="form-actions">
                    <button type="button" class="button-secondary" @onclick="StageItem">Add to basket</button>
                </div>

                @if (_stagingNotice is { } stagingNotice)
                {
                    <p class="status-error" role="alert">@stagingNotice</p>
                }
            </div>

            @if (_staging.IsEmpty)
            {
                <p class="muted order-basket-empty">
                    Your basket is empty. Pick something above — nothing reaches the kitchen until you press
                    <strong>Send</strong>.
                </p>
            }
            else
            {
                <ul class="order-basket">
                    @foreach (StagedOrderLine staged in _staging.Lines)
                    {
                        MenuItemSummary? item = MenuItem(staged.MenuItemIdentifier);

                        <li class="order-basket-line" @key="staged.StagingIdentifier">
                            <div class="order-line-main">
                                <span class="order-line-name">@(item?.Name ?? staged.MenuItemName)</span>
                                <span class="order-line-price">@Money(StagedLineTotal(staged))</span>
                            </div>

                            @if (staged.CustomizationNote is { } note)
                            {
                                <p class="order-line-note">“@note”</p>
                            }

                            @if (item is null || !item.IsActive)
                            {
                                <p class="order-line-warning">
                                    This became unavailable while it was in your basket. Take it out, or the
                                    whole send will be refused.
                                </p>
                            }

                            <div class="order-basket-controls">
                                <label class="order-basket-quantity">
                                    <span>Quantity</span>
                                    <input type="number" inputmode="numeric"
                                           min="@OrderStaging.MinimumQuantity" max="@OrderStaging.MaximumQuantity" step="1"
                                           value="@staged.Quantity"
                                           @onchange="args => ChangeStagedQuantity(staged.StagingIdentifier, args)" />
                                </label>
                                <button type="button" class="link-button danger"
                                        @onclick="() => Unstage(staged.StagingIdentifier)">
                                    Take out
                                </button>
                            </div>
                        </li>
                    }

                    @foreach (StagedRemoval removal in _staging.Removals)
                    {
                        <li class="order-basket-line is-removal" @key="removal.OrderLineIdentifier">
                            <div class="order-line-main">
                                <span class="order-line-name">Remove @removal.Description</span>
                            </div>
                            <div class="order-basket-controls">
                                <button type="button" class="link-button"
                                        @onclick="() => _staging.SetMarkedForRemoval(removal.OrderLineIdentifier, removal.Description, false)">
                                    Keep it after all
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            }

            <div class="form-actions order-send">
                <button type="button" class="button-primary" disabled="@(_staging.IsEmpty || _sending)"
                        @onclick="SendAsync">
                    @(_sending ? "Sending…" : SendLabel)
                </button>
                @if (!_staging.IsEmpty && StagedTotal > 0m)
                {
                    <span class="order-send-total">@Money(StagedTotal) to add</span>
                }
            </div>
        }

        <h3 class="order-subheading">@(_sitting is null ? "What you ordered" : "Sent to the kitchen")</h3>

        @if (_myLines.Count == 0)
        {
            <p class="muted">You have not sent anything yet.</p>
        }
        else
        {
            <ul class="order-lines">
                @foreach (NarratedOrderLine line in _myLines)
                {
                    <li class="order-line @(line.IsRemoved ? "is-removed" : string.Empty)" @key="line.OrderLineIdentifier">
                        <div class="order-line-main">
                            <span class="order-line-name">@line.Quantity × @MenuItemName(line.MenuItemIdentifier)</span>
                            <span class="order-line-price">@Money(line.Quantity * line.CurrentUnitPriceAmount)</span>
                        </div>

                        @if (line.CustomizationNote is { } note)
                        {
                            <p class="order-line-note">“@note”</p>
                        }

                        <p class="order-line-badges">
                            @if (line.IsRemoved)
                            {
                                <span class="chip chip-warn">Removed</span>
                            }
                            else if (line.IsFulfilled)
                            {
                                <span class="chip chip-ok">At your table</span>
                            }
                            else
                            {
                                <span class="chip">With the kitchen</span>
                            }
                            <span class="order-line-when">sent @RestaurantClock.Time(line.AddedAt)</span>
                        </p>

                        @if (line.IsRemoved)
                        {
                            <p class="order-line-detail">
                                Taken off by @ActorText(line.RemovedByActorRole, line.RemovedByActorPersonIdentifier, Person)@(line.RemovalReason is { } removalReason ? $" — {removalReason}" : string.Empty).
                            </p>
                        }

                        @foreach (NarratedPriceAdjustment adjustment in line.PriceAdjustments)
                        {
                            <p class="order-line-detail order-line-adjustment">
                                Price changed from <s>@Money(adjustment.PreviousUnitPriceAmount)</s>
                                to <strong>@Money(adjustment.NewUnitPriceAmount)</strong>
                                by @DescribeRole(adjustment.ActorRole) — @adjustment.Reason.
                            </p>
                        }

                        @if (_sitting is not null && line.GuestMayRemove(Person))
                        {
                            <label class="order-line-remove">
                                <input type="checkbox"
                                       checked="@_staging.IsMarkedForRemoval(line.OrderLineIdentifier)"
                                       @onchange="args => ToggleRemoval(line, args)" />
                                <span>Take this off my order on the next send</span>
                            </label>
                        }
                    </li>
                }
            </ul>
        }

        <dl class="order-totals">
            <div>
                <dt>Your total</dt>
                <dd>@Money(MyTotal)</dd>
            </div>
            <div>
                <dt>Table total</dt>
                <dd>@Money(TableTotal)</dd>
            </div>
        </dl>

        <h3 class="order-subheading">@(_sitting is null ? "The settled bill" : "The rest of the table")</h3>

        @if (OtherPeople.Count == 0)
        {
            <p class="muted">Nobody else at this table has ordered yet.</p>
        }
        else
        {
            <ul class="order-party">
                @foreach (SittingBillEntry entry in OtherPeople)
                {
                    <li class="order-party-order" @key="entry.GuestOrderIdentifier">
                        <div class="order-line-main">
                            <span class="order-line-name">@entry.BillName</span>
                            <span class="order-line-price">@Money(entry.PersonTotalAmount)</span>
                        </div>

                        @{
                            IReadOnlyList<OrderLineView> theirLines = LinesFor(entry.GuestOrderIdentifier);
                        }

                        @if (theirLines.Count == 0)
                        {
                            <p class="muted">Nothing on their order right now.</p>
                        }
                        else
                        {
                            <ul class="order-party-lines">
                                @foreach (OrderLineView theirLine in theirLines)
                                {
                                    <li @key="theirLine.OrderLineIdentifier">

                                        <span class="order-party-line-name">@theirLine.Quantity × @theirLine.MenuItemName</span>
                                        @if (theirLine.IsFulfilled)
                                        {
                                            <span class="chip chip-ok">At the table</span>
                                        }
                                        else
                                        {
                                            <span class="chip">With the kitchen</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    private sealed record RejectedOperation(string What, string Reason);

    private readonly OrderStaging _staging = new();

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationToken _stopping;
    private IDisposable? _subscription;
    private bool _disposed;

    private Guid? _person;
    private bool _loaded;

    private IReadOnlyList<MenuItemSummary> _menu = [];
    private Dictionary<Guid, MenuItemSummary> _menuById = new();

    private Dictionary<Guid, MenuItemImageMetadata> _picturesByItem = new();

    private HashSet<Guid> _likedByMe = [];

    private Dictionary<Guid, string> _myCommentsByItem = new();

    private int? _commentBodyCap;
    private string _commentDraft = string.Empty;
    private string? _commentNotice;
    private string? _commentOutcome;

    private IReadOnlyList<SittingMemberSummary> _roster = [];
    private TableSittingSummary? _sitting;
    private Guid? _myOrderIdentifier;
    private IReadOnlyList<NarratedOrderLine> _myLines = [];
    private IReadOnlyList<SittingBillEntry> _bill = [];
    private Dictionary<Guid, IReadOnlyList<OrderLineView>> _partyLinesByOrder = new();

    private Guid? _pickedMenuItemIdentifier;

    private int _pickedQuantity = OrderStaging.MinimumQuantity;
    private string _pickedNote = string.Empty;

    private string? _stagingNotice;
    private string? _sendStatus;
    private string? _pruneNotice;
    private IReadOnlyList<RejectedOperation>? _rejection;
    private bool _sending;

    [Parameter]
    [EditorRequired]
    public Guid TableId { get; set; }

    [Parameter]
    [EditorRequired]
    public Guid SittingId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid Person => _person ?? Guid.Empty;

    private MenuItemSummary? PickedMenuItem
        => _pickedMenuItemIdentifier is { } identifier ? MenuItem(identifier) : null;

    private IReadOnlyList<MenuHeadingGroup> GroupedMenu => MenuGrouping.VisibleToGuests(_menu);

    private static string SectionHeadingId(MenuHeadingGroup section)
        => $"order-menu-section-{section.MenuSectionIdentifier}";

    private MenuItemImageMetadata? PictureFor(MenuItemSummary item)
        => _picturesByItem.TryGetValue(item.MenuItemIdentifier, out MenuItemImageMetadata? picture)
            ? picture
            : null;

    private static string ThumbnailLoading(int headingIndex) => headingIndex == 0 ? "eager" : "lazy";

    private IReadOnlyList<SittingBillEntry> OtherPeople
        => _bill.Where(entry => entry.PersonIdentifier != _person).ToArray();

    private decimal MyTotal
        => _bill.FirstOrDefault(entry => entry.PersonIdentifier == _person)?.PersonTotalAmount ?? 0m;

    private decimal TableTotal => _bill.Sum(entry => entry.PersonTotalAmount);

    private decimal StagedTotal => _staging.Lines.Sum(StagedLineTotal);

    private string SendLabel
    {
        get
        {
            int count = _staging.OperationCount;
            return count == 0 ? "Send to the kitchen" : $"Send {count} change{(count == 1 ? string.Empty : "s")}";
        }
    }

    private string IsLiveAttributeValue => RendererInfo.IsInteractive ? "true" : "false";

    private string IsLoadedAttributeValue => _loaded ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        _stopping = _lifetime.Token;

        if (AuthenticationStateTask is not null)
        {
            AuthenticationState state = await AuthenticationStateTask;
            _person = PersonPrincipal.IdentifierFor(state.User);
        }

        if (_person is null)
        {
            _loaded = true;
            return;
        }

        await LoadMenuAsync();
        await LoadAsync();
        _loaded = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _person is null)
        {
            return;
        }

        _subscription = Broadcaster.Subscribe(OnDomainNotification);
    }

    private async Task LoadAsync()
    {
        if (_person is not { } person)
        {
            return;
        }

        TableSittingSummary? openSitting = await Sittings
            .GetOpenSittingForMemberAsync(TableId, person, _stopping);

        _sitting = openSitting is not null && openSitting.SittingIdentifier == SittingId ? openSitting : null;

        _roster = await Sittings.ListMembersAsync(SittingId, _stopping);

        _myOrderIdentifier = await OrderReads.FindLivingOrderAsync(SittingId, person, _stopping);
        _myLines = _myOrderIdentifier is { } orderIdentifier
            ? OrderNarrative.FromEvents(await EventLog.ReadEventsAsync(orderIdentifier, _stopping))
            : [];

        _bill = await OrderReads.ListSittingBillAsync(SittingId, _stopping);

        IReadOnlyList<OrderLineView> partyLines = await OrderReads.ListLinesForSittingAsync(SittingId, _stopping);
        _partyLinesByOrder = partyLines
            .GroupBy(line => line.GuestOrderIdentifier)
            .ToDictionary(
                group => group.Key,
                group => (IReadOnlyList<OrderLineView>)group.ToArray());

        int dropped = _staging.PruneRemovals(_myLines
            .Where(line => line.GuestMayRemove(person))
            .Select(line => line.OrderLineIdentifier));

        if (dropped > 0)
        {
            _pruneNotice = dropped == 1
                ? "One line you had marked to remove is no longer yours to remove — it has been unticked."
                : $"{dropped} lines you had marked to remove are no longer yours to remove — they have been unticked.";
        }
    }

    private async Task LoadMenuAsync()
    {
        _menu = await MenuDirectory.ListAsync(_stopping);
        _menuById = _menu.ToDictionary(item => item.MenuItemIdentifier);

        _picturesByItem = (await MenuItemPictures.ListAsync(_stopping))
            .ToDictionary(picture => picture.MenuItemIdentifier);

        _likedByMe = _person is { } person
            ? (await MenuItemReactionReads.ListLikedByAsync(person, _stopping)).ToHashSet()
            : [];

        _myCommentsByItem = new();

        if (_person is { } author)
        {
            _myCommentsByItem = (await MenuItemCommentReads.ListForPersonAsync(author, _stopping))
                .ToDictionary(comment => comment.MenuItemIdentifier, comment => comment.Body);
        }

        _commentBodyCap ??= await MenuItemCommentReads.ReadDeclaredBodyCapAsync(_stopping);
    }

    private bool IsLikedByMe(MenuItemSummary item) => _likedByMe.Contains(item.MenuItemIdentifier);

    private async Task ToggleLikeAsync(MenuItemSummary item)
    {
        if (_person is not { } person)
        {
            return;
        }

        bool wanted = !_likedByMe.Contains(item.MenuItemIdentifier);

        SetMenuItemReactionResult result = await MenuItemReactionWrites.SetLikedAsync(
            item.MenuItemIdentifier, person, wanted, _stopping);

        if (result.IsLiked)
        {
            _likedByMe.Add(item.MenuItemIdentifier);
        }
        else
        {
            _likedByMe.Remove(item.MenuItemIdentifier);
        }
    }

    private string StandingComment(Guid? menuItemIdentifier)
        => menuItemIdentifier is { } identifier
            && _myCommentsByItem.TryGetValue(identifier, out string? body)
                ? body
                : string.Empty;

    private bool HasStandingComment(MenuItemSummary item)
        => _myCommentsByItem.ContainsKey(item.MenuItemIdentifier);

    private async Task SaveCommentAsync(MenuItemSummary item)
    {
        if (_person is not { } person)
        {
            return;
        }

        SubmitMenuItemCommentResult result = await MenuItemCommentWrites.SubmitAsync(
            item.MenuItemIdentifier, person, _commentDraft, _stopping);

        if (result.Submitted)
        {
            string stored = result.Body ?? string.Empty;

            _myCommentsByItem[item.MenuItemIdentifier] = stored;
            _commentDraft = stored;
        }

        _commentOutcome = result.Outcome.ToString();

        _commentNotice = result.Outcome switch
        {
            SubmitMenuItemCommentOutcome.Submitted =>
                "Saved. Only staff read it, and you can change it or withdraw it whenever you like.",
            SubmitMenuItemCommentOutcome.NoChange =>
                "That is word for word what you had already said, so nothing was written.",
            SubmitMenuItemCommentOutcome.BodyBlank =>
                "There is nothing here to save. Write something, or press Withdraw to take back what"
                + " you said before.",
            SubmitMenuItemCommentOutcome.BodyOverCap =>
                "That is longer than this box can store. Shorten it and save again.",
            _ => "This dish has come off the menu, so there is nothing left to say it about.",
        };
    }

    private async Task WithdrawCommentAsync(MenuItemSummary item)
    {
        if (_person is not { } person)
        {
            return;
        }

        WithdrawMenuItemCommentOutcome outcome = await MenuItemCommentWrites.WithdrawAsync(
            item.MenuItemIdentifier, person, _stopping);

        if (outcome is WithdrawMenuItemCommentOutcome.Withdrawn)
        {
            _myCommentsByItem.Remove(item.MenuItemIdentifier);
            _commentDraft = string.Empty;
        }

        _commentOutcome = outcome.ToString();

        _commentNotice = outcome switch
        {
            WithdrawMenuItemCommentOutcome.Withdrawn =>
                "Withdrawn. Staff no longer see it; that you wrote it and took it back stays in the log.",
            WithdrawMenuItemCommentOutcome.NoComment =>
                "You have not said anything about this one.",
            _ => "This dish has come off the menu, so there is nothing left to withdraw.",
        };
    }

    private void ChooseItem(MenuItemSummary item)
    {
        _pickedMenuItemIdentifier =
            _pickedMenuItemIdentifier == item.MenuItemIdentifier ? null : item.MenuItemIdentifier;

        _stagingNotice = null;
        _commentNotice = null;
        _commentOutcome = null;
        _commentDraft = StandingComment(_pickedMenuItemIdentifier);
    }

    private void StageItem()
    {
        _stagingNotice = null;

        if (PickedMenuItem is not { } menuItem)
        {
            _stagingNotice = "Choose something from the menu first.";
            return;
        }

        StagingResult result = _staging.Stage(menuItem, _pickedQuantity, _pickedNote);
        if (!result.Accepted)
        {
            _stagingNotice = result.Reason;
            return;
        }

        _pickedMenuItemIdentifier = null;
        _pickedQuantity = OrderStaging.MinimumQuantity;
        _pickedNote = string.Empty;
        _sendStatus = null;
        _rejection = null;
        _pruneNotice = null;
    }

    private void Unstage(Guid stagingIdentifier)
    {
        _staging.Unstage(stagingIdentifier);
        _stagingNotice = null;
        _sendStatus = null;
        _rejection = null;
        _pruneNotice = null;
    }

    private void ChangeStagedQuantity(Guid stagingIdentifier, ChangeEventArgs args)
    {
        if (!int.TryParse(
                args.Value?.ToString(),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out int quantity))
        {
            _stagingNotice = $"Choose a quantity between {OrderStaging.MinimumQuantity} and {OrderStaging.MaximumQuantity}.";
            return;
        }

        StagingResult result = _staging.SetQuantity(stagingIdentifier, quantity);
        _stagingNotice = result.Accepted ? null : result.Reason;
    }

    private void ToggleRemoval(NarratedOrderLine line, ChangeEventArgs args)
    {
        bool marked = args.Value is bool value && value;

        _staging.SetMarkedForRemoval(
            line.OrderLineIdentifier,
            $"{line.Quantity} × {MenuItemName(line.MenuItemIdentifier)}",
            marked);

        _sendStatus = null;
        _rejection = null;
        _pruneNotice = null;
    }

    private async Task SendAsync()
    {
        if (_person is not { } person || _staging.IsEmpty || _sending)
        {
            return;
        }

        _sending = true;
        _sendStatus = null;
        _rejection = null;
        _stagingNotice = null;
        _pruneNotice = null;

        try
        {
            StagedBatch batch = _staging.Build(Identifiers);

            AppendOrderEventResult result = await Workflow
                .SubmitGuestBatchAsync(SittingId, person, batch.Operations, _stopping);

            if (result.IsAppended)
            {
                _sendStatus = DescribeAcceptedSend(result.LinesAdded, result.LinesRemoved);
                _staging.Clear();
            }
            else
            {
                _rejection = DescribeRejection(result, batch);
            }

            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _sending = false;
        }
    }

    private static string DescribeAcceptedSend(int added, int removed)
    {
        if (added > 0 && removed > 0)
        {
            return $"Sent — {added} item{Plural(added)} added and {removed} taken off. The kitchen has been told.";
        }

        if (added > 0)
        {
            return $"Sent — {added} item{Plural(added)} on the way. The kitchen has been told.";
        }

        return $"Sent — {removed} item{Plural(removed)} taken off. The kitchen has been told.";
    }

    private static string Plural(int count) => count == 1 ? string.Empty : "s";

    private static IReadOnlyList<RejectedOperation> DescribeRejection(
        AppendOrderEventResult result,
        StagedBatch batch)
    {
        if (result.Outcome is AppendOrderEventOutcome.SittingNotFound or AppendOrderEventOutcome.OrderNotFound)
        {
            return [new RejectedOperation("This table", "It is no longer taking orders. Please speak to the counter.")];
        }

        List<RejectedOperation> problems = [];

        foreach (OrderMutationError error in result.Errors)
        {
            string what = error.OperationIndex >= 0 && error.OperationIndex < batch.Descriptions.Count
                ? batch.Descriptions[error.OperationIndex]
                : "This send";

            problems.Add(new RejectedOperation(what, error.Reason));
        }

        if (problems.Count == 0)
        {
            problems.Add(new RejectedOperation("This send", "It was refused. Please try again."));
        }

        return problems;
    }

    private void OnDomainNotification(DomainNotification notification)
    {
        bool concernsThisTable = notification switch
        {
            OrderLinesChanged changed => changed.SittingIdentifier == SittingId,
            LineFulfillmentChanged changed => changed.SittingIdentifier == SittingId,
            SittingMemberJoined joined => joined.SittingIdentifier == SittingId,
            SittingClosed closed => closed.SittingIdentifier == SittingId,
            MenuChanged => true,
            _ => false,
        };

        if (!concernsThisTable)
        {
            return;
        }

        bool menuChanged = notification is MenuChanged;

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (menuChanged)
                {
                    await LoadMenuAsync();
                }

                await LoadAsync();
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        });
    }

    private MenuItemSummary? MenuItem(Guid menuItemIdentifier)
        => _menuById.TryGetValue(menuItemIdentifier, out MenuItemSummary? item) ? item : null;

    private IReadOnlyList<OrderLineView> LinesFor(Guid guestOrderIdentifier)
        => _partyLinesByOrder.TryGetValue(guestOrderIdentifier, out IReadOnlyList<OrderLineView>? lines)
            ? lines
            : [];

    private string MenuItemName(Guid menuItemIdentifier) => MenuItem(menuItemIdentifier)?.Name ?? "Item";

    private decimal StagedLineTotal(StagedOrderLine staged)
        => (MenuItem(staged.MenuItemIdentifier)?.PriceAmount ?? 0m) * staged.Quantity;

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    private static string DescribeRole(OrderActorRole role) => role switch
    {
        OrderActorRole.Guest => "a guest",
        OrderActorRole.Kitchen => "the kitchen",
        OrderActorRole.Counter => "the counter",
        OrderActorRole.Administrator => "an administrator",
        _ => "staff",
    };

    private static string ActorText(OrderActorRole? role, Guid? actor, Guid person)
        => actor is { } actorIdentifier && actorIdentifier == person
            ? "you"
            : DescribeRole(role ?? OrderActorRole.Counter);

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _subscription?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
