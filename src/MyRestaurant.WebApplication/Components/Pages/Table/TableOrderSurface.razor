                        <div class="order-line-main">
                            <span class="order-line-name">@entry.BillName</span>
                            <span class="order-line-price">@Money(entry.PersonTotalAmount)</span>
                        </div>

                        @{
                            IReadOnlyList<OrderLineView> theirLines = LinesFor(entry.GuestOrderIdentifier);
                        }

                        @if (theirLines.Count == 0)
                        {
                            <p class="muted">Nothing on their order right now.</p>
                        }
                        else
                        {
                            <ul class="order-party-lines">
                                @foreach (OrderLineView theirLine in theirLines)
                                {
                                    <li @key="theirLine.OrderLineIdentifier">
                                        @* Named rather than bare, and with a class of its own rather than
                                           .order-line-name: this is the only text in §11.1 that a reader —
                                           an operator in dev tools, or §16.3 scenario 5 — has no way to
                                           address. The guest's own lines already carry .order-line-name and
                                           the kitchen's carry .kitchen-line-name; this was the gap. A
                                           distinct name because .order-line-name is bold, and the rest of
                                           the table is deliberately quieter than your own order. *@
                                        <span class="order-party-line-name">@theirLine.Quantity × @theirLine.MenuItemName</span>
                                        @if (theirLine.IsFulfilled)
                                        {
                                            <span class="chip chip-ok">At the table</span>
                                        }
                                        else
                                        {
                                            <span class="chip">With the kitchen</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        }
    }
