@code {
    /// <summary>One refused operation, already turned into two readable halves for the panel (§6.5.9).</summary>
    private sealed record RejectedOperation(string What, string Reason);

    private readonly OrderStaging _staging = new();

    // Captured once, so nothing ever touches _lifetime.Token after Dispose has run — the same shape
    // TableDisplay uses for its refresh loop.
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationToken _stopping;
    private IDisposable? _subscription;
    private bool _disposed;

    private Guid? _person;
    private bool _loaded;

    private IReadOnlyList<MenuItemSummary> _menu = [];
    private Dictionary<Guid, MenuItemSummary> _menuById = new();

    /// <summary>
    /// Which items have a picture, keyed by the item, read once per menu load.
    ///
    /// <para><b>One read for the whole menu rather than one per card, which is what
    /// <see cref="IMenuItemImageDirectory.ListAsync"/> exists for</b> — the same rule
    /// <c>ListLinesForSittingAsync</c> follows one panel down, and for the same reason: a round trip inside
    /// the render loop would turn a sixty-dish menu into sixty queries on every notification. An item with
    /// no picture is simply absent from this dictionary, because the read lists what is decorated rather
    /// than left-joining the whole menu.</para>
    /// </summary>
    private Dictionary<Guid, MenuItemImageMetadata> _picturesByItem = new();
    private IReadOnlyList<SittingMemberSummary> _roster = [];
    private TableSittingSummary? _sitting;
    private Guid? _myOrderIdentifier;
    private IReadOnlyList<NarratedOrderLine> _myLines = [];
    private IReadOnlyList<SittingBillEntry> _bill = [];
    private Dictionary<Guid, IReadOnlyList<OrderLineView>> _partyLinesByOrder = new();

    /// <summary>
    /// The item the guest has chosen, or <c>null</c> when none is. A <see cref="Guid"/> rather than the
    /// string a <c>&lt;select&gt;</c> bound to until M6 Slice 39: the card list reports an identifier and
    /// there is no longer a round trip through text to parse back.
    /// </summary>
    private Guid? _pickedMenuItemIdentifier;

    private int _pickedQuantity = OrderStaging.MinimumQuantity;
    private string _pickedNote = string.Empty;

    private string? _stagingNotice;
    private string? _sendStatus;
    private string? _pruneNotice;
    private IReadOnlyList<RejectedOperation>? _rejection;
    private bool _sending;

    /// <summary>The table this surface belongs to — used to re-check membership, never trusted for scoping a read.</summary>
    [Parameter]
    [EditorRequired]
    public Guid TableId { get; set; }

    /// <summary>
    /// The sitting the parent resolved. Every query is scoped by this rather than by the table, so a
    /// sitting that closes and is followed by a new one on the same table does not silently swap the
    /// order under the reader's feet — it flips to the settled view, which is what §11.1 asks for.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Guid SittingId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The signed-in person, for the render tree. Every branch that reads it sits behind an
    /// <c>_person is null</c> guard; the fallback exists so the property is total rather than relying on
    /// a pattern variable's definite assignment surviving Razor's generated control flow.
    /// </summary>
    private Guid Person => _person ?? Guid.Empty;

    /// <summary>
    /// The chosen item as the menu holds it <em>now</em>, or <c>null</c> when nothing is chosen — or when
    /// what was chosen has left the menu underneath the guest.
    ///
    /// <para>Re-resolved on every read rather than captured when the card was tapped, and that is the
    /// whole reason it is a property. <c>MenuChanged</c> makes this surface re-read the menu (§9), so a
    /// reprice or an "86" while the detail panel is open must change what the panel says — a captured
    /// <see cref="MenuItemSummary"/> would keep showing the price the item had when it was tapped, which
    /// is the one number §6.5.4 is explicit that this surface must not invent. The <c>null</c> case is
    /// real rather than defensive: §7's list is what this component holds, and an item absent from it is
    /// an item this surface cannot describe.</para>
    /// </summary>
    private MenuItemSummary? PickedMenuItem
        => _pickedMenuItemIdentifier is { } identifier ? MenuItem(identifier) : null;

    /// <summary>
    /// The menu as §11.1 renders it: one entry per heading a guest can see, each holding the items under
    /// it, in the order <see cref="IMenuDirectory.ListAsync"/> returned them.
    ///
    /// <para><b>The walk is <see cref="MenuGrouping"/>'s rather than this file's, and that is F-100.</b> It
    /// was written out here from Slice 40, which put §11.1's grouping and §7's two opposite-pointing
    /// visibility rules inside a Razor component — where, with no bUnit in this repository (§16.1), the
    /// only thing that could assert any of it was §16.3 scenario 17. <c>KitchenQueue</c>'s own summary is
    /// the sentence that applies: a rule that can only be checked by rendering a component is a rule
    /// nobody checks. What turned that from a preference into a defect is that §11.2's "86" panel needs the
    /// same walk with the opposite rule about hidden headings, so the alternative to moving it was pasting
    /// it — F-59's mechanism.</para>
    ///
    /// <para><b>Which door is the rule.</b> <see cref="MenuGrouping.VisibleToGuests"/> drops inactive
    /// headings and keeps inactive items, which is §7's asymmetry; the kitchen calls
    /// <see cref="MenuGrouping.EveryHeading"/> instead. Naming the rule at the call site rather than
    /// passing a flag is what makes this line readable without opening the other file. An empty heading
    /// still cannot occur, because groups are built from items.</para>
    ///
    /// <para>Re-computed on each read rather than cached, which is what it was before: the menu is
    /// single-digit-to-sixty rows, <c>MenuChanged</c> re-reads <c>_menu</c> underneath this (§9), and a
    /// cached grouping is a second place for the menu to be stale.</para>
    /// </summary>
    private IReadOnlyList<MenuHeadingGroup> GroupedMenu => MenuGrouping.VisibleToGuests(_menu);

    /// <summary>
    /// The id each heading's <c>&lt;ul&gt;</c> points at with <c>aria-labelledby</c>, so a screen reader
    /// announces which part of the menu a list belongs to. Built from the identifier rather than from the
    /// name, because a heading called "Sides &amp; extras" would otherwise produce an id with a space in
    /// it — and because two headings can never share an identifier where they could share a slug.
    ///
    /// <para>Local rather than on <see cref="MenuHeadingGroup"/>, and the prefix is why: <c>/kitchen</c>
    /// builds its own ids over the same headings, and an id prefix is a fact about one page's document
    /// rather than about a heading.</para>
    /// </summary>
    private static string SectionHeadingId(MenuHeadingGroup section)
        => $"order-menu-section-{section.MenuSectionIdentifier}";

    /// <summary>
    /// The stored picture for one item, or <c>null</c> when it has none.
    ///
    /// <para>Looked up from the dictionary rather than re-read, and looked up on every render pass rather
    /// than captured, for <see cref="PickedMenuItem"/>'s reason exactly: <c>MenuChanged</c> makes this
    /// surface re-read the menu and the pictures together (§9), so a replace while the panel is open must
    /// change the address the <c>&lt;img&gt;</c> points at. A captured metadata record would keep pointing
    /// at an identifier §7's route has already begun answering 404 for.</para>
    /// </summary>
    private MenuItemImageMetadata? PictureFor(MenuItemSummary item)
        => _picturesByItem.TryGetValue(item.MenuItemIdentifier, out MenuItemImageMetadata? picture)
            ? picture
            : null;

    /// <summary>
    /// Whether a card's thumbnail may wait until it is scrolled to: <c>"eager"</c> in the first heading,
    /// <c>"lazy"</c> in every heading after it.
    ///
    /// <para><b>The cut is per heading rather than per card, and the reason is that the server cannot know
    /// where the fold is.</b> How many cards fit above it depends on how long each description is, how wide
    /// the viewport is and how large the reader has set their text — none of which is available here. A
    /// heading is the coarsest unit that is certainly right at one end: the first heading's cards are the
    /// ones a guest is looking at when the page arrives, and no card in the second heading is, on any
    /// screen this application targets (§11.12's 375px). Guessing a card count would be a number invented
    /// here and wrong on somebody's phone.</para>
    ///
    /// <para><c>"eager"</c> is written out rather than left to the default, because the interesting property
    /// of this attribute is that it was <em>decided</em> — an omitted attribute reads as an oversight, and
    /// the next person to touch this markup would have no way to tell the two apart.</para>
    /// </summary>
    private static string ThumbnailLoading(int headingIndex) => headingIndex == 0 ? "eager" : "lazy";

    private IReadOnlyList<SittingBillEntry> OtherPeople
        => _bill.Where(entry => entry.PersonIdentifier != _person).ToArray();

    private decimal MyTotal
        => _bill.FirstOrDefault(entry => entry.PersonIdentifier == _person)?.PersonTotalAmount ?? 0m;

    private decimal TableTotal => _bill.Sum(entry => entry.PersonTotalAmount);

    private decimal StagedTotal => _staging.Lines.Sum(StagedLineTotal);

    private string SendLabel
    {
        get
        {
            int count = _staging.OperationCount;
            return count == 0 ? "Send to the kitchen" : $"Send {count} change{(count == 1 ? string.Empty : "s")}";
        }
    }

    /// <summary>
    /// Whether a live circuit produced this markup — <c>"true"</c> only in interactive-server rendering,
    /// <c>"false"</c> during the prerender pass. The same attribute, for the same reason, as
    /// <c>TableDisplay</c>'s.
    ///
    /// <para>This island is prerendered, so the picker, the basket and the totals all appear before any
    /// circuit exists — and every control on it is a click handler, which means a surface that never
    /// became interactive is indistinguishable from a live one until somebody taps something and nothing
    /// happens. "The basket stayed empty" is two steps from "no circuit was established", and the
    /// second is the sentence worth having. One attribute is what makes it available to an operator in
    /// dev tools and to the §16.3 scenarios that drive this surface.</para>
    /// </summary>
    private string IsLiveAttributeValue => RendererInfo.IsInteractive ? "true" : "false";

    /// <summary>
    /// Whether the reads behind this island have answered, published alongside <c>data-live</c> —
    /// §11.10's second bit, and the half this surface was missing until M6 Slice 23.
    ///
    /// <para>The circuit's first render is <c>data-live="true"</c> with <c>_loaded</c> still false, and
    /// this island renders "Loading your table…" in that state. Every barrier a scenario sets here is
    /// about content — a roster entry, a basket line, a committed line, a total — and all of it is
    /// absent at that instant. The waits downstream have always covered for it by going on to look for
    /// something specific; that is a race being waited out incidentally rather than a barrier, which is
    /// exactly what F-44 was about on <c>/counter</c>.</para>
    ///
    /// <para><c>_loaded</c> is also set on the <c>_person is null</c> path, deliberately: an expired
    /// cookie is a resolved state and the surface has something to say about it. Loaded does not mean
    /// "has content", it means "has finished deciding".</para>
    /// </summary>
    private string IsLoadedAttributeValue => _loaded ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        _stopping = _lifetime.Token;

        if (AuthenticationStateTask is not null)
        {
            AuthenticationState state = await AuthenticationStateTask;
            _person = PersonPrincipal.IdentifierFor(state.User);
        }

        if (_person is null)
        {
            _loaded = true;
            return;
        }

        await LoadMenuAsync();
        await LoadAsync();
        _loaded = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _person is null)
        {
            return;
        }

        // Only on the circuit: OnAfterRender does not run during prerendering, so the subscription is
        // never created for a render that is about to be thrown away.
        _subscription = Broadcaster.Subscribe(OnDomainNotification);
    }

    /// <summary>
    /// Everything the surface shows, re-read in one pass. Scoped by <see cref="SittingId"/> throughout;
    /// the only query keyed by the table is the membership/openness check, and its answer is discarded
    /// unless it names <em>this</em> sitting.
    /// </summary>
    private async Task LoadAsync()
    {
        if (_person is not { } person)
        {
            return;
        }

        TableSittingSummary? openSitting = await Sittings
            .GetOpenSittingForMemberAsync(TableId, person, _stopping);

        _sitting = openSitting is not null && openSitting.SittingIdentifier == SittingId ? openSitting : null;

        _roster = await Sittings.ListMembersAsync(SittingId, _stopping);

        _myOrderIdentifier = await OrderReads.FindLivingOrderAsync(SittingId, person, _stopping);
        _myLines = _myOrderIdentifier is { } orderIdentifier
            ? OrderNarrative.FromEvents(await EventLog.ReadEventsAsync(orderIdentifier, _stopping))
            : [];

        _bill = await OrderReads.ListSittingBillAsync(SittingId, _stopping);

        // One read for the whole sitting, grouped once, rather than a query per person in the render
        // loop below: §11.1 shows a row for everyone at the table, and a round trip inside that loop
        // would turn a six-person table into six extra queries on every notification.
        IReadOnlyList<OrderLineView> partyLines = await OrderReads.ListLinesForSittingAsync(SittingId, _stopping);
        _partyLinesByOrder = partyLines
            .GroupBy(line => line.GuestOrderIdentifier)
            .ToDictionary(
                group => group.Key,
                group => (IReadOnlyList<OrderLineView>)group.ToArray());

        // A tick that has gone stale — the kitchen fulfilled the line, or staff took it off — would
        // sink every subsequent send, because §6.5.9 refuses the whole event on one bad operation.
        // Drop those marks and say so, rather than letting the guest press Send into a wall.
        //
        // The notice is deliberately NOT cleared here, and that is a fix rather than an oversight. One
        // commit raises more than one notification: a fulfillment publishes OrderLinesChanged and then
        // LineFulfillmentChanged (§9, IOrderWorkflow.AppendAsync), and this surface re-reads on both.
        // Clearing at the top of every pass meant the second re-read erased the sentence the first had
        // just written, microseconds later — so in practice the guest's tick vanished from the basket
        // with no explanation at all, which is the one outcome this notice exists to prevent. It is
        // cleared instead wherever the guest touches the basket themselves, because that is the moment
        // it stops being news: StageItem, Unstage, ToggleRemoval and SendAsync.
        int dropped = _staging.PruneRemovals(_myLines
            .Where(line => line.GuestMayRemove(person))
            .Select(line => line.OrderLineIdentifier));

        if (dropped > 0)
        {
            _pruneNotice = dropped == 1
                ? "One line you had marked to remove is no longer yours to remove — it has been unticked."
                : $"{dropped} lines you had marked to remove are no longer yours to remove — they have been unticked.";
        }
    }

    private async Task LoadMenuAsync()
    {
        _menu = await MenuDirectory.ListAsync(_stopping);
        _menuById = _menu.ToDictionary(item => item.MenuItemIdentifier);

        // Read in the same pass as the menu, and re-read whenever the menu is: MenuChanged fires on an
        // attach, a replace, a removal and a caption change (§9), so a picture dictionary loaded once at
        // initialisation would be a second place for the menu to be stale — which is the exact defect the
        // GroupedMenu property's own note refuses to introduce one register up.
        _picturesByItem = (await MenuItemPictures.ListAsync(_stopping))
            .ToDictionary(picture => picture.MenuItemIdentifier);
    }

    /// <summary>
    /// Chooses one item off the menu — the tap the card list exists for. Choosing writes nothing
    /// anywhere: it selects, and it opens the detail panel.
    ///
    /// <para>Tapping the chosen item again <b>un</b>chooses it, which is the behaviour a pressed toggle
    /// button promises and is why the card is one rather than a link. It deliberately leaves the quantity
    /// and the note alone: a guest who typed "no onions" and then compared two items has not withdrawn
    /// the note, and clearing it would be this surface discarding something they typed. Those two are
    /// reset by <see cref="StageItem"/>, once the line is in the basket and they have been used.</para>
    ///
    /// <para>An inactive item never reaches here — its card is <c>disabled</c> (§7) — so this method has
    /// no availability check of its own. The guard that matters is in the send transaction, which
    /// re-reads the menu under the lock (§6.5.4, §6.6); everything on this surface refuses early only so
    /// the answer arrives at the moment of the tap.</para>
    /// </summary>
    private void ChooseItem(MenuItemSummary item)
    {
        _pickedMenuItemIdentifier =
            _pickedMenuItemIdentifier == item.MenuItemIdentifier ? null : item.MenuItemIdentifier;

        // A stale refusal beside a fresh choice reads as a refusal OF that choice.
        _stagingNotice = null;
    }

    private void StageItem()
    {
        _stagingNotice = null;

        if (PickedMenuItem is not { } menuItem)
        {
            _stagingNotice = "Choose something from the menu first.";
            return;
        }

        StagingResult result = _staging.Stage(menuItem, _pickedQuantity, _pickedNote);
        if (!result.Accepted)
        {
            _stagingNotice = result.Reason;
            return;
        }

        // A cleared picker is the signal that the tap landed; the basket below is the receipt.
        _pickedMenuItemIdentifier = null;
        _pickedQuantity = OrderStaging.MinimumQuantity;
        _pickedNote = string.Empty;
        _sendStatus = null;
        _rejection = null;
        _pruneNotice = null;
    }

    /// <summary>
    /// Takes a staged item back out (§11.1), and clears everything the previous send had to say.
    ///
    /// <para>The clearing is the part worth reading. §6.5.9's panel ends "Fix these and send again",
    /// and taking the offending item out <em>is</em> fixing it — leaving the panel up would tell the
    /// guest their basket is still broken at the moment they repaired it. <c>StageItem</c> and
    /// <c>ToggleRemoval</c> have always cleared it for the same reason; this was the one basket edit
    /// that did not, which is an inconsistency rather than a decision.</para>
    /// </summary>
    private void Unstage(Guid stagingIdentifier)
    {
        _staging.Unstage(stagingIdentifier);
        _stagingNotice = null;
        _sendStatus = null;
        _rejection = null;
        _pruneNotice = null;
    }

    private void ChangeStagedQuantity(Guid stagingIdentifier, ChangeEventArgs args)
    {
        if (!int.TryParse(
                args.Value?.ToString(),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out int quantity))
        {
            _stagingNotice = $"Choose a quantity between {OrderStaging.MinimumQuantity} and {OrderStaging.MaximumQuantity}.";
            return;
        }

        StagingResult result = _staging.SetQuantity(stagingIdentifier, quantity);
        _stagingNotice = result.Accepted ? null : result.Reason;
    }

    private void ToggleRemoval(NarratedOrderLine line, ChangeEventArgs args)
    {
        bool marked = args.Value is bool value && value;

        _staging.SetMarkedForRemoval(
            line.OrderLineIdentifier,
            $"{line.Quantity} × {MenuItemName(line.MenuItemIdentifier)}",
            marked);

        _sendStatus = null;
        _rejection = null;
        _pruneNotice = null;
    }

    /// <summary>
    /// §11.1's Send: one <c>guest_submission</c> owning every staged add and every ticked removal,
    /// through <see cref="IOrderWorkflow"/> so the commit is both counted (§12) and broadcast (§9). The
    /// basket is cleared only on an accepted event — a refusal leaves it exactly as it was, because
    /// §6.5.9 wrote nothing and the guest is being asked to restage, not to retype.
    /// </summary>
    private async Task SendAsync()
    {
        if (_person is not { } person || _staging.IsEmpty || _sending)
        {
            return;
        }

        _sending = true;
        _sendStatus = null;
        _rejection = null;
        _stagingNotice = null;
        _pruneNotice = null;

        try
        {
            StagedBatch batch = _staging.Build(Identifiers);

            AppendOrderEventResult result = await Workflow
                .SubmitGuestBatchAsync(SittingId, person, batch.Operations, _stopping);

            if (result.IsAppended)
            {
                _sendStatus = DescribeAcceptedSend(result.LinesAdded, result.LinesRemoved);
                _staging.Clear();
            }
            else
            {
                _rejection = DescribeRejection(result, batch);
            }

            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
            // The circuit went away mid-send. The transaction either committed or did not; either way
            // there is no longer anyone to tell.
        }
        finally
        {
            _sending = false;
        }
    }

    private static string DescribeAcceptedSend(int added, int removed)
    {
        if (added > 0 && removed > 0)
        {
            return $"Sent — {added} item{Plural(added)} added and {removed} taken off. The kitchen has been told.";
        }

        if (added > 0)
        {
            return $"Sent — {added} item{Plural(added)} on the way. The kitchen has been told.";
        }

        return $"Sent — {removed} item{Plural(removed)} taken off. The kitchen has been told.";
    }

    private static string Plural(int count) => count == 1 ? string.Empty : "s";

    /// <summary>
    /// Turns a refusal into sentences a guest can act on. <see cref="OrderMutationError.OperationIndex"/>
    /// indexes the operation list that was sent, and <see cref="StagedBatch.Descriptions"/> was built in
    /// exactly that order — which is why the batch is kept rather than rebuilt.
    /// </summary>
    private static IReadOnlyList<RejectedOperation> DescribeRejection(
        AppendOrderEventResult result,
        StagedBatch batch)
    {
        if (result.Outcome is AppendOrderEventOutcome.SittingNotFound or AppendOrderEventOutcome.OrderNotFound)
        {
            return [new RejectedOperation("This table", "It is no longer taking orders. Please speak to the counter.")];
        }

        List<RejectedOperation> problems = [];

        foreach (OrderMutationError error in result.Errors)
        {
            string what = error.OperationIndex >= 0 && error.OperationIndex < batch.Descriptions.Count
                ? batch.Descriptions[error.OperationIndex]
                : "This send";

            problems.Add(new RejectedOperation(what, error.Reason));
        }

        if (problems.Count == 0)
        {
            problems.Add(new RejectedOperation("This send", "It was refused. Please try again."));
        }

        return problems;
    }

    /// <summary>
    /// §9 says which notifications a table member re-queries on. All four that can change what is on
    /// this screen are handled with one re-read: the queries are small, scoped to one sitting, and a
    /// restaurant table is not a hot path. <c>MenuChanged</c> additionally re-reads the menu, which is
    /// how a staged item picks up its "currently unavailable" mark (§7).
    /// </summary>
    private void OnDomainNotification(DomainNotification notification)
    {
        bool concernsThisTable = notification switch
        {
            OrderLinesChanged changed => changed.SittingIdentifier == SittingId,
            LineFulfillmentChanged changed => changed.SittingIdentifier == SittingId,
            SittingMemberJoined joined => joined.SittingIdentifier == SittingId,
            SittingClosed closed => closed.SittingIdentifier == SittingId,
            MenuChanged => true,
            _ => false,
        };

        if (!concernsThisTable)
        {
            return;
        }

        bool menuChanged = notification is MenuChanged;

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (menuChanged)
                {
                    await LoadMenuAsync();
                }

                await LoadAsync();
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
                // Disposed between the broadcast and the query; nothing to update.
            }
            catch (ObjectDisposedException)
            {
                // Same, one layer down.
            }
        });
    }

    private MenuItemSummary? MenuItem(Guid menuItemIdentifier)
        => _menuById.TryGetValue(menuItemIdentifier, out MenuItemSummary? item) ? item : null;

    /// <summary>
    /// One other person's lines, out of the single sitting-wide read <see cref="LoadAsync"/> already
    /// did. §11.1 shows the rest of the table as names and their items, and this is the second half of
    /// that: <see cref="_bill"/> supplies the name and the total, this supplies the items underneath.
    /// An order with nothing on it — someone who joined and has not sent yet — is absent from the
    /// grouping rather than present and empty, so the empty list is the normal answer, not an error.
    /// </summary>
    private IReadOnlyList<OrderLineView> LinesFor(Guid guestOrderIdentifier)
        => _partyLinesByOrder.TryGetValue(guestOrderIdentifier, out IReadOnlyList<OrderLineView>? lines)
            ? lines
            : [];

    /// <summary>
    /// The item's <em>current</em> name, which is what <c>order_current_line</c> joins too (§8.3), so a
    /// rename reads the same here as on the counter's bill.
    /// </summary>
    private string MenuItemName(Guid menuItemIdentifier) => MenuItem(menuItemIdentifier)?.Name ?? "Item";

    /// <summary>
    /// A staged line's extended price at the price the menu holds <em>now</em> — never a price captured
    /// when it was staged. §6.5.4 prices the line inside the send transaction, so this is the only
    /// figure that can honestly be shown before it.
    /// </summary>
    private decimal StagedLineTotal(StagedOrderLine staged)
        => (MenuItem(staged.MenuItemIdentifier)?.PriceAmount ?? 0m) * staged.Quantity;

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    private static string DescribeRole(OrderActorRole role) => role switch
    {
        OrderActorRole.Guest => "a guest",
        OrderActorRole.Kitchen => "the kitchen",
        OrderActorRole.Counter => "the counter",
        OrderActorRole.Administrator => "an administrator",
        _ => "staff",
    };

    private static string ActorText(OrderActorRole? role, Guid? actor, Guid person)
        => actor is { } actorIdentifier && actorIdentifier == person
            ? "you"
            : DescribeRole(role ?? OrderActorRole.Counter);

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _subscription?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
