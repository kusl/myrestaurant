@page "/table"
@attribute [Authorize(Policy = AuthorizationPolicies.Table)]
@using MyRestaurant.DataAccess.Sittings
@inject ISittingDirectory Sittings
@inject RestaurantTime RestaurantClock

@* The table index (TECHNICAL_SPECIFICATION §5.1, §11.1). A person may hold memberships in several
   open sittings at once — §5.1 says so explicitly, and "the UI scopes to the sitting behind the
   current /table/{id} route" — so this page's whole job is to let someone pick which of their tables
   they mean, and to say plainly how to get a new one (scan the code on the table).

   Interactive server, unlike /table/{id}: this page sets no cookie and issues no redirect, so it can
   stay on the circuit, and it remains the standing proof that the whole chain — cookie → claims →
   area policy → AuthorizeRouteView → circuit — is live. Anonymous visitors are sent to /sign-in with
   this page as the return URL.

   It is deliberately an index and nothing more. Ordering lives one route deeper, on the sitting, and
   duplicating any of it here would mean a second surface to keep in step with §6. *@

<PageTitle>Your tables</PageTitle>

@* §11.10's pair, and this surface is the reason §11.10 exists as a rule rather than as a list. Four
   slices' worth of comments in this tree said "the five live surfaces" and meant a list somebody had
   written down; the rule is App.razor's RenderModeForPage, and by that rule this page has been a live
   surface since M3 while publishing nothing at all — no id, no attribute, nothing an operator or a
   §16.3 reader could ask. See IsLiveAttributeValue and IsLoadedAttributeValue. *@
<section class="panel" id="table-area-surface"
         data-live="@IsLiveAttributeValue"
         data-loaded="@IsLoadedAttributeValue">
    <p class="eyebrow">Your tables</p>
    <h1>Where you are seated</h1>

    @if (!_loaded)
    {
        <p class="lede">Looking up your tables…</p>
    }
    else if (_sittings.Count == 0)
    {
        <p class="lede">
            You are not seated at a table right now. Scan the code on a table's display to join it —
            or ask any member of staff to show you one from the counter. Past meals are on
            <a href="/table/history">your order history</a>.
        </p>
    }
    else
    {
        <p class="lede">
            You are part of @_sittings.Count open
            @(_sittings.Count == 1 ? "sitting" : "sittings"). Pick the table you are at to see the menu,
            build an order, and watch it come out of the kitchen.
        </p>

        <ul class="sitting-list">
            @foreach (TableSittingSummary sitting in _sittings)
            {
                <li>
                    <a class="sitting-link" href="@($"/table/{sitting.TableIdentifier}")">
                        <span class="sitting-label">@sitting.TableLabel</span>
                        <span class="sitting-meta">
                            open since @RestaurantClock.Time(sitting.OpenedAt) ·
                            @sitting.MemberCount @(sitting.MemberCount == 1 ? "person" : "people")
                        </span>
                    </a>
                </li>
            }
        </ul>
    }

    <p class="sitting-footer-links">
        <a href="/table/history">Your order history</a>
        <span class="sitting-footer-separator">·</span>
        <a href="/">Back to the home page</a>
    </p>
</section>

<style>
    .sitting-list {
        list-style: none;
        margin: 1rem 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
    }

    .sitting-link {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0.7rem 0.85rem;
        border: 1px solid var(--hairline);
        border-radius: 0.5rem;
        background: var(--surface-raised);
        text-decoration: none;
        color: inherit;
    }

    .sitting-link:hover {
        border-color: var(--accent);
    }

    .sitting-label {
        font-weight: 600;
    }

    .sitting-meta {
        font-size: 0.85rem;
        color: var(--ink-soft);
    }

    .sitting-footer-separator {
        margin: 0 0.35rem;
        color: var(--ink-soft);
    }
</style>

@code {
    private IReadOnlyList<TableSittingSummary> _sittings = [];
    private bool _loaded;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// Whether a circuit produced this markup — <c>"true"</c> only in interactive-server rendering,
    /// <c>"false"</c> during the prerender pass. §11.10's first bit.
    ///
    /// <para>Lower stakes than the other five and published anyway, which is the point of making it a
    /// rule. This page subscribes to nothing and runs no timer, so a prerendered copy of it is not
    /// dangerous in the way a prerendered till or kitchen board is — it is a list of links, correct as
    /// of the request, and following one of them starts a fresh page. What it is is the standing proof
    /// named in the header comment above: cookie → claims → area policy → AuthorizeRouteView → circuit.
    /// A dead circuit here means every interactive surface behind it is dead too, and until M6 Slice 23
    /// this was the one screen that could not say so.</para>
    /// </summary>
    private string IsLiveAttributeValue => RendererInfo.IsInteractive ? "true" : "false";

    /// <summary>
    /// Whether the sitting list has answered, published alongside <c>data-live</c> — §11.10's second
    /// bit. The circuit's first render is live with <c>_loaded</c> still false, and the page renders
    /// "Looking up your tables…" in that state: no list, and — the part that matters — the same absence
    /// of a list that means "you are not seated at a table right now".
    /// </summary>
    private string IsLoadedAttributeValue => _loaded ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        // The cascading authentication state is the circuit-safe way to read the principal: there is
        // no HttpContext once the component is interactive, and this works identically during the
        // static prerender pass (AddCascadingAuthenticationState is wired in AddRestaurantIdentity).
        if (AuthenticationStateTask is not null)
        {
            AuthenticationState state = await AuthenticationStateTask;
            if (PersonPrincipal.IdentifierFor(state.User) is { } person)
            {
                _sittings = await Sittings.ListOpenSittingsForPersonAsync(person);
            }
        }

        _loaded = true;
    }
}
