@page "/kitchen"
@attribute [Authorize(Policy = AuthorizationPolicies.Kitchen)]
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.DataAccess.Orders
@using MyRestaurant.Domain.LiveUpdates
@using MyRestaurant.Domain.Orders
@using MyRestaurant.Domain.Time
@using MyRestaurant.WebApplication.Menu
@using MyRestaurant.WebApplication.Orders
@implements IDisposable
@inject IOrderReadModel OrderReads
@inject IKitchenBoardReads KitchenReads
@inject IMenuDirectory MenuDirectory
@inject IMenuWorkflow MenuWorkflow
@inject IOrderWorkflow Workflow
@inject IDomainEventBroadcaster Broadcaster
@inject IClock Clock
@inject RestaurantOptions Options
@inject RestaurantTime RestaurantClock
@inject IJSRuntime JavaScript

<PageTitle>Kitchen</PageTitle>

<section class="panel kitchen-board" id="kitchen-board-surface"
         data-live="@IsLiveAttributeValue"
         data-loaded="@IsLoadedAttributeValue"
         data-unseen-alerts="@_alerts.UnseenCount"
         data-unseen-reminders="@_alerts.UnseenReminderCount">
    <div class="kitchen-header">
        <div>
            <p class="eyebrow">@Options.RestaurantName</p>
            <h1>Kitchen</h1>
        </div>
        <div class="kitchen-header-status">
            @if (_alerts.HasUnseen)
            {
                <button type="button" class="kitchen-alert-badge" @onclick="AcknowledgeAlerts">
                    @_alerts.UnseenCount new @(_alerts.UnseenCount == 1 ? "alert" : "alerts")@(_alerts.UnseenReminderCount > 0 ? $" ({_alerts.UnseenReminderCount} overdue)" : string.Empty)
                    <span class="kitchen-alert-dismiss">tap to clear</span>
                </button>
            }

            @if (!_alerts.IsArmed)
            {
                <button type="button" class="button-primary kitchen-arm" @onclick="ArmSoundAsync">
                    Enable sound
                </button>
            }
            else if (_alerts.PlaybackFailed)
            {
                <button type="button" class="button-secondary kitchen-arm" @onclick="ArmSoundAsync">
                    Sound failed — try again
                </button>
            }
            else
            {
                <span class="chip chip-ok">Sound on</span>
            }
        </div>
    </div>

    @if (_alerts.ShowsVisualFallback)
    {
        <p class="kitchen-sound-notice" role="note">
            @if (_alerts.PlaybackFailed)
            {
                <text>
                    This browser would not play the alert. The badge above still counts everything that
                    arrives — keep the board visible, and try <strong>Enable sound</strong> again.
                </text>
            }
            else
            {
                <text>
                    Alerts are silent until you tap <strong>Enable sound</strong> — browsers block sound
                    until someone asks for it. Until then the badge above is the only warning.
                </text>
            }
        </p>
    }

    @if (_actionNotice is { } actionNotice)
    {
        <p class="status-success" role="status">@actionNotice</p>
    }

    @if (_actionProblem is { } actionProblem)
    {
        <p class="status-error" role="alert">@actionProblem</p>
    }

    @if (!_loaded)
    {
        <p class="lede">Loading the board…</p>
    }
    else
    {
        <p class="lede">
            @if (_queue.Count == 0)
            {
                <text>Nothing is waiting. New sends appear here the moment a guest presses Send.</text>
            }
            else
            {
                <text>
                    @KitchenQueue.TotalLineCount(_queue) @(KitchenQueue.TotalLineCount(_queue) == 1 ? "line" : "lines")
                    outstanding across @_queue.Count @(_queue.Count == 1 ? "table" : "tables"), oldest first.
                </text>
            }
        </p>

        @foreach (KitchenQueueTable table in _queue)
        {
            <article class="kitchen-table" @key="table.TableIdentifier">
                <header class="kitchen-table-header">
                    <h2>@table.TableLabel</h2>
                    <span class="kitchen-waiting">waiting @Waiting(table.OldestAddedAt)</span>
                </header>

                @foreach (KitchenQueueTicket ticket in table.Tickets)
                {
                    <section class="kitchen-ticket" @key="ticket.GuestOrderIdentifier">
                        <header class="kitchen-ticket-header">
                            <div>
                                <h3>@ticket.PersonName</h3>
                                <p class="kitchen-ticket-sends">
                                    sent @string.Join(", ", ticket.SendTimes.Select(instant => RestaurantClock.Time(instant)))
                                </p>
                            </div>
                            <button type="button" class="button-secondary kitchen-fulfill-all"
                                    disabled="@_busy"
                                    @onclick="() => FulfillTicketAsync(ticket)">
                                Fulfill all @ticket.LineCount
                            </button>
                        </header>

                        <ul class="kitchen-lines">
                            @foreach (KitchenQueueLine line in ticket.Lines)
                            {
                                <li class="kitchen-line @(line.HasNote ? "has-note" : string.Empty)"
                                    @key="line.OrderLineIdentifier">

                                    <button type="button" class="kitchen-line-button"
                                            disabled="@_busy"
                                            @onclick="() => FulfillLineAsync(ticket, line)">
                                        <span class="kitchen-line-quantity">@line.Quantity×</span>
                                        <span class="kitchen-line-name">@line.MenuItemName</span>
                                        <span class="kitchen-line-action">Fulfill</span>
                                    </button>

                                    @if (line.CustomizationNote is { } note)
                                    {
                                        <p class="kitchen-line-note">@note</p>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
            </article>
        }

        @if (_recentlyFulfilled.Count > 0)
        {
            <section class="kitchen-recent">
                <h2 class="kitchen-recent-heading">Just fulfilled</h2>
                <p class="muted">
                    Anything marked done in the last @((int)RecentFulfillmentWindow.TotalMinutes) minutes. Undo
                    puts it back on the board and tells the guest it is with the kitchen again.
                </p>

                <ul class="kitchen-recent-list">
                    @foreach (KitchenFulfilledLineView line in _recentlyFulfilled)
                    {
                        <li class="kitchen-recent-line" @key="line.OrderLineIdentifier">
                            <div class="kitchen-recent-main">
                                <span class="kitchen-recent-name">
                                    @line.Quantity× @line.MenuItemName
                                </span>
                                <span class="kitchen-recent-where">
                                    @line.TableLabel · @line.PersonName · @RestaurantClock.Time(line.FulfilledAt)
                                </span>
                            </div>
                            <button type="button" class="link-button"
                                    disabled="@_busy"
                                    @onclick="() => UndoFulfillmentAsync(line)">
                                Undo
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="kitchen-eighty-six">
            <h2 class="kitchen-recent-heading">Availability (“86”)</h2>
            <p class="muted">
                Turning something off leaves it on the guest's menu marked <em>currently unavailable</em>
                and stops it being ordered. Orders already sent are untouched. Headings guests cannot see
                are listed too, because switching a heading off leaves everything under it exactly as the
                kitchen set it.
            </p>

            @{
                IReadOnlyList<MenuHeadingGroup> headings = MenuGrouping.EveryHeading(_menu);
            }

            @if (headings.Count == 0)
            {
                <p class="muted">There is nothing on the menu yet.</p>
            }
            else
            {
                @foreach (MenuHeadingGroup heading in headings)
                {
                    <div class="kitchen-menu-group" @key="heading.MenuSectionIdentifier">
                        <h3 class="kitchen-menu-group-name" id="@HeadingId(heading)">
                            @heading.MenuSectionName
                            @if (!heading.MenuSectionIsActive)
                            {
                                <span class="chip chip-warn">Hidden from guests</span>
                            }
                        </h3>

                        <ul class="kitchen-menu" aria-labelledby="@HeadingId(heading)">
                            @foreach (MenuItemSummary item in heading.Items)
                            {
                                <li class="kitchen-menu-item @(item.IsActive ? string.Empty : "is-off")"
                                    @key="item.MenuItemIdentifier">
                                    <span class="kitchen-menu-name">@item.Name</span>
                                    <span class="kitchen-menu-state">
                                        @(item.IsActive ? "On" : "86'd")
                                    </span>
                                    <button type="button"
                                            class="@(item.IsActive ? "button-secondary" : "button-primary")"
                                            disabled="@_busy"
                                            @onclick="() => ToggleMenuItemAsync(item)">
                                        @(item.IsActive ? "Turn off" : "Bring back")
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </section>
    }
</section>

<style>

