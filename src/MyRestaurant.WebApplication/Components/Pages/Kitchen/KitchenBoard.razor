</style>

@code {
    private static readonly TimeSpan RecentFulfillmentWindow = TimeSpan.FromMinutes(15);

    private readonly KitchenAlertState _alerts = new();

    private readonly CancellationTokenSource _lifetime = new();
    private CancellationToken _stopping;
    private IDisposable? _subscription;
    private bool _disposed;

    private Guid? _person;
    private OrderActorRole _actorRole = OrderActorRole.Kitchen;
    private bool _loaded;
    private bool _busy;

    private IReadOnlyList<KitchenQueueTable> _queue = [];
    private IReadOnlyList<KitchenFulfilledLineView> _recentlyFulfilled = [];
    private IReadOnlyList<MenuItemSummary> _menu = [];

    private string? _actionNotice;
    private string? _actionProblem;
    private int _announcedAlertToken;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string IsLiveAttributeValue => RendererInfo.IsInteractive ? "true" : "false";

    private string IsLoadedAttributeValue => _loaded ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        _stopping = _lifetime.Token;

        if (AuthenticationStateTask is not null)
        {
            AuthenticationState state = await AuthenticationStateTask;
            _person = PersonPrincipal.IdentifierFor(state.User);

            _actorRole = state.User.IsInRole(RestaurantRoles.Kitchen)
                ? OrderActorRole.Kitchen
                : OrderActorRole.Administrator;
        }

        await LoadAsync();
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _subscription = Broadcaster.Subscribe(OnDomainNotification);
        }

        if (_alerts.AlertToken == _announcedAlertToken)
        {
            return;
        }

        _announcedAlertToken = _alerts.AlertToken;

        if (!_alerts.IsArmed)
        {
            return;
        }

        bool played;
        try
        {
            played = await JavaScript.InvokeAsync<bool>(
                "myRestaurantKitchen.alert", _stopping, _alerts.LastAlertWasReminder);
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (JSException)
        {
            played = false;
        }

        bool changed = played ? _alerts.ReportPlaybackSucceeded() : _alerts.ReportPlaybackFailed();
        if (changed)
        {
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        IReadOnlyList<KitchenPendingLineView> pending = await OrderReads
            .ListKitchenPendingLinesAsync(_stopping);

        _queue = KitchenQueue.Build(pending);

        _recentlyFulfilled = await KitchenReads
            .ListRecentlyFulfilledLinesAsync(Clock.UtcNow - RecentFulfillmentWindow, _stopping);

        _menu = await MenuDirectory.ListAsync(_stopping);
    }

    private Task FulfillLineAsync(KitchenQueueTicket ticket, KitchenQueueLine line)
        => AppendAsync(
            ticket.GuestOrderIdentifier,
            OrderEventType.Fulfillment,
            [new LineFulfilledOperation(line.OrderLineIdentifier)],
            $"{line.Quantity} × {line.MenuItemName} is away.");

    private Task FulfillTicketAsync(KitchenQueueTicket ticket)
        => AppendAsync(
            ticket.GuestOrderIdentifier,
            OrderEventType.Fulfillment,
            ticket.Lines.Select(line => (OrderOperation)new LineFulfilledOperation(line.OrderLineIdentifier)).ToArray(),
            $"{ticket.PersonName}'s order is away — {ticket.LineCount} {(ticket.LineCount == 1 ? "line" : "lines")}.");

    private Task UndoFulfillmentAsync(KitchenFulfilledLineView line)
        => AppendAsync(
            line.GuestOrderIdentifier,
            OrderEventType.FulfillmentReversal,
            [new LineFulfillmentRevertedOperation(line.OrderLineIdentifier)],
            $"{line.Quantity} × {line.MenuItemName} is back on the board.");

    private async Task AppendAsync(
        Guid guestOrderIdentifier,
        OrderEventType eventType,
        IReadOnlyList<OrderOperation> operations,
        string successMessage)
    {
        if (_person is not { } person || _busy || operations.Count == 0)
        {
            return;
        }

        _busy = true;
        _actionNotice = null;
        _actionProblem = null;

        try
        {
            AppendOrderEventResult result = await Workflow.AppendStaffEventAsync(
                guestOrderIdentifier,
                new ProposedOrderEvent(eventType, person, _actorRole, operations),
                _stopping);

            if (result.IsAppended)
            {
                _actionNotice = successMessage;

                _alerts.Acknowledge();
            }
            else
            {
                _actionProblem = DescribeRefusal(result);
            }

            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private static string DescribeRefusal(AppendOrderEventResult result)
    {
        if (result.Outcome is AppendOrderEventOutcome.OrderNotFound or AppendOrderEventOutcome.SittingNotFound)
        {
            return "That table has been settled, so nothing more can be recorded against it.";
        }

        string reason = result.Errors.Count > 0
            ? result.Errors[0].Reason
            : "It was refused.";

        return $"Nothing was changed — {reason} The board has been refreshed.";
    }

    private static string HeadingId(MenuHeadingGroup heading)
        => $"kitchen-menu-section-{heading.MenuSectionIdentifier}";

    private async Task ToggleMenuItemAsync(MenuItemSummary item)
    {
        if (_person is not { } person || _busy)
        {
            return;
        }

        _busy = true;
        _actionNotice = null;
        _actionProblem = null;

        try
        {
            SetMenuItemAvailabilityResult result = await MenuWorkflow
                .SetMenuItemActiveAsync(item.MenuItemIdentifier, !item.IsActive, person, _stopping);

            _actionNotice = result.Outcome switch
            {
                SetMenuItemAvailabilityOutcome.Changed when result.IsActive => $"{result.Name} is back on.",
                SetMenuItemAvailabilityOutcome.Changed => $"{result.Name} is 86'd.",
                SetMenuItemAvailabilityOutcome.AlreadyInThatState => $"{result.Name} was already set that way.",
                _ => null,
            };

            if (!result.ItemExists)
            {
                _actionProblem = "That item is no longer on the menu.";
            }

            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ArmSoundAsync()
    {
        bool armed;
        try
        {
            armed = await JavaScript.InvokeAsync<bool>("myRestaurantKitchen.arm", _stopping);
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (JSException)
        {
            armed = false;
        }

        _alerts.Arm(armed);

        _announcedAlertToken = _alerts.AlertToken;
    }

    private void AcknowledgeAlerts()
    {
        _alerts.Acknowledge();
    }

    private void OnDomainNotification(DomainNotification notification)
    {
        bool concernsTheBoard = notification
            is OrderLinesChanged
            or LineFulfillmentChanged
            or SittingClosed
            or MenuChanged
            or KitchenAlert;

        if (!concernsTheBoard)
        {
            return;
        }

        KitchenAlertKind? alertKind = notification is KitchenAlert alert ? alert.Kind : null;

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            if (alertKind is { } kind)
            {
                _alerts.Record(kind);
            }

            try
            {
                await LoadAsync();
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        });
    }

    private string Waiting(DateTimeOffset since)
    {
        TimeSpan elapsed = Clock.UtcNow - since;

        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "under a minute";
        }

        int minutes = (int)elapsed.TotalMinutes;
        if (minutes < 60)
        {
            return $"{minutes}m";
        }

        int hours = minutes / 60;
        return $"{hours}h {minutes % 60:D2}m";
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _subscription?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
