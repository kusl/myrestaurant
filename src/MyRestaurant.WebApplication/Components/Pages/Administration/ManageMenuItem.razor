@page "/administration/menu/{MenuItemId:guid}"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.Domain.Identifiers
@using MyRestaurant.WebApplication.Menu
@using MyRestaurant.WebApplication.Orders
@inject IMenuDirectory MenuItems
@inject IMenuSectionDirectory MenuSections
@inject IMenuEventLog MenuEvents
@inject IMenuItemImageDirectory MenuItemPictures
@inject IMenuWorkflow MenuChanges
@inject IIdentifierFactory IdentifierFactory
@inject RestaurantOptions Options
@inject NavigationManager Navigation
@inject RestaurantTime RestaurantClock

@* Manage one menu item (TECHNICAL_SPECIFICATION §7, §11.4). Administrator only (endpoint
   authorization). Static SSR: rename, reprice, and the availability toggle are full-page form posts.
   Successful changes redirect back here (post/redirect/get) carrying a one-word outcome so a refresh does
   not re-post; the shape ManageTable established.

   Rename, reprice, describe, refile and reposition are separate forms rather than one "save", because §7's
   event vocabulary has `name_changed`, `price_changed`, `description_changed`, `section_changed` and
   `reordered` as separate types with mutually exclusive payload columns — a combined save would write
   an event each anyway and would then have to decide what to do when most of them changed nothing. No
   count of the forms is stated here, on F-77's ruling: this note used to say five and there were six.

   THE PICTURE FORM IS THE ONE EXCEPTION TO THIS PAGE'S BINDING, AND IT IS THE STAGE 4b DECISION.
   `[SupplyParameterFromForm]` does not bind a file and `InputFile` needs an interactive render mode, so
   the plan named two ways out: a multipart form posting to a minimal API endpoint beside
   `AccountEndpoints`, or making this page interactive. Neither was taken. A plain
   `enctype="multipart/form-data"` form posts to THIS page under an ordinary `@@formname`, and the handler
   reads the part back out of `HttpContext.Request.Form.Files` — which costs nothing, because Blazor's
   static form handling has already read the body in order to find `_handler` and dispatch. The page stays
   static SSR, antiforgery stays the framework's job, post/redirect/get is unchanged, and no second
   endpoint acquires an authorization rule that has to agree with this page's. What is given up is model
   binding for exactly one field, and that field is the one the model binder refuses anyway. *@
   The history below is complete and uncapped, oldest first. §11.4: administration renders "the complete
   stored record everywhere — full event streams … never projected or truncated for the administrator". A
   price argument is settled by reading forward from `created`, so that is the direction it renders.

<PageTitle>@(_item is null ? "Manage menu item" : $"Manage {_item.Name}")</PageTitle>

@if (_item is null)
{
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Menu item not found</h1>
        <p class="lede">No menu item exists with that identifier. It may have never existed, or the link is stale.</p>
        <p><a href="/administration/menu">Back to the menu</a></p>
    </section>
}
else
{
    <section class="panel account-panel">
        <div class="page-head">
            <div>
                <p class="eyebrow">Administration — menu</p>
                <h1>@_item.Name</h1>
            </div>
        </div>

        @if (_flashMessage is not null)
        {
            <p class="status-success" role="status">@_flashMessage</p>
        }
        @if (_errorMessage is not null)
        {
            <p class="status-error" role="alert">@_errorMessage</p>
        }

        <div class="manage-facts">
            <div>
                <span class="manage-label">Availability</span>
                @if (_item.IsActive)
                {
                    <span class="chip chip-ok">Available</span>
                }
                else
                {
                    <span class="chip chip-warn">Currently unavailable</span>
                }
            </div>
            <div>
                <span class="manage-label">Price</span>
                <span class="record-numeric">@Money(_item.PriceAmount)</span>
            </div>
            <div>
                <span class="manage-label">Section</span>
                @* A link to the heading, and — since `MoveMenuItemToSectionAsync` acquired a caller — the
                   fact the form further down changes. It stays a link rather than becoming part of that
                   form: this grid is what the item IS, and every editor on this page sits below the rule
                   under it. *@
                <a class="record-link" href="@($"/administration/menu/sections/{_item.MenuSectionIdentifier}")">@_item.MenuSectionName</a>
                @if (!_item.MenuSectionIsActive)
                {
                    @* §7: an inactive SECTION is hidden from the guest entirely, where an inactive ITEM
                       stays visible and marked. This item may say "Available" one box to the left and
                       still be unreachable on a phone, and that is the one fact this page could not
                       otherwise explain. *@
                    <span class="chip chip-warn">Hidden from guests</span>
                }
            </div>
            <div>
                <span class="manage-label">Position</span>
                <span class="record-numeric">@_item.DisplayOrder</span>
            </div>
            <div>
                <span class="manage-label">Created</span>
                <span>@RestaurantClock.DateAndTime(_item.CreatedAt)</span>
            </div>
        </div>

        @if (_item.Description.Length > 0)
        {
            <p class="lede">@_item.Description</p>
        }
        else
        {
            <p class="lede muted">No description. Guests see the name and the price only.</p>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">Name</h2>
        <p class="lede">
            Renaming shows through everywhere immediately, including on lines already sent and on closed
            bills — the name is read at display time, not captured (§8.3). Rename to correct a spelling;
            create a second item if it is a different dish.
        </p>
        <EditForm Model="RenameInput" method="post" OnValidSubmit="RenameAsync" FormName="menu-item-rename" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="rename-name">New name</label>
            <InputText id="rename-name" @bind-Value="RenameInput.Name" autocomplete="off" />
            <button type="submit" class="button-primary">Rename</button>
            <ValidationMessage For="@(() => RenameInput.Name)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Price</h2>
        <p class="lede">
            A new price applies to lines added <strong>from now on</strong>. Anything already on an order
            keeps the price it was added at, including on open tables — that is the capture rule (§6.5.4),
            and it is why a guest who ordered before the change is not surprised at the till.
        </p>
        <EditForm Model="RepriceInput" method="post" OnValidSubmit="RepriceAsync" FormName="menu-item-reprice" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="reprice-price">New price</label>
            <span class="manage-currency">@Options.CurrencyCode</span>
            <InputNumber id="reprice-price" @bind-Value="RepriceInput.PriceAmount" step="0.01" min="0" inputmode="decimal" />
            <button type="submit" class="button-primary">Reprice</button>
            <ValidationMessage For="@(() => RepriceInput.PriceAmount)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Description</h2>
        <p class="lede">
            One or two sentences a guest reads before ordering. Optional — clearing the box is an ordinary
            change with an ordinary entry in the history below, not a deletion. Saving the same text again
            records nothing.
        </p>
        @* A `.form-field` block rather than `.manage-inline-form`, deliberately: that class styles
           `input` and `select` and has never styled a `textarea`, so a three-line box inside it would be
           an unstyled control on the one page that has one. `.form-field textarea` is app.css's own
           declaration and this page declares nothing, which is what F-66 was about. *@
        <EditForm Model="DescribeInput" method="post" OnValidSubmit="DescribeAsync" FormName="menu-item-describe">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label class="visually-hidden" for="describe-description">Description</label>
                <InputTextArea id="describe-description" @bind-Value="DescribeInput.Description" rows="3" autocomplete="off" />
                <ValidationMessage For="@(() => DescribeInput.Description)" />
            </div>
            <div class="form-actions">
                <button type="submit" class="button-primary">Save description</button>
            </div>
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Picture</h2>
        <p class="lede">
            One photograph of the dish. It is stored in this restaurant's own database and served by this
            application, so nothing about the menu leaves the building. JPEG, PNG or WebP; anything else is
            refused with a reason. <strong>The size limit belongs to the database rather than to this
            page</strong>, and a photograph straight off a phone camera is usually over it — the answer
            will say so and nothing will have changed. Attaching a second picture replaces the first: the
            old one is deleted and its address stops working, which is exactly why a browser is told it may
            keep a picture for a year.
        </p>

        @if (_picture is not null)
        {
            <figure class="manage-picture">
                @* alt="" deliberately, and it stays "" now that the column exists, which is the part worth
                   reading twice. This picture sits under the item's own name — this page's <h1> — so
                   alternative text HERE would make a screen reader read the dish twice and add nothing the
                   page has not said. The caption the form below writes is for the GUEST'S menu, where the
                   picture sits on a card among sixty others; the two surfaces want different things from
                   the same column, and this one wants nothing. The caption is rendered below as visible
                   text instead, because an operator who cannot see what they wrote cannot correct it. *@
                <img class="manage-picture-image"
                     src="@MenuImageRoutes.ForImage(_picture.MenuItemImageIdentifier)"
                     alt="" />
                <figcaption class="manage-picture-facts">
                    @_picture.ContentType · @_picture.ByteLength bytes · attached
                    @RestaurantClock.DateAndTime(_picture.UploadedAt)
                </figcaption>
            </figure>
        }
        else
        {
            <p class="lede muted">No picture. Guests see the name, the price and the description only.</p>
        }

        @* `.manage-inline-form` rather than a `.form-field` block, so the submit control is measured by
           §16.3 scenario 16: the 375px barrier reaches `.manage-inline-form button` and does not reach
           `.form-actions button`, and F-93's rule is that a surface acquiring a control acquires the
           selector in the same slice. Here the selector was already right and the class is what puts the
           control under it. *@
        <form method="post" enctype="multipart/form-data" @formname="menu-item-image-attach" @onsubmit="AttachPictureAsync" class="manage-inline-form">
            <AntiforgeryToken />
            <label class="visually-hidden" for="picture-file">Picture file</label>
            @* Both attributes are read from one place rather than written here. The name is what the
               handler looks the part up BY, and a rename applied to one side produces no compiler error
               and no exception — just an upload that reports itself empty forever. The accept list is the
               media-type vocabulary's third declaration (F-80) and is computed from the domain's own
               census, never spelled out. *@
            <input type="file" id="picture-file" name="@MenuItemImageUpload.FileFieldName" accept="@MenuItemImageUpload.AcceptAttribute" />
            <button type="submit" class="button-primary">@(_picture is null ? "Attach picture" : "Replace picture")</button>
        </form>

        @if (_picture is not null)
        {
            <form method="post" @formname="menu-item-image-remove" @onsubmit="RemovePictureAsync" class="manage-inline-form">
                <AntiforgeryToken />
                <button type="submit" class="button-secondary">Remove picture</button>
            </form>

            <p class="lede">
                <strong>What a screen reader says instead of the picture.</strong> Leave it empty unless the
                photograph shows something the dish's name does not — the guest's menu already reads out the
                name and the price beside it, so a caption repeating the name would have somebody hear the
                dish twice. <em>“Served on a bed of wilted greens with a lemon wedge”</em> is the kind of
                thing worth writing. Changing it does <strong>not</strong> re-upload the photograph and does
                not change its address, and replacing the photograph later keeps whatever is written here.
            </p>

            @* Its own form rather than a field on the upload above, and the reason is the one the write
               service's own summary gives: the upload form requires a file, so a caption settable only
               there would make fixing a typo cost a re-upload — a new image identifier, every cached copy
               invalidated, and a "replaced" event recording a replacement that replaced nothing.

               `.manage-inline-form` for F-93's reason, the same as the two forms above: the 375px barrier
               in §16.3 scenario 16 reaches `.manage-inline-form button` and does not reach
               `.form-actions button`, so a control that wants measuring wants this class. That class has
               styled `input` and `select` since Slice 34 and has never styled a `textarea`, which is why
               this is a one-line text input — a caption is a sentence, not a paragraph. *@
            <EditForm method="post" Model="AltTextInput" OnValidSubmit="SetPictureAltTextAsync"
                      FormName="menu-item-image-alt-text" class="manage-inline-form">
                <DataAnnotationsValidator />
                <label class="visually-hidden" for="picture-alt-text">What a screen reader says</label>
                <InputText id="picture-alt-text" @bind-Value="AltTextInput.AltText"
                           maxlength="500" autocomplete="off"
                           placeholder="Leave empty unless it says more than the name" />
                <button type="submit" class="button-primary">Save caption</button>
            </EditForm>

            <ValidationMessage For="@(() => AltTextInput.AltText)" />
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">Section</h2>
        <p class="lede">
            The heading this item is filed under. Moving it puts it at the <strong>end</strong> of the
            heading you choose, on the same rule a newly created item follows — a position belongs to the
            heading it is a position within, so carrying the old number across would drop this item into
            the middle of somebody else's ordering. Set the position below afterwards if the end is not
            where it belongs. Nothing else about the item changes: an item marked unavailable stays
            unavailable under its new heading.
        </p>
        @if (_sections.Count > 0)
        {
            @* Guarded rather than dereferenced, though the list cannot be empty here: the item exists, so
               the heading it is under exists, so at least one section does. The guard is against the
               intermediate render instead — `StateHasChanged` fires the moment `OnInitializedAsync`
               suspends, and this field is filled after `_item` is. An empty list renders no form rather
               than a picker over nothing, which is the same call CreateMenuItem makes for a case that
               genuinely happens. *@
            <EditForm Model="MoveInput" method="post" OnValidSubmit="MoveAsync" FormName="menu-item-move-section" class="manage-inline-form">
                <DataAnnotationsValidator />
                <label class="visually-hidden" for="move-section">New section</label>
                @* Inactive headings are offered and marked, on §7's asymmetry: an inactive section is
                   hidden from the GUEST, not from §11.4's administrator, whose job here may be moving
                   next week's breakfast dishes under a heading that is not switched on yet. The suffix is
                   text inside the option because an <option> renders text and nothing else — the same
                   limitation, and the same acceptable trade, as the create form's picker.

                   The loop variable is not called `section`: `@@section` is Razor's MVC section directive
                   and the parser never reaches C# with it (F-81). *@
                <InputSelect id="move-section" @bind-Value="MoveInput.MenuSectionIdentifier">
                    @foreach (MenuSectionSummary heading in _sections)
                    {
                        <option value="@heading.MenuSectionIdentifier">
                            @(heading.IsActive
                                ? heading.Name
                                : $"{heading.Name} (hidden from guests)")
                        </option>
                    }
                </InputSelect>
                <button type="submit" class="button-primary">File here</button>
            </EditForm>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">Position</h2>
        <p class="lede">
            Where this item sits <strong>within its section</strong>. Lower comes first; items sharing a
            position are ordered by name, which is why a heading reads alphabetically until somebody
            decides otherwise. Positions do not have to be unique or contiguous, and they are counted per
            heading — so two items in two sections may both sit at 0.
        </p>
        <EditForm Model="ReorderInput" method="post" OnValidSubmit="ReorderAsync" FormName="menu-item-reorder" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="reorder-position">New position</label>
            <InputNumber id="reorder-position" @bind-Value="ReorderInput.DisplayOrder" step="1" min="0" inputmode="numeric" />
            <button type="submit" class="button-primary">Move</button>
            <ValidationMessage For="@(() => ReorderInput.DisplayOrder)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Availability</h2>
        @if (_item.IsActive)
        {
            <p class="lede">
                Marking this unavailable is the "86". It stays on the guest's menu, labelled unavailable,
                and cannot be added to a send; nothing is hidden and nothing is deleted. The kitchen and
                the counter can do this too, from their own screens.
            </p>
            <form method="post" @formname="menu-item-set-active" @onsubmit="ToggleAvailabilityAsync">
                <AntiforgeryToken />
                <div class="form-actions">
                    <button type="submit" class="button-secondary">Mark unavailable</button>
                </div>
            </form>
        }
        else
        {
            <p class="lede">
                This item is on the menu marked unavailable and cannot be ordered. Bring it back when it
                is on again.
            </p>
            <form method="post" @formname="menu-item-set-active" @onsubmit="ToggleAvailabilityAsync">
                <AntiforgeryToken />
                <div class="form-actions">
                    <button type="submit" class="button-primary">Mark available</button>
                </div>
            </form>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">History</h2>
        @if (_history is null || _history.Count == 0)
        {
            <p class="lede">No recorded changes. That is only possible for an item created before this log existed.</p>
        }
        else
        {
            <p class="lede">
                Everything that has ever happened to this item, oldest first — @_history.Count
                @(_history.Count == 1 ? "entry" : "entries"), complete and untruncated.
            </p>
            @* A shared record list rather than the page's own table inside `overflow-x: auto`. The
               wrapper contained the sideways scroll, so the document never scrolled and §16.3
               scenario 16 would have passed it — but three unlabelled cells in a card is a column of
               bare values, which is the half of F-59 that is about the reader rather than the
               affordance. *@
            <div class="record-list">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Change</th>
                            <th scope="col">By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MenuItemEventEntry entry in _history)
                        {
                            <tr>
                                <td data-label="When">@RestaurantClock.DateAndTime(entry.OccurredAt)</td>
                                <td class="record-primary" data-label="Change">@Describe(entry)</td>
                                <td data-label="By">@entry.ActorName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="manage-back"><a href="/administration/menu">Back to the menu</a></p>
    </section>
}

@* This page declares nothing. Its facts grid, its chips, its headings, its rules, its inline forms, its
   currency unit and — as of M6 Slice 34 — its history list are all app.css's §11.12 vocabulary. This was
   one of four pages carrying an inline copy of that vocabulary, and the copies had drifted (F-66); the
   history table was also the page's own eighty-line table rules under a different name.

   The section picker needed no new rule either: `.manage-inline-form` has styled `select` since Slice 34,
   which is why the comment beside the description form says that class has never styled a `textarea` —
   the two statements are the same sentence read from opposite ends. No count of the forms on this page is
   written here, on F-77's ruling; the previous version of this note said TWO and there were four.

   THE PICTURE PANEL IS THE ONE THING ON THIS PAGE THAT NEEDED A NEW RULE, and it needed one for a reason
   that has nothing to do with taste. An `<img>` with no width constraint renders at the intrinsic size of
   whatever somebody uploaded, so a 3000px photograph would make this document wider than a 375px viewport
   and §16.3 scenario 16 would fail — on a page whose own controls are all correct. `.manage-picture*` is
   three rules in app.css under the `.manage-` prefix the shared-vocabulary gate already protects, rather
   than a new prefix or a component-local block. *@

@code {
    private MenuItemSummary? _item;
    private IReadOnlyList<MenuSectionSummary> _sections = [];
    private IReadOnlyList<MenuItemEventEntry>? _history;
    private MenuItemImageMetadata? _picture;
    private string? _flashMessage;
    private string? _errorMessage;

    [Parameter]
    public Guid MenuItemId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-rename")]
    private RenameInputModel RenameInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-reprice")]
    private RepriceInputModel RepriceInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-describe")]
    private DescribeInputModel DescribeInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-move-section")]
    private MoveInputModel MoveInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-reorder")]
    private ReorderInputModel ReorderInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-image-alt-text")]
    private AltTextInputModel AltTextInput { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Done { get; set; }

    private string ManagePath => $"/administration/menu/{MenuItemId}";

    protected override async Task OnInitializedAsync()
    {
        // BL0008: a form POST binds these itself and may assign null, so the defaults live here.
        RenameInput ??= new();
        RepriceInput ??= new();
        DescribeInput ??= new();
        MoveInput ??= new();
        ReorderInput ??= new();
        AltTextInput ??= new();

        _item = await MenuItems.GetAsync(MenuItemId, HttpContext.RequestAborted);
        if (_item is null)
        {
            return;
        }

        // Every heading, active and inactive, in display order — §11.4's administrator sees the ones no
        // guest can reach, which is precisely where next week's menu gets stocked.
        _sections = await MenuSections.ListAsync(HttpContext.RequestAborted);

        _history = await MenuEvents.ListForItemAsync(MenuItemId, HttpContext.RequestAborted);

        // Metadata rather than the bytes. The panel renders a URL and three facts; the bytes are read
        // once, by §7's route, when the browser follows that URL — which is the whole reason
        // IMenuItemImageDirectory has two reads instead of one.
        _picture = await MenuItemPictures.FindForItemAsync(MenuItemId, HttpContext.RequestAborted);

        // On GET, pre-fill both editors with what is stored and render any post/redirect flash. On POST
        // the submitted values are already bound, so they must not be overwritten.
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (string.IsNullOrEmpty(RenameInput.Name))
            {
                RenameInput.Name = _item.Name;
            }

            RepriceInput.PriceAmount = _item.PriceAmount;

            // Unlike the name, an empty description is a legitimate stored value, so `IsNullOrEmpty`
            // cannot tell "nothing bound yet" from "the item has none" — and it does not need to: on a
            // GET nothing has bound, so assigning unconditionally is both correct and simpler.
            DescribeInput.Description = _item.Description;
            ReorderInput.DisplayOrder = _item.DisplayOrder;

            // Pre-selected on the heading the item is already under, so the form opens showing the truth
            // and submitting it unchanged is the no-op the write service reports rather than a move to
            // whichever heading happened to sort first. CreateMenuItem pre-selects for the mirror-image
            // reason: a <select> with nothing selected shows and posts its first option either way.
            MoveInput.MenuSectionIdentifier = _item.MenuSectionIdentifier;

            // Pre-filled with what is stored, including "" — the same reasoning the description editor
            // above uses: on a GET nothing has bound, so assigning unconditionally is both correct and
            // simpler, and `IsNullOrEmpty` could not tell "nothing bound" from "no caption" anyway. The
            // consequence is that saving an untouched form is the no-op the write service reports, which
            // is why that outcome is the ordinary one rather than an edge case.
            AltTextInput.AltText = _picture?.AltText ?? string.Empty;

            _flashMessage = FlashFor(Done);
        }
    }

    private async Task RenameAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        RenameMenuItemResult result = await MenuChanges.RenameMenuItemAsync(
            MenuItemId, RenameInput.Name.Trim(), administrator, HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case RenameMenuItemOutcome.Renamed:
                RedirectWithOutcome("renamed");
                break;
            case RenameMenuItemOutcome.NoChange:
                RedirectWithOutcome("rename-no-change");
                break;
            case RenameMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task RepriceAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        RepriceMenuItemResult result = await MenuChanges.RepriceMenuItemAsync(
            MenuItemId, RepriceInput.PriceAmount, administrator, HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case RepriceMenuItemOutcome.Repriced:
                RedirectWithOutcome("repriced");
                break;
            case RepriceMenuItemOutcome.NoChange:
                RedirectWithOutcome("reprice-no-change");
                break;
            case RepriceMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task DescribeAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        DescribeMenuItemOutcome outcome = await MenuChanges.DescribeMenuItemAsync(
            MenuItemId, DescribeInput.Description, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case DescribeMenuItemOutcome.Described:
                RedirectWithOutcome(
                    DescribeInput.Description.Trim().Length == 0 ? "description-cleared" : "described");
                break;
            case DescribeMenuItemOutcome.NoChange:
                RedirectWithOutcome("describe-no-change");
                break;
            case DescribeMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task MoveAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        MoveMenuItemToSectionOutcome outcome = await MenuChanges.MoveMenuItemToSectionAsync(
            MenuItemId, MoveInput.MenuSectionIdentifier, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case MoveMenuItemToSectionOutcome.Moved:
                RedirectWithOutcome("refiled");
                break;
            case MoveMenuItemToSectionOutcome.NoChange:
                RedirectWithOutcome("refile-no-change");
                break;
            case MoveMenuItemToSectionOutcome.MenuSectionNotFound:
                // A heading deleted or a page left open. Reported in place rather than redirected, for
                // the reason CreateMenuItem reports the same outcome in place: the person needs to see
                // the picker beside the message, not a fresh page with no account of what happened.
                _errorMessage =
                    "That section no longer exists. It may have been changed while this page was open —"
                    + " reload the page and choose again.";
                break;
            case MoveMenuItemToSectionOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task ReorderAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        ReorderMenuItemOutcome outcome = await MenuChanges.ReorderMenuItemAsync(
            MenuItemId, ReorderInput.DisplayOrder, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case ReorderMenuItemOutcome.Reordered:
                RedirectWithOutcome("moved");
                break;
            case ReorderMenuItemOutcome.NoChange:
                RedirectWithOutcome("move-no-change");
                break;
            case ReorderMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task ToggleAvailabilityAsync()
    {
        if (_item is null || !TryBegin(out Guid administrator))
        {
            return;
        }

        bool target = !_item.IsActive;
        SetMenuItemAvailabilityResult result = await MenuChanges.SetMenuItemActiveAsync(
            MenuItemId, target, administrator, HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case SetMenuItemAvailabilityOutcome.Changed:
                RedirectWithOutcome(target ? "made-available" : "made-unavailable");
                break;
            case SetMenuItemAvailabilityOutcome.AlreadyInThatState:
                // Somebody in the kitchen got there first between this page rendering and the button
                // being pressed. Nothing changed and nothing is wrong; re-render on the truth.
                Navigation.NavigateTo(ManagePath);
                break;
            case SetMenuItemAvailabilityOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    /// <summary>
    /// Attaches or replaces the picture (§7, §11.4).
    ///
    /// <para><b>This is the one handler on the page that reaches past the model binder</b>, and the note
    /// at the top of the file says why. The file arrives as a multipart part and is looked up by name;
    /// <c>Request.Form</c> is a cached collection by the time this runs, because the framework read the
    /// body already in order to dispatch here.</para>
    ///
    /// <para><b>No size is checked here and that is deliberate.</b> §8.2 declares the cap in a named
    /// CHECK, the write service reports a violation of it by constraint name, and a second copy in this
    /// file would be F-65's mechanism — worse, it would be the belt that hides the buckle. The bound on
    /// what this process will buffer is the one every other POST in this application already has:
    /// Kestrel's request-body limit, which no form here raises. So the picture form introduces no new
    /// number anywhere.</para>
    ///
    /// <para><b>The declared media type is the browser's, handed on unaltered.</b> This page does not
    /// identify the format itself, even though <c>ImageFormat</c> is public and could: the write service
    /// is the one place that decides what an image is, and a surface that pre-judged would leave two of
    /// its outcomes unreachable from the only form that can produce them. What the browser sends is what
    /// gets checked against the bytes.</para>
    /// </summary>
    private async Task AttachPictureAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        IFormFile? file = HttpContext.Request.Form.Files[MenuItemImageUpload.FileFieldName];

        byte[] bytes = [];
        if (file is not null)
        {
            using MemoryStream buffer = new();
            using Stream content = file.OpenReadStream();
            await content.CopyToAsync(buffer, HttpContext.RequestAborted);
            bytes = buffer.ToArray();
        }

        // A NEW identifier every time, including on a replace: §7's route is keyed on the image so that
        // the URL changes when the bytes do, which is what makes the immutable cache header true.
        AttachMenuItemImageResult result = await MenuChanges.AttachMenuItemImageAsync(
            IdentifierFactory.Create(),
            MenuItemId,
            file?.ContentType ?? string.Empty,
            bytes,
            administrator,
            HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case AttachMenuItemImageOutcome.Attached:
                RedirectWithOutcome("picture-attached");
                break;
            case AttachMenuItemImageOutcome.Replaced:
                RedirectWithOutcome("picture-replaced");
                break;
            case AttachMenuItemImageOutcome.BytesEmpty:
                // Reported in place rather than redirected, like the refile's stale-heading arm: the
                // person needs the message beside the control they were using. Worded to cover both
                // ways of getting here, because a form submitted with nothing chosen sends an empty
                // part rather than no part at all, and the two are one mistake to the person making it.
                _errorMessage = "No file was chosen, or the file was empty. Nothing changed.";
                break;
            case AttachMenuItemImageOutcome.UnsupportedContentType:
                _errorMessage =
                    $"Your browser sent that file as “{file?.ContentType}”, which is not a picture format"
                    + " this menu serves. Choose a JPEG, a PNG or a WebP. Nothing changed.";
                break;
            case AttachMenuItemImageOutcome.ContentTypeContradictedByBytes:
                _errorMessage =
                    "That file is not the format its name says it is, so it was refused rather than"
                    + " stored under a label this application would then serve it with. Nothing changed.";
                break;
            case AttachMenuItemImageOutcome.BytesOverCap:
                _errorMessage =
                    "That picture is larger than this menu will store. A photograph taken on a phone is"
                    + " usually several times the limit — export or resize it smaller and try again."
                    + " Nothing changed.";
                break;
            case AttachMenuItemImageOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    /// <summary>
    /// Takes the picture off the item (§7). The row is deleted rather than flagged, which is a stated
    /// exception to §6.8 rather than an oversight: the history is in <c>menu_item_image_event</c>, and
    /// the event that attached the picture records what it was.
    /// </summary>
    private async Task RemovePictureAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        RemoveMenuItemImageOutcome outcome = await MenuChanges.RemoveMenuItemImageAsync(
            MenuItemId, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case RemoveMenuItemImageOutcome.Removed:
                RedirectWithOutcome("picture-removed");
                break;
            case RemoveMenuItemImageOutcome.NoImage:
                // Two administrators pressing Remove seconds apart. Nothing changed and nothing is
                // wrong; re-render on the truth, exactly as the availability toggle does.
                Navigation.NavigateTo(ManagePath);
                break;
            case RemoveMenuItemImageOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    /// <summary>
    /// Writes the caption a screen reader reads instead of the picture (§7, §11.1).
    ///
    /// <para><b>Trimmed here rather than in the write service</b>, on the division this page already draws
    /// for a rename: whitespace somebody's keyboard added is a property of a form submission, and the write
    /// service stores what it is given. It matters more here than for a name, because a caption trimmed to
    /// nothing is the same thing as no caption — <c>""</c> means <em>none</em> (§7) — so a form submitted
    /// with a single space clears it rather than storing a space a screen reader would read as a pause.</para>
    ///
    /// <para><b><c>NoImage</c> is reachable and is reported in place.</b> The form only renders when a
    /// picture exists, so getting here needs two administrators and a few seconds — one removes the
    /// photograph while the other is typing about it. Redirecting on that would throw away what they wrote
    /// with no explanation, which is the same reasoning the refile's stale-heading arm follows.</para>
    /// </summary>
    private async Task SetPictureAltTextAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        SetMenuItemImageAltTextOutcome outcome = await MenuChanges.SetMenuItemImageAltTextAsync(
            MenuItemId,
            AltTextInput.AltText.Trim(),
            administrator,
            HttpContext.RequestAborted);

        switch (outcome)
        {
            case SetMenuItemImageAltTextOutcome.Changed:
                RedirectWithOutcome(
                    AltTextInput.AltText.Trim().Length == 0 ? "caption-cleared" : "caption-saved");
                break;
            case SetMenuItemImageAltTextOutcome.NoChange:
                RedirectWithOutcome("caption-no-change");
                break;
            case SetMenuItemImageAltTextOutcome.NoImage:
                _errorMessage =
                    "There is no picture on this item any more, so there is nothing for a caption to"
                    + " describe. Somebody may have removed it while this page was open. Nothing changed.";
                break;
            case SetMenuItemImageAltTextOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    /// <summary>
    /// The two things every write on this page needs first: the item must still exist, and the acting
    /// administrator must be identifiable — <c>menu_item_event.actor_person_identifier</c> is NOT NULL and
    /// §7 requires every change to name somebody. Endpoint authorization already guarantees the second;
    /// this is the belt to that brace.
    /// </summary>
    private bool TryBegin(out Guid administrator)
    {
        administrator = Guid.Empty;

        if (_item is null)
        {
            Navigation.NavigateTo("/administration/menu");
            return false;
        }

        if (PersonPrincipal.IdentifierFor(HttpContext.User) is not { } identifier)
        {
            _errorMessage = "Your session could not be identified. Sign in again and retry.";
            return false;
        }

        administrator = identifier;
        return true;
    }

    private void RedirectWithOutcome(string outcome)
        => Navigation.NavigateTo($"{ManagePath}?done={outcome}");

    private static string? FlashFor(string? outcome) => outcome switch
    {
        "renamed" => "Renamed. The new name shows everywhere immediately, including on past orders.",
        "rename-no-change" => "That was already the name — nothing changed.",
        "repriced" => "Repriced. Lines already on an order keep the price they were added at.",
        "reprice-no-change" => "That was already the price — nothing changed.",
        "described" => "Description saved. Guests reading the menu see it from now on.",
        "description-cleared" => "Description cleared. Guests see the name and the price only.",
        "describe-no-change" => "That was already the description — nothing changed.",
        "refiled" => "Filed under its new heading, at the end of it. Every open menu has already"
            + " regrouped; set the position below if the end is not where it belongs.",
        "refile-no-change" => "It was already under that heading — nothing changed.",
        "moved" => "Moved. The menu is ordered by position, then by name.",
        "move-no-change" => "It was already in that position — nothing changed.",
        "made-unavailable" => "Marked unavailable. It stays on the guest's menu, labelled unavailable, and cannot be ordered.",
        "made-available" => "Marked available. It can be ordered again.",
        "picture-attached" => "Picture attached.",
        "picture-replaced" => "Picture replaced. The old one is deleted and its address no longer works,"
            + " which is why a browser may safely keep the new one for a year.",
        "picture-removed" => "Picture removed. The record of it stays in the history below.",
        "caption-saved" => "Caption saved. Guests using a screen reader hear it instead of the picture,"
            + " and every open menu has already picked it up.",
        "caption-cleared" => "Caption cleared. A screen reader will skip the picture, which is the right"
            + " outcome unless the photograph shows something the dish's name does not.",
        "caption-no-change" => "That was already the caption — nothing changed.",
        _ => null,
    };

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    /// <summary>
    /// A friendly label for each event type §8.2's vocabulary CHECK admits, falling back to the stored
    /// string for anything else — §11.4 renders the record, so an unrecognised type must show as itself
    /// rather than be swallowed.
    ///
    /// <para><b>No count of the vocabulary is stated.</b> It was stated as <em>five</em> in three files
    /// and <c>0004</c> made it seven; a number here is one fact recorded where nothing can check it, and
    /// the arms below are the only honest census (F-77).</para>
    ///
    /// <para><c>description_changed</c> reads differently when the description was cleared, because
    /// <c>""</c> is a stored value rather than an absence and "Description set to nothing" is not what
    /// somebody reading a history wants. The arm tests the payload's length rather than for null: the
    /// paired CHECK guarantees this type carries one, and the <c>?? string.Empty</c> is there so a row
    /// written by something that got past the constraint still renders.</para>
    /// </summary>
    private string Describe(MenuItemEventEntry entry) => entry.EventType switch
    {
        "created" => $"Created as “{entry.NewName}” at {Money(entry.NewPriceAmount ?? 0m)}",
        "name_changed" => $"Renamed to “{entry.NewName}”",
        "price_changed" => $"Repriced to {Money(entry.NewPriceAmount ?? 0m)}",
        "description_changed" => (entry.NewDescription ?? string.Empty).Length == 0
            ? "Description cleared"
            : $"Description set to “{entry.NewDescription}”",
        "section_changed" => $"Filed under “{entry.NewMenuSectionName}”",
        "reordered" => $"Moved to position {entry.NewDisplayOrder}",
        "activated" => "Marked available",
        "deactivated" => "Marked unavailable",
        _ => entry.EventType,
    };

    private sealed class RenameInputModel
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(120, MinimumLength = 1, ErrorMessage = "The name must be 1–120 characters.")]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class RepriceInputModel
    {
        [Range(0, 99999999.99, ErrorMessage = "The price must be between 0 and 99,999,999.99.")]
        public decimal PriceAmount { get; set; }
    }

    private sealed class DescribeInputModel
    {
        // No [Required]: clearing the description is a supported change. The 2,000 matches
        // CreateMenuItem's, and is this form's opinion rather than the column's — `text` has no ceiling.
        [StringLength(2000, ErrorMessage = "The description must be 2,000 characters or fewer.")]
        public string Description { get; set; } = string.Empty;
    }

    private sealed class MoveInputModel
    {
        // No [Required], for CreateMenuItem's reason rather than as an omission: Guid is a value type, so
        // [Required] passes on Guid.Empty and would assert nothing. The select is pre-selected on the
        // item's own heading, has no empty option, and the write service reports an identifier that names
        // nothing — three defences, none of which is a validation attribute that does not work.
        public Guid MenuSectionIdentifier { get; set; }
    }

    private sealed class ReorderInputModel
    {
        // The upper bound is `integer`'s, and it is stated so the form refuses what the column would.
        [Range(0, 2147483647, ErrorMessage = "The position must be 0 or greater.")]
        public int DisplayOrder { get; set; }
    }

    private sealed class AltTextInputModel
    {
        // No [Required]: clearing the caption is a supported change and "" means none (§7), exactly as it
        // does for the description above. The 500 is THIS FORM'S opinion and not the column's — `text` has
        // no ceiling — and it is lower than the description's 2,000 on purpose: alternative text a screen
        // reader has to get through before the name and the price is alternative text nobody finishes.
        [StringLength(500, ErrorMessage = "The caption must be 500 characters or fewer.")]
        public string AltText { get; set; } = string.Empty;
    }
}
