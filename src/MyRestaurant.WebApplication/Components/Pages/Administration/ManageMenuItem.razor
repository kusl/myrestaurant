@page "/administration/menu/{MenuItemId:guid}"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.WebApplication.Menu
@using MyRestaurant.WebApplication.Orders
@inject IMenuDirectory MenuItems
@inject IMenuEventLog MenuEvents
@inject IMenuWorkflow MenuChanges
@inject RestaurantOptions Options
@inject NavigationManager Navigation
@inject RestaurantTime RestaurantClock

@* Manage one menu item (TECHNICAL_SPECIFICATION §7, §11.4). Administrator only (endpoint
   authorization). Static SSR: rename, reprice, and the availability toggle are full-page form posts.
   Successful changes redirect back here (post/redirect/get) carrying a one-word outcome so a refresh does
   not re-post; the shape ManageTable established.

   Rename, reprice, describe and reposition are four forms rather than one "save", because §7's event
   vocabulary has `name_changed`, `price_changed`, `description_changed` and `reordered` as separate types
   with mutually exclusive payload columns — a combined save would write four events anyway and would then
   have to decide what to do when three of them changed nothing.

   The history below is complete and uncapped, oldest first. §11.4: administration renders "the complete
   stored record everywhere — full event streams … never projected or truncated for the administrator". A
   price argument is settled by reading forward from `created`, so that is the direction it renders. *@

<PageTitle>@(_item is null ? "Manage menu item" : $"Manage {_item.Name}")</PageTitle>

@if (_item is null)
{
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Menu item not found</h1>
        <p class="lede">No menu item exists with that identifier. It may have never existed, or the link is stale.</p>
        <p><a href="/administration/menu">Back to the menu</a></p>
    </section>
}
else
{
    <section class="panel account-panel">
        <div class="page-head">
            <div>
                <p class="eyebrow">Administration — menu</p>
                <h1>@_item.Name</h1>
            </div>
        </div>

        @if (_flashMessage is not null)
        {
            <p class="status-success" role="status">@_flashMessage</p>
        }
        @if (_errorMessage is not null)
        {
            <p class="status-error" role="alert">@_errorMessage</p>
        }

        <div class="manage-facts">
            <div>
                <span class="manage-label">Availability</span>
                @if (_item.IsActive)
                {
                    <span class="chip chip-ok">Available</span>
                }
                else
                {
                    <span class="chip chip-warn">Currently unavailable</span>
                }
            </div>
            <div>
                <span class="manage-label">Price</span>
                <span class="record-numeric">@Money(_item.PriceAmount)</span>
            </div>
            <div>
                <span class="manage-label">Section</span>
                <span>@_item.MenuSectionName</span>
                @if (!_item.MenuSectionIsActive)
                {
                    @* §7: an inactive SECTION is hidden from the guest entirely, where an inactive ITEM
                       stays visible and marked. This item may say "Available" one box to the left and
                       still be unreachable on a phone, and that is the one fact this page could not
                       otherwise explain. *@
                    <span class="chip chip-warn">Hidden from guests</span>
                }
            </div>
            <div>
                <span class="manage-label">Position</span>
                <span class="record-numeric">@_item.DisplayOrder</span>
            </div>
            <div>
                <span class="manage-label">Created</span>
                <span>@RestaurantClock.DateAndTime(_item.CreatedAt)</span>
            </div>
        </div>

        @if (_item.Description.Length > 0)
        {
            <p class="lede">@_item.Description</p>
        }
        else
        {
            <p class="lede muted">No description. Guests see the name and the price only.</p>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">Name</h2>
        <p class="lede">
            Renaming shows through everywhere immediately, including on lines already sent and on closed
            bills — the name is read at display time, not captured (§8.3). Rename to correct a spelling;
            create a second item if it is a different dish.
        </p>
        <EditForm Model="RenameInput" method="post" OnValidSubmit="RenameAsync" FormName="menu-item-rename" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="rename-name">New name</label>
            <InputText id="rename-name" @bind-Value="RenameInput.Name" autocomplete="off" />
            <button type="submit" class="button-primary">Rename</button>
            <ValidationMessage For="@(() => RenameInput.Name)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Price</h2>
        <p class="lede">
            A new price applies to lines added <strong>from now on</strong>. Anything already on an order
            keeps the price it was added at, including on open tables — that is the capture rule (§6.5.4),
            and it is why a guest who ordered before the change is not surprised at the till.
        </p>
        <EditForm Model="RepriceInput" method="post" OnValidSubmit="RepriceAsync" FormName="menu-item-reprice" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="reprice-price">New price</label>
            <span class="manage-currency">@Options.CurrencyCode</span>
            <InputNumber id="reprice-price" @bind-Value="RepriceInput.PriceAmount" step="0.01" min="0" inputmode="decimal" />
            <button type="submit" class="button-primary">Reprice</button>
            <ValidationMessage For="@(() => RepriceInput.PriceAmount)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Description</h2>
        <p class="lede">
            One or two sentences a guest reads before ordering. Optional — clearing the box is an ordinary
            change with an ordinary entry in the history below, not a deletion. Saving the same text again
            records nothing.
        </p>
        @* A `.form-field` block rather than `.manage-inline-form`, deliberately: that class styles
           `input` and `select` and has never styled a `textarea`, so a three-line box inside it would be
           an unstyled control on the one page that has one. `.form-field textarea` is app.css's own
           declaration and this page declares nothing, which is what F-66 was about. *@
        <EditForm Model="DescribeInput" method="post" OnValidSubmit="DescribeAsync" FormName="menu-item-describe">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label class="visually-hidden" for="describe-description">Description</label>
                <InputTextArea id="describe-description" @bind-Value="DescribeInput.Description" rows="3" autocomplete="off" />
                <ValidationMessage For="@(() => DescribeInput.Description)" />
            </div>
            <div class="form-actions">
                <button type="submit" class="button-primary">Save description</button>
            </div>
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Position</h2>
        <p class="lede">
            Where this item sits on the menu. Lower comes first; items sharing a position are ordered by
            name, which is why every item starts at 0 and the menu reads alphabetically until somebody
            decides otherwise. Positions do not have to be unique or contiguous.
        </p>
        <EditForm Model="ReorderInput" method="post" OnValidSubmit="ReorderAsync" FormName="menu-item-reorder" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="reorder-position">New position</label>
            <InputNumber id="reorder-position" @bind-Value="ReorderInput.DisplayOrder" step="1" min="0" inputmode="numeric" />
            <button type="submit" class="button-primary">Move</button>
            <ValidationMessage For="@(() => ReorderInput.DisplayOrder)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Availability</h2>
        @if (_item.IsActive)
        {
            <p class="lede">
                Marking this unavailable is the "86". It stays on the guest's menu, labelled unavailable,
                and cannot be added to a send; nothing is hidden and nothing is deleted. The kitchen and
                the counter can do this too, from their own screens.
            </p>
            <form method="post" @formname="menu-item-set-active" @onsubmit="ToggleAvailabilityAsync">
                <AntiforgeryToken />
                <div class="form-actions">
                    <button type="submit" class="button-secondary">Mark unavailable</button>
                </div>
            </form>
        }
        else
        {
            <p class="lede">
                This item is on the menu marked unavailable and cannot be ordered. Bring it back when it
                is on again.
            </p>
            <form method="post" @formname="menu-item-set-active" @onsubmit="ToggleAvailabilityAsync">
                <AntiforgeryToken />
                <div class="form-actions">
                    <button type="submit" class="button-primary">Mark available</button>
                </div>
            </form>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">History</h2>
        @if (_history is null || _history.Count == 0)
        {
            <p class="lede">No recorded changes. That is only possible for an item created before this log existed.</p>
        }
        else
        {
            <p class="lede">
                Everything that has ever happened to this item, oldest first — @_history.Count
                @(_history.Count == 1 ? "entry" : "entries"), complete and untruncated.
            </p>
            @* A shared record list rather than the page's own table inside `overflow-x: auto`. The
               wrapper contained the sideways scroll, so the document never scrolled and §16.3
               scenario 16 would have passed it — but three unlabelled cells in a card is a column of
               bare values, which is the half of F-59 that is about the reader rather than the
               affordance. *@
            <div class="record-list">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Change</th>
                            <th scope="col">By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MenuItemEventEntry entry in _history)
                        {
                            <tr>
                                <td data-label="When">@RestaurantClock.DateAndTime(entry.OccurredAt)</td>
                                <td class="record-primary" data-label="Change">@Describe(entry)</td>
                                <td data-label="By">@entry.ActorName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="manage-back"><a href="/administration/menu">Back to the menu</a></p>
    </section>
}

@* This page declares nothing. Its facts grid, its chips, its headings, its rules, its two small
   forms, its currency unit and — as of M6 Slice 34 — its history list are all app.css's §11.12
   vocabulary. This was one of four pages carrying an inline copy of that vocabulary, and the copies had
   drifted (F-66); the history table was also the page's own eighty-line table rules under a different
   name. *@

@code {
    private MenuItemSummary? _item;
    private IReadOnlyList<MenuItemEventEntry>? _history;
    private string? _flashMessage;
    private string? _errorMessage;

    [Parameter]
    public Guid MenuItemId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-rename")]
    private RenameInputModel RenameInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-reprice")]
    private RepriceInputModel RepriceInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-describe")]
    private DescribeInputModel DescribeInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-item-reorder")]
    private ReorderInputModel ReorderInput { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Done { get; set; }

    private string ManagePath => $"/administration/menu/{MenuItemId}";

    protected override async Task OnInitializedAsync()
    {
        // BL0008: a form POST binds these itself and may assign null, so the defaults live here.
        RenameInput ??= new();
        RepriceInput ??= new();
        DescribeInput ??= new();
        ReorderInput ??= new();

        _item = await MenuItems.GetAsync(MenuItemId, HttpContext.RequestAborted);
        if (_item is null)
        {
            return;
        }

        _history = await MenuEvents.ListForItemAsync(MenuItemId, HttpContext.RequestAborted);

        // On GET, pre-fill both editors with what is stored and render any post/redirect flash. On POST
        // the submitted values are already bound, so they must not be overwritten.
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (string.IsNullOrEmpty(RenameInput.Name))
            {
                RenameInput.Name = _item.Name;
            }

            RepriceInput.PriceAmount = _item.PriceAmount;

            // Unlike the name, an empty description is a legitimate stored value, so `IsNullOrEmpty`
            // cannot tell "nothing bound yet" from "the item has none" — and it does not need to: on a
            // GET nothing has bound, so assigning unconditionally is both correct and simpler.
            DescribeInput.Description = _item.Description;
            ReorderInput.DisplayOrder = _item.DisplayOrder;

            _flashMessage = FlashFor(Done);
        }
    }

    private async Task RenameAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        RenameMenuItemResult result = await MenuChanges.RenameMenuItemAsync(
            MenuItemId, RenameInput.Name.Trim(), administrator, HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case RenameMenuItemOutcome.Renamed:
                RedirectWithOutcome("renamed");
                break;
            case RenameMenuItemOutcome.NoChange:
                RedirectWithOutcome("rename-no-change");
                break;
            case RenameMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task RepriceAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        RepriceMenuItemResult result = await MenuChanges.RepriceMenuItemAsync(
            MenuItemId, RepriceInput.PriceAmount, administrator, HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case RepriceMenuItemOutcome.Repriced:
                RedirectWithOutcome("repriced");
                break;
            case RepriceMenuItemOutcome.NoChange:
                RedirectWithOutcome("reprice-no-change");
                break;
            case RepriceMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task DescribeAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        DescribeMenuItemOutcome outcome = await MenuChanges.DescribeMenuItemAsync(
            MenuItemId, DescribeInput.Description, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case DescribeMenuItemOutcome.Described:
                RedirectWithOutcome(
                    DescribeInput.Description.Trim().Length == 0 ? "description-cleared" : "described");
                break;
            case DescribeMenuItemOutcome.NoChange:
                RedirectWithOutcome("describe-no-change");
                break;
            case DescribeMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task ReorderAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        ReorderMenuItemOutcome outcome = await MenuChanges.ReorderMenuItemAsync(
            MenuItemId, ReorderInput.DisplayOrder, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case ReorderMenuItemOutcome.Reordered:
                RedirectWithOutcome("moved");
                break;
            case ReorderMenuItemOutcome.NoChange:
                RedirectWithOutcome("move-no-change");
                break;
            case ReorderMenuItemOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task ToggleAvailabilityAsync()
    {
        if (_item is null || !TryBegin(out Guid administrator))
        {
            return;
        }

        bool target = !_item.IsActive;
        SetMenuItemAvailabilityResult result = await MenuChanges.SetMenuItemActiveAsync(
            MenuItemId, target, administrator, HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case SetMenuItemAvailabilityOutcome.Changed:
                RedirectWithOutcome(target ? "made-available" : "made-unavailable");
                break;
            case SetMenuItemAvailabilityOutcome.AlreadyInThatState:
                // Somebody in the kitchen got there first between this page rendering and the button
                // being pressed. Nothing changed and nothing is wrong; re-render on the truth.
                Navigation.NavigateTo(ManagePath);
                break;
            case SetMenuItemAvailabilityOutcome.MenuItemNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    /// <summary>
    /// The two things every write on this page needs first: the item must still exist, and the acting
    /// administrator must be identifiable — <c>menu_item_event.actor_person_identifier</c> is NOT NULL and
    /// §7 requires every change to name somebody. Endpoint authorization already guarantees the second;
    /// this is the belt to that brace.
    /// </summary>
    private bool TryBegin(out Guid administrator)
    {
        administrator = Guid.Empty;

        if (_item is null)
        {
            Navigation.NavigateTo("/administration/menu");
            return false;
        }

        if (PersonPrincipal.IdentifierFor(HttpContext.User) is not { } identifier)
        {
            _errorMessage = "Your session could not be identified. Sign in again and retry.";
            return false;
        }

        administrator = identifier;
        return true;
    }

    private void RedirectWithOutcome(string outcome)
        => Navigation.NavigateTo($"{ManagePath}?done={outcome}");

    private static string? FlashFor(string? outcome) => outcome switch
    {
        "renamed" => "Renamed. The new name shows everywhere immediately, including on past orders.",
        "rename-no-change" => "That was already the name — nothing changed.",
        "repriced" => "Repriced. Lines already on an order keep the price they were added at.",
        "reprice-no-change" => "That was already the price — nothing changed.",
        "described" => "Description saved. Guests reading the menu see it from now on.",
        "description-cleared" => "Description cleared. Guests see the name and the price only.",
        "describe-no-change" => "That was already the description — nothing changed.",
        "moved" => "Moved. The menu is ordered by position, then by name.",
        "move-no-change" => "It was already in that position — nothing changed.",
        "made-unavailable" => "Marked unavailable. It stays on the guest's menu, labelled unavailable, and cannot be ordered.",
        "made-available" => "Marked available. It can be ordered again.",
        _ => null,
    };

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    /// <summary>
    /// A friendly label for each event type §8.2's vocabulary CHECK admits, falling back to the stored
    /// string for anything else — §11.4 renders the record, so an unrecognised type must show as itself
    /// rather than be swallowed. <c>0005</c>'s <c>section_changed</c> will read as itself here until this
    /// arm is written, which is the fallback working rather than failing.
    ///
    /// <para><b>No count of the vocabulary is stated.</b> It was stated as <em>five</em> in three files
    /// and <c>0004</c> made it seven; a number here is one fact recorded where nothing can check it, and
    /// the arms below are the only honest census (F-77).</para>
    ///
    /// <para><c>description_changed</c> reads differently when the description was cleared, because
    /// <c>""</c> is a stored value rather than an absence and "Description set to nothing" is not what
    /// somebody reading a history wants. The arm tests the payload's length rather than for null: the
    /// paired CHECK guarantees this type carries one, and the <c>?? string.Empty</c> is there so a row
    /// written by something that got past the constraint still renders.</para>
    /// </summary>
    private string Describe(MenuItemEventEntry entry) => entry.EventType switch
    {
        "created" => $"Created as “{entry.NewName}” at {Money(entry.NewPriceAmount ?? 0m)}",
        "name_changed" => $"Renamed to “{entry.NewName}”",
        "price_changed" => $"Repriced to {Money(entry.NewPriceAmount ?? 0m)}",
        "description_changed" => (entry.NewDescription ?? string.Empty).Length == 0
            ? "Description cleared"
            : $"Description set to “{entry.NewDescription}”",
        "section_changed" => $"Filed under “{entry.NewMenuSectionName}”",
        "reordered" => $"Moved to position {entry.NewDisplayOrder}",
        "activated" => "Marked available",
        "deactivated" => "Marked unavailable",
        _ => entry.EventType,
    };

    private sealed class RenameInputModel
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(120, MinimumLength = 1, ErrorMessage = "The name must be 1–120 characters.")]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class RepriceInputModel
    {
        [Range(0, 99999999.99, ErrorMessage = "The price must be between 0 and 99,999,999.99.")]
        public decimal PriceAmount { get; set; }
    }

    private sealed class DescribeInputModel
    {
        // No [Required]: clearing the description is a supported change. The 2,000 matches
        // CreateMenuItem's, and is this form's opinion rather than the column's — `text` has no ceiling.
        [StringLength(2000, ErrorMessage = "The description must be 2,000 characters or fewer.")]
        public string Description { get; set; } = string.Empty;
    }

    private sealed class ReorderInputModel
    {
        // The upper bound is `integer`'s, and it is stated so the form refuses what the column would.
        [Range(0, 2147483647, ErrorMessage = "The position must be 0 or greater.")]
        public int DisplayOrder { get; set; }
    }
}
