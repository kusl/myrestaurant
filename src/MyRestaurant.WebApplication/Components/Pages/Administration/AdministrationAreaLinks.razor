<nav class="page-head-nav" aria-label="Administration areas">
    <ul class="page-head-areas">
        @foreach ((AdministrationArea area, string path, string label) in Areas)
        {
            <li>
                <a href="@path" aria-current="@(area == Current ? "page" : null)">@label</a>
            </li>
        }
    </ul>
</nav>

@code {
    private static readonly (AdministrationArea Area, string Path, string Label)[] Areas =
    [
        (AdministrationArea.People, "/administration", "People"),
        (AdministrationArea.Tables, "/administration/tables", "Tables"),
        (AdministrationArea.Menu, "/administration/menu", "Menu"),
        (AdministrationArea.Sittings, "/administration/sittings", "Sittings"),
        (AdministrationArea.HiddenRecords, "/administration/hidden-records", "Hidden records"),
        (AdministrationArea.Events, "/administration/events", "Events"),
    ];

    [Parameter]
    [EditorRequired]
    public AdministrationArea Current { get; set; }
}
