@page "/administration/menu/sections/{MenuSectionId:guid}"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.WebApplication.Menu
@inject IMenuSectionDirectory MenuSections
@inject IMenuDirectory MenuItems
@inject IMenuSectionEventLog MenuSectionEvents
@inject IMenuWorkflow MenuChanges
@inject NavigationManager Navigation
@inject RestaurantTime RestaurantClock

<PageTitle>@(_section is null ? "Manage menu section" : $"Manage {_section.Name}")</PageTitle>

@if (_section is null)
{
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Menu section not found</h1>
        <p class="lede">
            No menu section exists with that identifier. It may have never existed, or the link is stale.
        </p>
        <p><a href="/administration/menu">Back to the menu</a></p>
    </section>
}
else
{
    <section class="panel account-panel">
        <div class="page-head">
            <div>
                <p class="eyebrow">Administration — menu section</p>
                <h1>@_section.Name</h1>
            </div>
        </div>

        @if (_flashMessage is not null)
        {
            <p class="status-success" role="status">@_flashMessage</p>
        }
        @if (_errorMessage is not null)
        {
            <p class="status-error" role="alert">@_errorMessage</p>
        }

        <div class="manage-facts">
            <div>
                <span class="manage-label">Guests</span>
                @if (_section.IsActive)
                {
                    <span class="chip chip-ok">Can see this heading</span>
                }
                else
                {
                    <span class="chip chip-warn">Hidden from guests</span>
                }
            </div>
            <div>
                <span class="manage-label">Position</span>
                <span class="record-numeric">@_section.DisplayOrder</span>
            </div>
            <div>
                <span class="manage-label">Items under it</span>
                <span class="record-numeric">@_itemCount</span>
            </div>
            <div>
                <span class="manage-label">Created</span>
                <span>@RestaurantClock.DateAndTime(_section.CreatedAt)</span>
            </div>
        </div>

        @if (_section.Description.Length > 0)
        {
            <p class="lede">@_section.Description</p>
        }
        else
        {
            <p class="lede muted">No description. The heading stands on its own.</p>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">Name</h2>
        <p class="lede">
            The heading guests read above every item filed under it. Renaming shows through everywhere
            immediately — the guest menu, the create-item picker, and every item's own page, because the
            name is read at display time rather than captured. Section names must be unique and the check
            ignores capitalisation, so "drinks" collides with "Drinks"; correcting the capitalisation of
            <em>this</em> heading is still a real change, because it is what every guest reads.
        </p>
        <EditForm Model="RenameInput" method="post" OnValidSubmit="RenameAsync" FormName="menu-section-rename" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="rename-name">New name</label>
            <InputText id="rename-name" @bind-Value="RenameInput.Name" autocomplete="off" />
            <button type="submit" class="button-primary">Rename</button>
            <ValidationMessage For="@(() => RenameInput.Name)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Description</h2>
        <p class="lede">
            A line about the whole heading — "served until 11am" is the kind of thing it is for. Optional;
            clearing the box is an ordinary change with an ordinary entry in the history below, not a
            deletion. Saving the same text again records nothing. Guests read this: it appears under the
            heading on the menu at every table, on every phone already looking at it, without anybody
            reloading.
        </p>

        <EditForm Model="DescribeInput" method="post" OnValidSubmit="DescribeAsync" FormName="menu-section-describe">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label class="visually-hidden" for="describe-description">Description</label>
                <InputTextArea id="describe-description" @bind-Value="DescribeInput.Description" rows="2" autocomplete="off" />
                <ValidationMessage For="@(() => DescribeInput.Description)" />
            </div>
            <div class="form-actions">
                <button type="submit" class="button-primary">Save description</button>
            </div>
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Position</h2>
        <p class="lede">
            Where this heading sits on the menu. Lower comes first; headings sharing a position are ordered
            by name, which is why the first few sections read alphabetically until somebody decides
            otherwise. Positions do not have to be unique or contiguous — a heading appended today lands
            after every existing one, and moving it is this form's job.
        </p>
        <EditForm Model="ReorderInput" method="post" OnValidSubmit="ReorderAsync" FormName="menu-section-reorder" class="manage-inline-form">
            <DataAnnotationsValidator />
            <label class="visually-hidden" for="reorder-position">New position</label>
            <InputNumber id="reorder-position" @bind-Value="ReorderInput.DisplayOrder" step="1" min="0" inputmode="numeric" />
            <button type="submit" class="button-primary">Move</button>
            <ValidationMessage For="@(() => ReorderInput.DisplayOrder)" />
        </EditForm>

        <hr class="manage-rule" />

        <h2 class="manage-heading">Visibility</h2>
        @if (_section.IsActive)
        {
            <p class="lede">
                Switching this heading off removes it, <strong>and everything under it</strong>, from the
                guest's menu entirely — that is §7's rule for a section, and it is the opposite of the rule
                for an item, which stays visible and marked. It is what "no breakfast this evening" looks
                like. The items themselves are untouched: none of them is marked unavailable, the kitchen's
                own 86s are preserved, and switching the heading back on brings the menu back exactly as it
                was. Nothing is deleted and past orders keep the items they were placed against.
            </p>
            <form method="post" @formname="menu-section-set-active" @onsubmit="ToggleVisibilityAsync">
                <AntiforgeryToken />
                <div class="form-actions">
                    <button type="submit" class="link-button danger">Hide from guests</button>
                </div>
            </form>
        }
        else
        {
            <p class="lede">
                This heading and every item under it are hidden from guests. Administration still sees them
                — including on the create-item form, where this section is offered and marked — so a menu
                can be stocked before it is switched on. Show it again when it is on.
            </p>
            <form method="post" @formname="menu-section-set-active" @onsubmit="ToggleVisibilityAsync">
                <AntiforgeryToken />
                <div class="form-actions">
                    <button type="submit" class="button-primary">Show to guests</button>
                </div>
            </form>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">Items</h2>
        @if (_itemCount == 0)
        {
            <p class="lede">
                Nothing is filed under this heading yet. §11.1 renders no empty headings to guests, so this
                one is invisible to them whatever its visibility says above.
            </p>
        }
        else
        {
            <p class="lede">
                @_itemCount @(_itemCount == 1 ? "item is" : "items are") filed under this heading, in the
                order guests read them. Open one to rename, reprice, describe, reposition or 86 it.
            </p>
            <div class="record-list">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Availability</th>
                            <th scope="col">Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MenuItemSummary item in _items)
                        {
                            <tr @key="item.MenuItemIdentifier">
                                <td class="record-primary" data-label="">
                                    <a class="record-link" href="@($"/administration/menu/{item.MenuItemIdentifier}")">@item.Name</a>
                                </td>
                                <td data-label="">
                                    @if (item.IsActive)
                                    {
                                        <span class="chip chip-ok">Available</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-warn">Currently unavailable</span>
                                    }
                                </td>
                                <td class="record-numeric" data-label="Position">@item.DisplayOrder</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="form-actions">
            <a class="button-secondary" href="/administration/menu/new">Add an item to this heading</a>
        </div>

        <hr class="manage-rule" />

        <h2 class="manage-heading">History</h2>
        @if (_history is null || _history.Count == 0)
        {
            <p class="lede">
                No recorded changes. That is only possible for a section created before this log existed.
            </p>
        }
        else
        {
            <p class="lede">
                Everything that has ever happened to this heading, oldest first — @_history.Count
                @(_history.Count == 1 ? "entry" : "entries"), complete and untruncated.
            </p>
            <div class="record-list">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Change</th>
                            <th scope="col">By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MenuSectionEventEntry entry in _history)
                        {
                            <tr @key="entry.MenuSectionEventIdentifier">
                                <td data-label="When">@RestaurantClock.DateAndTime(entry.OccurredAt)</td>
                                <td class="record-primary" data-label="Change">@Describe(entry)</td>
                                <td data-label="By">@entry.ActorName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="manage-back"><a href="/administration/menu">Back to the menu</a></p>
    </section>
}

@code {
    private MenuSectionSummary? _section;
    private IReadOnlyList<MenuItemSummary> _items = [];
    private IReadOnlyList<MenuSectionEventEntry>? _history;
    private int _itemCount;
    private string? _flashMessage;
    private string? _errorMessage;

    [Parameter]
    public Guid MenuSectionId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-section-rename")]
    private RenameInputModel RenameInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-section-describe")]
    private DescribeInputModel DescribeInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "menu-section-reorder")]
    private ReorderInputModel ReorderInput { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Done { get; set; }

    private string ManagePath => $"/administration/menu/sections/{MenuSectionId}";

    protected override async Task OnInitializedAsync()
    {
        RenameInput ??= new();
        DescribeInput ??= new();
        ReorderInput ??= new();

        _section = await MenuSections.GetAsync(MenuSectionId, HttpContext.RequestAborted);
        if (_section is null)
        {
            return;
        }

        IReadOnlyList<MenuItemSummary> everything = await MenuItems.ListAsync(HttpContext.RequestAborted);
        _items = everything.Where(item => item.MenuSectionIdentifier == MenuSectionId).ToArray();
        _itemCount = _items.Count;

        _history = await MenuSectionEvents.ListForSectionAsync(MenuSectionId, HttpContext.RequestAborted);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (string.IsNullOrEmpty(RenameInput.Name))
            {
                RenameInput.Name = _section.Name;
            }

            DescribeInput.Description = _section.Description;
            ReorderInput.DisplayOrder = _section.DisplayOrder;

            _flashMessage = FlashFor(Done);
        }
    }

    private async Task RenameAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        RenameMenuSectionOutcome outcome = await MenuChanges.RenameMenuSectionAsync(
            MenuSectionId, RenameInput.Name.Trim(), administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case RenameMenuSectionOutcome.Renamed:
                RedirectWithOutcome("renamed");
                break;
            case RenameMenuSectionOutcome.NoChange:
                RedirectWithOutcome("rename-no-change");
                break;
            case RenameMenuSectionOutcome.NameTaken:

                _errorMessage =
                    "Another section already uses that name. Section names ignore capitalisation, so"
                    + " check the menu for one spelled differently.";
                break;
            case RenameMenuSectionOutcome.MenuSectionNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task DescribeAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        DescribeMenuSectionOutcome outcome = await MenuChanges.DescribeMenuSectionAsync(
            MenuSectionId, DescribeInput.Description, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case DescribeMenuSectionOutcome.Described:
                RedirectWithOutcome(
                    DescribeInput.Description.Trim().Length == 0 ? "description-cleared" : "described");
                break;
            case DescribeMenuSectionOutcome.NoChange:
                RedirectWithOutcome("describe-no-change");
                break;
            case DescribeMenuSectionOutcome.MenuSectionNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task ReorderAsync()
    {
        if (!TryBegin(out Guid administrator))
        {
            return;
        }

        ReorderMenuSectionOutcome outcome = await MenuChanges.ReorderMenuSectionAsync(
            MenuSectionId, ReorderInput.DisplayOrder, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case ReorderMenuSectionOutcome.Reordered:
                RedirectWithOutcome("moved");
                break;
            case ReorderMenuSectionOutcome.NoChange:
                RedirectWithOutcome("move-no-change");
                break;
            case ReorderMenuSectionOutcome.MenuSectionNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private async Task ToggleVisibilityAsync()
    {
        if (_section is null || !TryBegin(out Guid administrator))
        {
            return;
        }

        bool target = !_section.IsActive;
        MenuSectionActivationOutcome outcome = await MenuChanges.SetMenuSectionActiveAsync(
            MenuSectionId, target, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case MenuSectionActivationOutcome.Changed:
                RedirectWithOutcome(target ? "shown" : "hidden");
                break;
            case MenuSectionActivationOutcome.NoChange:

                Navigation.NavigateTo(ManagePath);
                break;
            case MenuSectionActivationOutcome.MenuSectionNotFound:
                Navigation.NavigateTo("/administration/menu");
                break;
        }
    }

    private bool TryBegin(out Guid administrator)
    {
        administrator = Guid.Empty;

        if (_section is null)
        {
            Navigation.NavigateTo("/administration/menu");
            return false;
        }

        if (PersonPrincipal.IdentifierFor(HttpContext.User) is not { } identifier)
        {
            _errorMessage = "Your session could not be identified. Sign in again and retry.";
            return false;
        }

        administrator = identifier;
        return true;
    }

    private void RedirectWithOutcome(string outcome)
        => Navigation.NavigateTo($"{ManagePath}?done={outcome}");

    private static string? FlashFor(string? outcome) => outcome switch
    {
        "renamed" => "Renamed. Every open menu has already picked up the new heading.",
        "rename-no-change" => "That was already the name — nothing changed.",
        "described" => "Description saved.",
        "description-cleared" => "Description cleared. The heading stands on its own.",
        "describe-no-change" => "That was already the description — nothing changed.",
        "moved" => "Moved. The menu is ordered by position, then by name.",
        "move-no-change" => "It was already in that position — nothing changed.",
        "hidden" => "Hidden from guests. This heading and everything under it have left every open menu;"
            + " the items themselves are untouched.",
        "shown" => "Showing to guests again, with every item exactly as it was.",
        _ => null,
    };

    private static string Describe(MenuSectionEventEntry entry) => entry.EventType switch
    {
        "created" => $"Created as “{entry.NewName}” at position {entry.NewDisplayOrder}",
        "renamed" => $"Renamed to “{entry.NewName}”",
        "described" => (entry.NewDescription ?? string.Empty).Length == 0
            ? "Description cleared"
            : $"Description set to “{entry.NewDescription}”",
        "reordered" => $"Moved to position {entry.NewDisplayOrder}",
        "activated" => "Shown to guests",
        "deactivated" => "Hidden from guests",
        _ => entry.EventType,
    };

    private sealed class RenameInputModel
    {
        [Required(ErrorMessage = "Give the section a name.")]
        [StringLength(80, MinimumLength = 1, ErrorMessage = "The name must be 1–80 characters.")]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class DescribeInputModel
    {
        [StringLength(2000, ErrorMessage = "The description must be 2,000 characters or fewer.")]
        public string Description { get; set; } = string.Empty;
    }

    private sealed class ReorderInputModel
    {
        [Range(0, 2147483647, ErrorMessage = "The position must be 0 or greater.")]
        public int DisplayOrder { get; set; }
    }
}
