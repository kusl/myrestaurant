@page "/administration/menu/new"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.Domain.Identifiers
@using MyRestaurant.WebApplication.Menu
@using MyRestaurant.WebApplication.Orders
@inject IMenuWorkflow MenuChanges
@inject IMenuSectionDirectory MenuSections
@inject IIdentifierFactory IdentifierFactory
@inject RestaurantOptions Options

<PageTitle>Create menu item</PageTitle>

@if (_created is { Created: true } created)
{
    <section class="panel account-panel">
        <p class="eyebrow">Menu item created</p>
        <h1>@created.Name is on the menu</h1>

        <p class="status-success" role="status">
            <strong>@created.Name</strong> was created at <strong>@Money(created.PriceAmount ?? 0m)</strong>
            under <strong>@created.MenuSectionName</strong> and is available now. Every open menu has
            already picked it up.
        </p>

        @if (created.DescriptionWasSet)
        {
            <p class="record-note">Description: @created.Description</p>
        }

        <div class="form-actions">
            <a class="button-primary" href="@($"/administration/menu/{created.MenuItemIdentifier}")">Manage this item</a>
            <a class="button-secondary" href="/administration/menu">Back to the menu</a>
        </div>
    </section>
}
else if (_sections is null)
{
    <section class="panel account-panel">
        <p class="record-empty">Loading…</p>
    </section>
}
else if (_sections.Count == 0)
{
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Give the menu a heading first</h1>
        <p class="lede">
            Every menu item sits under a section — Drinks, Starters, Breakfast — because that is how a
            guest reads a menu. There are no sections yet, so there is nowhere to put an item. Make one
            and come straight back; you only ever do this once.
        </p>

        <div class="form-actions">
            <a class="button-primary" href="/administration/menu/sections/new">Create a menu section</a>
            <a class="button-secondary" href="/administration/menu">Back to the menu</a>
        </div>
    </section>
}
else
{
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Create a menu item</h1>
        <p class="lede">
            The name is what guests, the kitchen queue, and the bill all read, so write it the way it
            should appear on a receipt. The section is the heading it appears under, and it goes to the
            end of that heading. The price is in @Options.CurrencyCode and can be zero. The description is
            optional, is one or two sentences a guest reads before ordering — what is in it, how it is
            served, what it comes with — and can be added or changed later.
        </p>

        @if (_errorMessage is not null)
        {
            <p class="status-error" role="alert">@_errorMessage</p>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="create-menu-item">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="Input.Name" autocomplete="off" autofocus />
                <ValidationMessage For="@(() => Input.Name)" />
            </div>

            <div class="form-field">
                <label for="menu-section">Section</label>
                <InputSelect id="menu-section" @bind-Value="Input.MenuSectionIdentifier">
                    @foreach (MenuSectionSummary menuSection in _sections)
                    {
                        <option value="@menuSection.MenuSectionIdentifier">
                            @(menuSection.IsActive
                                ? menuSection.Name
                                : $"{menuSection.Name} (hidden from guests)")
                        </option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Input.MenuSectionIdentifier)" />
            </div>

            <div class="form-field">
                <label for="description">Description <span class="muted">(optional)</span></label>
                <InputTextArea id="description" @bind-Value="Input.Description" rows="3" autocomplete="off" />
                <ValidationMessage For="@(() => Input.Description)" />
            </div>

            <div class="form-field">
                <label for="price">Price (@Options.CurrencyCode)</label>
                <InputNumber id="price" @bind-Value="Input.PriceAmount" step="0.01" min="0" inputmode="decimal" />
                <ValidationMessage For="@(() => Input.PriceAmount)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="button-primary">Create item</button>
                <a class="button-secondary" href="/administration/menu">Cancel</a>
            </div>
        </EditForm>

        <p class="form-footnote">
            Names do not have to be unique — a kitchen running a rotating special will want two rows
            called the same thing eventually. Section names do have to be unique, which is the opposite
            rule for the opposite reason. Prices are stored to two decimals and rounded if you type more.
            You can rename, reprice, describe, reposition, or mark the item unavailable at any time; every
            one of those is recorded with your name against it.
        </p>
    </section>
}

@code {
    private CreateMenuItemResult? _created;
    private IReadOnlyList<MenuSectionSummary>? _sections;
    private string? _errorMessage;

    [SupplyParameterFromForm(FormName = "create-menu-item")]
    private CreateMenuItemInputModel Input { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        _sections = await MenuSections.ListAsync(HttpContext.RequestAborted);

        if (Input.MenuSectionIdentifier == Guid.Empty && _sections.Count > 0)
        {
            Input.MenuSectionIdentifier = _sections[0].MenuSectionIdentifier;
        }
    }

    private async Task CreateAsync()
    {
        if (PersonPrincipal.IdentifierFor(HttpContext.User) is not { } administrator)
        {
            _errorMessage = "Your session could not be identified. Sign in again and retry.";
            return;
        }

        _created = await MenuChanges.CreateMenuItemAsync(
            IdentifierFactory.Create(),
            Input.MenuSectionIdentifier,
            Input.Name.Trim(),
            Input.Description,
            Input.PriceAmount,
            administrator,
            HttpContext.RequestAborted);

        if (_created.Outcome is CreateMenuItemOutcome.MenuSectionNotFound)
        {
            _errorMessage =
                "That section no longer exists. It may have been changed while this page was open —"
                + " reload the page and choose again.";
        }
    }

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    private sealed class CreateMenuItemInputModel
    {
        public Guid MenuSectionIdentifier { get; set; }

        [Required(ErrorMessage = "Give the item a name.")]
        [StringLength(120, MinimumLength = 1, ErrorMessage = "The name must be 1–120 characters.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "The description must be 2,000 characters or fewer.")]
        public string Description { get; set; } = string.Empty;

        [Range(0, 99999999.99, ErrorMessage = "The price must be between 0 and 99,999,999.99.")]
        public decimal PriceAmount { get; set; }
    }
}
