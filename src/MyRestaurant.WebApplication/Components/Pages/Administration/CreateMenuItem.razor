@page "/administration/menu/new"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.Domain.Identifiers
@using MyRestaurant.WebApplication.Menu
@using MyRestaurant.WebApplication.Orders
@inject IMenuWorkflow MenuChanges
@inject IMenuSectionDirectory MenuSections
@inject IIdentifierFactory IdentifierFactory
@inject RestaurantOptions Options

@* Create a menu item (TECHNICAL_SPECIFICATION §7, §11.4). Administrator only (endpoint authorization,
   like every administration surface). Static SSR: a full-page form post. The item is created active, and
   the workflow announces it so every open guest picker and kitchen panel gains it without a reload (§9).
   Nothing is written until the form is submitted; the identifier is minted here so the success screen can
   link straight to the new item's management page — the same shape CreateTable uses.

   THE SECTION PICKER IS REQUIRED, AND THAT IS 0005's NOT NULL ARRIVING AT A FORM. §7: an item under no
   heading is an item nobody decided about. So there is no "(none)" option, no "Uncategorized" default
   and no blank first entry — the select is pre-selected on the first section and every path out of this
   form names one.

   WHEN THERE ARE NO SECTIONS THIS PAGE DOES NOT RENDER A FORM AT ALL. A required picker over an empty
   list is a form nobody can submit and a validation message that blames the person for a menu that has
   no headings yet. The panel below sends them to the section create page instead, which is the one extra
   step §7 accepts on the very first use of a fresh installation. *@

<PageTitle>Create menu item</PageTitle>

@if (_created is { Created: true } created)
{
    <section class="panel account-panel">
        <p class="eyebrow">Menu item created</p>
        <h1>@created.Name is on the menu</h1>

        <p class="status-success" role="status">
            <strong>@created.Name</strong> was created at <strong>@Money(created.PriceAmount ?? 0m)</strong>
            under <strong>@created.MenuSectionName</strong> and is available now. Every open menu has
            already picked it up.
        </p>

        @if (created.DescriptionWasSet)
        {
            @* Echoed from the result rather than re-read, because the write service returns what it
               actually stored — trimmed — and this is the only place a caller can see the difference
               without a second query. *@
            <p class="record-note">Description: @created.Description</p>
        }

        <div class="form-actions">
            <a class="button-primary" href="@($"/administration/menu/{created.MenuItemIdentifier}")">Manage this item</a>
            <a class="button-secondary" href="/administration/menu">Back to the menu</a>
        </div>
    </section>
}
else if (_sections is null)
{
    <section class="panel account-panel">
        <p class="record-empty">Loading…</p>
    </section>
}
else if (_sections.Count == 0)
{
    @* The first-use panel. It is a dead end on purpose: there is no form under it to half-fill, because
       §7's heading is not optional and a form that cannot be submitted is worse than a page that says
       why. *@
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Give the menu a heading first</h1>
        <p class="lede">
            Every menu item sits under a section — Drinks, Starters, Breakfast — because that is how a
            guest reads a menu. There are no sections yet, so there is nowhere to put an item. Make one
            and come straight back; you only ever do this once.
        </p>

        <div class="form-actions">
            <a class="button-primary" href="/administration/menu/sections/new">Create a menu section</a>
            <a class="button-secondary" href="/administration/menu">Back to the menu</a>
        </div>
    </section>
}
else
{
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Create a menu item</h1>
        <p class="lede">
            The name is what guests, the kitchen queue, and the bill all read, so write it the way it
            should appear on a receipt. The section is the heading it appears under, and it goes to the
            end of that heading. The price is in @Options.CurrencyCode and can be zero. The description is
            optional, is one or two sentences a guest reads before ordering — what is in it, how it is
            served, what it comes with — and can be added or changed later.
        </p>

        @if (_errorMessage is not null)
        {
            <p class="status-error" role="alert">@_errorMessage</p>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="create-menu-item">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="Input.Name" autocomplete="off" autofocus />
                <ValidationMessage For="@(() => Input.Name)" />
            </div>

            @* An InputSelect over Guid rather than over a string identifier: Blazor's own converter
               handles Guid, so a malformed post is a binding failure here rather than a Guid.Parse
               somewhere in the handler.

               INACTIVE SECTIONS ARE OFFERED, AND MARKED. §7 hides an inactive heading from the GUEST;
               it does not hide it from §11.4's administrator, whose whole job on this page may be
               stocking next week's breakfast menu before switching it on. The suffix is text inside the
               option because an <option> renders text and nothing else — which is the same limitation
               that made the guest picker a card list, and the reason it is acceptable here is that this
               is a choice among eight headings rather than a menu among sixty dishes. *@
            <div class="form-field">
                <label for="menu-section">Section</label>
                <InputSelect id="menu-section" @bind-Value="Input.MenuSectionIdentifier">
                    @foreach (MenuSectionSummary section in _sections)
                    {
                        <option value="@section.MenuSectionIdentifier">
                            @(section.IsActive ? section.Name : $"{section.Name} (hidden from guests)")
                        </option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Input.MenuSectionIdentifier)" />
            </div>

            @* A textarea rather than an input, and app.css has styled `.form-field textarea` since
               Slice 30 for exactly this field — so this block declares nothing. `.muted` is the shared
               soft-ink class rather than a new one, for the same reason. Deliberately not `required`:
               §7 makes a description optional, and a blank one stores "" and writes no event at all. *@
            <div class="form-field">
                <label for="description">Description <span class="muted">(optional)</span></label>
                <InputTextArea id="description" @bind-Value="Input.Description" rows="3" autocomplete="off" />
                <ValidationMessage For="@(() => Input.Description)" />
            </div>

            <div class="form-field">
                <label for="price">Price (@Options.CurrencyCode)</label>
                <InputNumber id="price" @bind-Value="Input.PriceAmount" step="0.01" min="0" inputmode="decimal" />
                <ValidationMessage For="@(() => Input.PriceAmount)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="button-primary">Create item</button>
                <a class="button-secondary" href="/administration/menu">Cancel</a>
            </div>
        </EditForm>

        <p class="form-footnote">
            Names do not have to be unique — a kitchen running a rotating special will want two rows
            called the same thing eventually. Section names do have to be unique, which is the opposite
            rule for the opposite reason. Prices are stored to two decimals and rounded if you type more.
            You can rename, reprice, describe, reposition, or mark the item unavailable at any time; every
            one of those is recorded with your name against it.
        </p>
    </section>
}

@code {
    private CreateMenuItemResult? _created;
    private IReadOnlyList<MenuSectionSummary>? _sections;
    private string? _errorMessage;

    [SupplyParameterFromForm(FormName = "create-menu-item")]
    private CreateMenuItemInputModel Input { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // BL0008: a form POST binds Input itself and may assign null, so the default lives here.
        Input ??= new();

        _sections = await MenuSections.ListAsync(HttpContext.RequestAborted);

        // Pre-selected rather than left on Guid.Empty. A <select> with no selected option shows its
        // first one and posts that value, so a form that left this at the default would LOOK correct
        // and submit an identifier naming nothing — which the write service would report and the person
        // would read as a bug. Only on the first render: a re-render after a failed post must keep what
        // was chosen.
        if (Input.MenuSectionIdentifier == Guid.Empty && _sections.Count > 0)
        {
            Input.MenuSectionIdentifier = _sections[0].MenuSectionIdentifier;
        }
    }

    private async Task CreateAsync()
    {
        if (PersonPrincipal.IdentifierFor(HttpContext.User) is not { } administrator)
        {
            // Endpoint authorization already guarantees an administrator; this is the belt to that
            // brace, because menu_item_event.actor_person_identifier is NOT NULL and §7 requires every
            // change to name somebody.
            _errorMessage = "Your session could not be identified. Sign in again and retry.";
            return;
        }

        _created = await MenuChanges.CreateMenuItemAsync(
            IdentifierFactory.Create(),
            Input.MenuSectionIdentifier,
            Input.Name.Trim(),
            Input.Description,
            Input.PriceAmount,
            administrator,
            HttpContext.RequestAborted);

        // A section deleted or renamed out from under a form somebody left open. Reported rather than
        // thrown: the outcome exists precisely so this page can say which field was wrong instead of
        // showing a foreign-key constraint name.
        if (_created.Outcome is CreateMenuItemOutcome.MenuSectionNotFound)
        {
            _errorMessage =
                "That section no longer exists. It may have been changed while this page was open —"
                + " reload the page and choose again.";
        }
    }

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    private sealed class CreateMenuItemInputModel
    {
        // No [Required] attribute, and that is deliberate rather than an omission: Guid is a value type,
        // so [Required] passes on Guid.Empty and would assert nothing. The select is pre-selected, has
        // no empty option, and the write service reports an identifier that names nothing — three
        // defences, none of which is a validation attribute that does not work.
        public Guid MenuSectionIdentifier { get; set; }

        [Required(ErrorMessage = "Give the item a name.")]
        [StringLength(120, MinimumLength = 1, ErrorMessage = "The name must be 1–120 characters.")]
        public string Name { get; set; } = string.Empty;

        // No [Required]: §7 makes a description optional and a blank one is stored as "". The 2,000 is
        // this form's own limit rather than the column's — `menu_item.description` is `text` and has none
        // — and it is here rather than in DapperMenuAdministration for the reason that file records: a
        // ceiling invented in the data-access layer would be that layer overruling the schema of record.
        // A form is allowed an opinion about how much prose fits on a menu.
        [StringLength(2000, ErrorMessage = "The description must be 2,000 characters or fewer.")]
        public string Description { get; set; } = string.Empty;

        // The upper bound is numeric(10,2)'s: eight digits before the point. Bounded here so the form
        // says so, and again in DapperMenuAdministration so no other caller can get past it.
        [Range(0, 99999999.99, ErrorMessage = "The price must be between 0 and 99,999,999.99.")]
        public decimal PriceAmount { get; set; }
    }
}
