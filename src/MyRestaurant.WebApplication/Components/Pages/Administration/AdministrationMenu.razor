@page "/administration/menu"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.WebApplication.Orders
@inject IMenuDirectory MenuItems
@inject IMenuEventLog MenuEvents
@inject RestaurantOptions Options
@inject RestaurantTime RestaurantClock

@* The administration menu list (TECHNICAL_SPECIFICATION §7, §11.4, §11.12 — `area.administration`:
   "Menu (CRUD + activity, event history per item)"). It lists every item with its price and
   availability, links each to its management page, offers creation, and shows the recent activity feed
   that answers "what changed today" without opening an item.

   Static SSR, like every administration surface. Deactivated items are listed, not filtered: §7 is
   explicit that an 86'd item stays on the menu marked "currently unavailable", and a page that hid them
   from the administrator would hide exactly the rows somebody is looking for. Ordered by section, then by
   position within it, then by name — which is also why duplicate names, permitted since `menu_item.name`
   carries no UNIQUE constraint, end up adjacent and visible.

   Two record lists (§11.12) and no inline <style>. **Sections arrived in `0005`, and this page shows
   them as a COLUMN rather than as grouped sub-lists.** The plan's Stage 3 describes a sections-first
   index — a record list of headings, each expandable to its items — and that is still the destination;
   what it needs is the section editor to open into, which this slice does not ship. A column is the
   honest intermediate: the fact is visible and sortable-by-eye today, and nothing here has to be undone
   to group it later. §11.4's administrator, unlike §11.1's guest, sees items under inactive headings
   too — a heading switched off is hidden from guests and from nobody else. *@

<PageTitle>Administration — menu</PageTitle>

<section class="panel panel-wide">
    <div class="page-head">
        <div>
            <p class="eyebrow">Administration</p>
            <h1>Menu</h1>
        </div>
        <AdministrationAreaLinks Current="AdministrationArea.Menu" />
    </div>

    <div class="page-head-action">
        <a class="button-primary" href="/administration/menu/new">Create menu item</a>
        <a class="button-secondary" href="/administration/menu/sections/new">Create section</a>
    </div>

    <p class="lede">
        Every menu item, in the order guests see them: by section, then by position within it, then by
        name. Prices here are what the <em>next</em> order line costs — anything already on a bill keeps
        the price it was added at. Open an item to rename it, reprice it, describe it, move it, mark it
        unavailable, or read everything that has ever happened to it.
    </p>

    @if (_items is null)
    {
        <p class="record-empty">Loading…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="record-empty">
            No menu items yet. Every item needs a section to sit under, so make a heading first if there
            is not one — guests cannot order until there is something to order.
        </p>
    }
    else
    {
        <div class="record-list">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Section</th>
                        <th scope="col">Price</th>
                        <th scope="col">Availability</th>
                        <th scope="col">Position</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MenuItemSummary item in _items)
                    {
                        <tr>
                            <td class="record-primary" data-label="">
                                <a class="record-link" href="@ManagePath(item.MenuItemIdentifier)">@item.Name</a>
                                @if (item.Description.Length > 0)
                                {
                                    @* Under the name rather than in a column of its own. A description is
                                       a sentence, and a sentence in a table cell at 375px is the shape
                                       F-59 was about; this way the handheld card reads name-then-sentence
                                       and the wide table reads as a subtitle. *@
                                    <span class="record-secondary">@item.Description</span>
                                }
                            </td>
                            <td data-label="Section">
                                @item.MenuSectionName
                                @if (!item.MenuSectionIsActive)
                                {
                                    @* §7's asymmetry, said out loud on the one page that can see both
                                       sides of it: an inactive ITEM is shown to the guest and marked,
                                       an inactive SECTION is not shown at all. An administrator looking
                                       at an available item that no guest can find deserves to be told
                                       which of the two flags is doing it. *@
                                    <span class="chip chip-warn">Section hidden</span>
                                }
                            </td>
                            <td class="record-numeric" data-label="Price">@Money(item.PriceAmount)</td>
                            <td data-label="">
                                @if (item.IsActive)
                                {
                                    <span class="chip chip-ok">Available</span>
                                }
                                else
                                {
                                    <span class="chip chip-warn">Currently unavailable</span>
                                }
                            </td>
                            <td class="record-numeric" data-label="Position">@item.DisplayOrder</td>
                            <td class="record-actions" data-label="">
                                <a class="button-secondary" href="@ManagePath(item.MenuItemIdentifier)"
                                   aria-label="@($"Manage {item.Name}")">Manage</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="record-note">
            @_activeCount of @_items.Count available, @_describedCount described, across @_sectionCount
            @(_sectionCount == 1 ? "section" : "sections"). An unavailable item stays
            on the guest's menu marked unavailable and cannot be added to a send — it is never hidden and
            never deleted, so past orders keep the item they were placed against. The <em>Created</em>
            column has moved to each item's own page, where the whole history it belongs to lives.
        </p>
    }

    <hr class="record-rule" />

    <h2 class="record-heading">Recent activity</h2>
    <p class="lede">
        The last @RecentActivityCount changes across the whole menu, newest first. Each item's complete
        history is on its own page.
    </p>

    @if (_recent is null)
    {
        <p class="record-empty">Loading…</p>
    }
    else if (_recent.Count == 0)
    {
        <p class="record-empty">Nothing has changed yet.</p>
    }
    else
    {
        <div class="record-list">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Change</th>
                        <th scope="col">When</th>
                        <th scope="col">By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MenuItemEventEntry entry in _recent)
                    {
                        @* @key is on the event identifier rather than the loop index: two events on the
                           same item in the same second are ordered by their UUIDv7 keys (§8.2), and an
                           index would make the second one look like an edit of the first. *@
                        <tr @key="entry.MenuItemEventIdentifier">
                            <td class="record-primary" data-label="">
                                <a class="record-link" href="@ManagePath(entry.MenuItemIdentifier)">@entry.MenuItemName</a>
                            </td>
                            <td data-label="Change">@Describe(entry)</td>
                            <td data-label="When">@RestaurantClock.DateAndTime(entry.OccurredAt)</td>
                            <td data-label="By">@entry.ActorName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p><a href="/administration">Back to administration</a></p>
</section>

@code {
    /// <summary>
    /// Enough to cover a service's worth of 86s without turning the index into the archive. §11.4's
    /// "filters narrow only on explicit request" governs the per-item history, which is uncapped; this
    /// panel is a glance, and its cap is the explicit request.
    /// </summary>
    private const int RecentActivityCount = 20;

    private IReadOnlyList<MenuItemSummary>? _items;
    private IReadOnlyList<MenuItemEventEntry>? _recent;
    private int _activeCount;
    private int _describedCount;
    private int _sectionCount;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _items = await MenuItems.ListAsync(HttpContext.RequestAborted);
        _activeCount = _items.Count(item => item.IsActive);
        _describedCount = _items.Count(item => item.Description.Length > 0);

        // Sections that have something under them, which is not the same number as the section count —
        // an empty heading exists and is not visible here, because this list is built from items. The
        // sentence below says "across N sections" and means exactly that.
        _sectionCount = _items.Select(item => item.MenuSectionIdentifier).Distinct().Count();
        _recent = await MenuEvents.ListRecentAsync(RecentActivityCount, HttpContext.RequestAborted);
    }

    private static string ManagePath(Guid menuItemIdentifier)
        => $"/administration/menu/{menuItemIdentifier}";

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    /// <summary>
    /// A friendly label for each event type §8.2's vocabulary CHECK admits, falling back to the stored
    /// string for anything else — §11.4 renders the record, so an unrecognised type must show as itself
    /// rather than be swallowed. That fallback is what makes `0005`'s `section_changed` readable here
    /// before this method knows its name, and it is why the arms below are deliberately not counted in
    /// prose: this comment said <em>five</em> and named <em>two</em> new types where the plan specified
    /// three, in a sentence nothing in the tree could check (F-77).
    ///
    /// <para>This feed is a glance rather than an audit, so a `description_changed` says that a
    /// description moved without quoting it — the sentence belongs on the item's own page, where the
    /// uncapped history renders it in full.</para>
    /// </summary>
    private string Describe(MenuItemEventEntry entry) => entry.EventType switch
    {
        "created" => $"Created at {Money(entry.NewPriceAmount ?? 0m)}",
        "name_changed" => $"Renamed to {entry.NewName}",
        "price_changed" => $"Repriced to {Money(entry.NewPriceAmount ?? 0m)}",
        "description_changed" => (entry.NewDescription ?? string.Empty).Length == 0
            ? "Description cleared"
            : "Description changed",
        "section_changed" => $"Filed under {entry.NewMenuSectionName}",
        "reordered" => $"Moved to position {entry.NewDisplayOrder}",
        "activated" => "Marked available",
        "deactivated" => "Marked unavailable",
        _ => entry.EventType,
    };
}
