@page "/administration/tables"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Tables
@inject ITableDirectory Tables
@inject RestaurantTime RestaurantClock

@* The administration tables list (TECHNICAL_SPECIFICATION §4.1, §11.4, §11.12 — `area.administration`).
   It lists every table with its status and when its join secret was last rotated, links each to its
   management page, and offers table creation. Static SSR, like every administration surface, so the
   management pages it links can post full pages. Endpoint authorization enforces the policy on the
   server (anonymous → /sign-in, signed-in non-administrator → /access-denied). Not exempt from the
   obligations pipeline. Join secrets are never read or shown here (§4.1).

   The markup is the shared §11.12 record list and there is no inline <style> block; the table label is
   itself the link, and the row's action is the foot of its card rather than a right-hand column. This
   page is the one F-59 was reported against: an operator standing at a table, on a phone, scrolling
   sideways to reach Manage. *@

<PageTitle>Administration — tables</PageTitle>

<section class="panel panel-wide">
    <div class="page-head">
        <div>
            <p class="eyebrow">Administration</p>
            <h1>Tables</h1>
        </div>
        <AdministrationAreaLinks Current="AdministrationArea.Tables" />
    </div>

    <div class="page-head-action">
        <a class="button-primary" href="/administration/tables/new">Create table</a>
    </div>

    <p class="lede">
        Every table, oldest first. Each has a private join secret used to sign the rotating QR codes
        guests scan; the secret is never shown. Open a table to rename it, rotate its secret, or
        deactivate it.
    </p>

    @if (_tables is null)
    {
        <p class="record-empty">Loading…</p>
    }
    else if (_tables.Count == 0)
    {
        <p class="record-empty">No tables yet. Create the first one to start pairing displays and taking orders.</p>
    }
    else
    {
        <div class="record-list">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Label</th>
                        <th scope="col">Status</th>
                        <th scope="col">Join secret rotated</th>
                        <th scope="col">Created</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (RestaurantTableSummary table in _tables)
                    {
                        <tr>
                            <td class="record-primary" data-label="">
                                <a class="record-link" href="@ManagePath(table)">@table.Label</a>
                            </td>
                            <td data-label="">
                                @if (table.IsActive)
                                {
                                    <span class="chip chip-ok">Active</span>
                                }
                                else
                                {
                                    <span class="chip chip-warn">Deactivated</span>
                                }
                            </td>
                            <td data-label="Join secret rotated">
                                @if (table.JoinSecretRotatedAt is { } rotatedAt)
                                {
                                    <span>@RestaurantClock.DateAndTime(rotatedAt)</span>
                                }
                                else
                                {
                                    <span class="muted">Never</span>
                                }
                            </td>
                            <td data-label="Created">@RestaurantClock.DateAndTime(table.CreatedAt)</td>
                            <td class="record-actions" data-label="">
                                <a class="button-secondary" href="@ManagePath(table)"
                                   aria-label="@($"Manage {table.Label}")">Manage</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="record-note">
            @_activeCount of @_tables.Count @(_tables.Count == 1 ? "table" : "tables") active.
        </p>
    }

    <p class="form-footnote">
        Deactivating a table stops its join tokens validating and its display rendering; nothing is
        deleted, so past sittings and orders keep their table. Rotating a join secret invalidates every
        outstanding QR for that table immediately.
    </p>

    <p><a href="/administration">Back to administration</a></p>
</section>

@code {
    private IReadOnlyList<RestaurantTableSummary>? _tables;
    private int _activeCount;

    protected override async Task OnInitializedAsync()
    {
        _tables = await Tables.ListTablesAsync();
        _activeCount = _tables.Count(table => table.IsActive);
    }

    private static string ManagePath(RestaurantTableSummary table)
        => $"/administration/tables/{table.TableIdentifier}";
}
