@page "/administration/events"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@using MyRestaurant.DataAccess.Events
@using MyRestaurant.WebApplication.Events
@using MyRestaurant.WebApplication.Orders
@inject IEventExplorerReads Explorer
@inject RestaurantOptions Options
@inject RestaurantTime RestaurantClock

<PageTitle>Administration — events</PageTitle>

<section class="panel panel-wide">
    <div class="page-head">
        <div>
            <p class="eyebrow">Administration</p>
            <h1>Events</h1>
        </div>
        <AdministrationAreaLinks Current="AdministrationArea.Events" />
    </div>

    <p class="lede">
        Everything the three append-only logs have recorded, newest first: sign-ins, resets, grants and
        lockouts; every send, edit, reprice and delivery on every order; every menu item created, renamed,
        repriced or 86'd. Nothing here can be changed from here — each row links to the screen that owns
        what it is about.
    </p>

    @foreach (string problem in _query.Problems)
    {
        <p class="status-error" role="alert">@problem</p>
    }

    <form class="filter-form" method="get" action="@EventExplorerQuery.BasePath">
        <fieldset class="filter-fieldset">
            <legend>Streams</legend>

            <div class="filter-choices">
                <label class="filter-choice">
                    <input type="checkbox" name="@EventExplorerQuery.StreamField"
                           value="@EventStream.Security" checked="@_query.IncludeSecurityEvents" />
                    Security
                </label>

                <label class="filter-choice">
                    <input type="checkbox" name="@EventExplorerQuery.StreamField"
                           value="@EventStream.Order" checked="@_query.IncludeOrderEvents" />
                    Orders
                </label>

                <label class="filter-choice">
                    <input type="checkbox" name="@EventExplorerQuery.StreamField"
                           value="@EventStream.Menu" checked="@_query.IncludeMenuEvents" />
                    Menu
                </label>
            </div>
        </fieldset>

        <div class="form-field">
            <label for="filter-subject">Subject</label>
            <input id="filter-subject" name="@EventExplorerQuery.SubjectField" type="search"
                   autocomplete="off" value="@_query.Subject" placeholder="person, table or item" />
        </div>

        <div class="form-field">
            <label for="filter-actor">Actor</label>
            <input id="filter-actor" name="@EventExplorerQuery.ActorField" type="search"
                   autocomplete="off" value="@_query.Actor" placeholder="who did it" />
        </div>

        <div class="form-field">
            <label for="filter-type">Type</label>
            <select id="filter-type" name="@EventExplorerQuery.TypeField">
                <option value="">Any type</option>

                <optgroup label="Security">
                    @foreach (string eventType in EventTypeCatalogue.SecurityEventTypes)
                    {
                        <option value="@eventType" selected="@(_query.EventType == eventType)">
                            @DescribeSecurityEventType(eventType)
                        </option>
                    }
                </optgroup>

                <optgroup label="Orders">
                    @foreach (string eventType in EventTypeCatalogue.OrderEventTypes)
                    {
                        <option value="@eventType" selected="@(_query.EventType == eventType)">
                            @DescribeOrderEventType(eventType)
                        </option>
                    }
                </optgroup>

                <optgroup label="Menu">
                    @foreach (string eventType in EventTypeCatalogue.MenuEventTypes)
                    {
                        <option value="@eventType" selected="@(_query.EventType == eventType)">
                            @DescribeMenuEventType(eventType)
                        </option>
                    }
                </optgroup>
            </select>
        </div>

        <div class="form-field">
            <label for="filter-from">On or after</label>
            <input id="filter-from" name="@EventExplorerQuery.FromField" type="date" value="@_query.From" />
        </div>

        <div class="form-field">
            <label for="filter-to">On or before</label>
            <input id="filter-to" name="@EventExplorerQuery.ToField" type="date" value="@_query.To" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="button-primary">Narrow the list</button>
            @if (_query.IsNarrowed)
            {
                <a class="button-secondary" href="@EventExplorerQuery.BasePath">Show everything</a>
            }
        </div>
    </form>

    @if (_events is null)
    {
        <p class="record-empty">Loading…</p>
    }
    else if (_events.Count == 0)
    {
        <p class="record-empty">
            @(_query.IsNarrowed
                ? "Nothing matches that. Widen the filter, or show everything."
                : "Nothing has happened yet — no sign-ins, no orders, no menu changes.")
        </p>
    }
    else
    {
        <p class="filter-count">@CountSentence(_events.Count)</p>

        <ol class="event-list">
            @foreach (ExplorerEvent entry in _events)
            {
                <li class="event-row">
                    <p class="event-headline">
                        <a class="event-stream-badge event-stream-@entry.Stream"
                           href="@OnlyThisStreamPath(entry)"
                           title="Show only this stream">@StreamLabel(entry.Stream)</a>
                        <span class="event-type">@DescribeEvent(entry)</span>
                        <time class="event-when" datetime="@RestaurantClock.MachineReadable(entry.OccurredAt)">
                            @RestaurantClock.DateAndTimeWithSeconds(entry.OccurredAt)
                        </time>
                    </p>

                    <p class="event-meta">
                        @if (SubjectPath(entry) is { } subjectPath)
                        {
                            <a href="@subjectPath">@entry.SubjectLabel</a>
                        }
                        else
                        {
                            <span>@entry.SubjectLabel</span>
                        }

                        @if (entry.SubjectDetail is { Length: > 0 } subjectDetail)
                        {
                            <text> · </text><span class="event-subject-detail">@subjectDetail</span>
                        }

                        @if (entry.SequenceNumber is { } sequenceNumber)
                        {
                            <text> · event #@sequenceNumber</text>
                        }

                        <span class="event-separator">·</span>
                        <a class="event-narrow" href="@_query.PathWithSubject(entry.SubjectLabel)">
                            only this subject
                        </a>
                    </p>

                    <p class="event-meta">
                        @if (entry.ActorName is { Length: > 0 } actorName)
                        {
                            <text>by </text>
                            <a href="@_query.PathWithActor(actorName)">@actorName</a>

                            @if (entry.ActorRole is { Length: > 0 } actorRole)
                            {
                                <text> as @DescribeActorRole(actorRole)</text>
                            }
                        }
                        else
                        {
                            <span class="event-muted">
                                no actor recorded — the subject acted on themselves, or the system did
                            </span>
                        }
                    </p>

                    @if (entry.NewName is { Length: > 0 } newName)
                    {
                        <p class="event-payload">Name set to <strong>@newName</strong></p>
                    }

                    @if (entry.NewPriceAmount is { } newPrice)
                    {
                        <p class="event-payload">Price set to <strong>@Money(newPrice)</strong></p>
                    }
                </li>
            }
        </ol>
    }

    <p><a href="/administration">Back to people</a></p>
</section>

<style>
    .event-list {
        list-style: none;
        margin: 0.5rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
    }

    .event-row {
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--hairline);
        border-radius: 0.5rem;
    }

    .event-headline {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 0.6rem;
        align-items: baseline;
        margin: 0;
    }

    .event-stream-badge {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        padding: 0.1rem 0.4rem;
        border-radius: 0.25rem;
        text-decoration: none;
        color: var(--ink);
        background: var(--chip-surface);
    }

    .event-stream-security {
        background: var(--danger-surface);
    }

    .event-stream-order {
        background: var(--accent-surface);
    }

    .event-stream-menu {
        background: var(--caution-surface);
    }

    .event-type {
        font-weight: 600;
    }

    .event-when {
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
        color: var(--ink-soft);
    }

    .event-meta {
        margin: 0.2rem 0 0;
        font-size: 0.85rem;
        color: var(--ink-soft);
    }

    .event-subject-detail {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .event-separator {
        margin: 0 0.15rem;
        color: var(--ink-soft);
    }

    .event-narrow {
        font-size: 0.8rem;
    }

    .event-payload {
        margin: 0.2rem 0 0;
        font-size: 0.85rem;
        font-variant-numeric: tabular-nums;
    }

    .event-muted {
        font-style: italic;
    }
</style>

@code {
    private const int ListCap = 200;

    private EventExplorerQuery _query = default!;
    private IReadOnlyList<ExplorerEvent>? _events;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = EventExplorerQuery.StreamField)]
    private string[]? Streams { get; set; }

    [SupplyParameterFromQuery(Name = EventExplorerQuery.SubjectField)]
    private string? Subject { get; set; }

    [SupplyParameterFromQuery(Name = EventExplorerQuery.ActorField)]
    private string? Actor { get; set; }

    [SupplyParameterFromQuery(Name = EventExplorerQuery.TypeField)]
    private string? EventTypeChoice { get; set; }

    [SupplyParameterFromQuery(Name = EventExplorerQuery.FromField)]
    private string? From { get; set; }

    [SupplyParameterFromQuery(Name = EventExplorerQuery.ToField)]
    private string? To { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _query = EventExplorerQuery.Parse(
            Streams, Subject, Actor, EventTypeChoice, From, To, RestaurantClock);

        _events = await Explorer.ListAsync(_query.Filter, ListCap, HttpContext.RequestAborted);
    }

    private string CountSentence(int count)
    {
        string noun = count == 1 ? "event" : "events";
        string scope = _query.IsNarrowed ? "matching the filter" : "in total";

        return count == ListCap
            ? $"{count} {noun} {scope} — capped at {ListCap}; narrow the filter to see past it."
            : $"{count} {noun} {scope}.";
    }

    private string OnlyThisStreamPath(ExplorerEvent entry) => _query.PathWithStreams(
        entry.Stream == EventStream.Security,
        entry.Stream == EventStream.Order,
        entry.Stream == EventStream.Menu);

    private static string? SubjectPath(ExplorerEvent entry) => entry.Stream switch
    {
        EventStream.Security => $"/administration/people/{entry.SubjectIdentifier}",
        EventStream.Menu => $"/administration/menu/{entry.SubjectIdentifier}",
        EventStream.Order => entry.ContextIdentifier is { } sittingIdentifier
            ? $"/administration/sittings/{sittingIdentifier}"
            : null,
        _ => null,
    };

    private static string StreamLabel(string stream) => stream switch
    {
        EventStream.Security => "Security",
        EventStream.Order => "Order",
        EventStream.Menu => "Menu",
        _ => stream,
    };

    private static string DescribeEvent(ExplorerEvent entry) => entry.Stream switch
    {
        EventStream.Security => DescribeSecurityEventType(entry.EventType),
        EventStream.Order => DescribeOrderEventType(entry.EventType),
        EventStream.Menu => DescribeMenuEventType(entry.EventType),
        _ => entry.EventType,
    };

    private static string DescribeSecurityEventType(string eventType) => eventType switch
    {
        "account_created" => "Account created",
        "account_deactivated" => "Account deactivated",
        "account_reactivated" => "Account reactivated",
        "password_changed" => "Password changed",
        "password_reset_by_administrator" => "Password reset by an administrator",
        "forced_password_change_completed" => "Forced password change completed",
        "totp_enrolled" => "Authenticator enrolled",
        "totp_removed" => "Authenticator removed",
        "totp_cleared_by_administrator" => "Authenticator cleared by an administrator",
        "forced_totp_enrollment_completed" => "Forced authenticator enrollment completed",
        "recovery_code_used" => "Recovery code used",
        "recovery_codes_regenerated" => "Recovery codes regenerated",
        "passkey_registered" => "Passkey registered",
        "passkey_removed" => "Passkey removed",
        "role_granted" => "Role granted",
        "role_revoked" => "Role revoked",
        "sign_in_succeeded" => "Signed in",
        "sign_in_failed" => "Sign-in failed",
        "account_locked_out" => "Account locked out",
        _ => eventType,
    };

    private static string DescribeOrderEventType(string eventType) => eventType switch
    {
        "guest_submission" => "Guest send",
        "staff_edit" => "Staff edit",
        "price_adjustment" => "Price change",
        "fulfillment" => "Delivered",
        "fulfillment_reversal" => "Delivery undone",
        _ => eventType,
    };

    private static string DescribeMenuEventType(string eventType) => eventType switch
    {
        "created" => "Item created",
        "name_changed" => "Renamed",
        "price_changed" => "Repriced",
        "activated" => "Back on the menu",
        "deactivated" => "Off the menu (86'd)",
        _ => eventType,
    };

    private static string DescribeActorRole(string actorRole) => actorRole switch
    {
        "guest" => "a guest",
        "kitchen" => "the kitchen",
        "counter" => "the counter",
        "administrator" => "an administrator",
        _ => actorRole,
    };

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);
}
