@page "/administration/tables/{TableId:guid}/displays"
@using MyRestaurant.DataAccess.Displays
@using MyRestaurant.DataAccess.Tables
@using MyRestaurant.WebApplication.Displays
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Administration)]
@inject ITableDirectory TableDirectory
@inject IDisplayDeviceDirectory DisplayDevices
@inject IDisplayDevicePairing Pairing
@inject RestaurantOptions Options
@inject NavigationManager Navigation
@inject RestaurantTime RestaurantClock

<PageTitle>@(_table is null ? "Display devices" : $"Displays — {_table.Label}")</PageTitle>

@if (_table is null)
{
    <section class="panel account-panel">
        <p class="eyebrow">Administration</p>
        <h1>Table not found</h1>
        <p class="lede">No table exists with that identifier. It may have never existed, or the link is stale.</p>
        <p><a href="/administration/tables">Back to tables</a></p>
    </section>
}
else
{
    <section class="panel panel-wide">
        <div class="page-head">
            <div>
                <p class="eyebrow">Administration — display devices</p>
                <h1>@_table.Label</h1>
            </div>
            @if (_table.IsActive)
            {
                <div class="page-head-action">
                    <form method="post" @formname="display-generate-code" @onsubmit="GenerateCodeAsync">
                        <AntiforgeryToken />
                        <button type="submit" class="button-primary">Generate pairing code</button>
                    </form>
                </div>
            }
        </div>

        @if (_flashMessage is not null)
        {
            <p class="status-success" role="status">@_flashMessage</p>
        }
        @if (_errorMessage is not null)
        {
            <p class="status-error" role="alert">@_errorMessage</p>
        }

        @if (_issuedCode is not null)
        {
            <div class="pairing-issued">
                <p class="pairing-issued-label">Enter this on the display, at <code>@PairingUrl</code></p>
                <p class="pairing-code">@_issuedCode</p>
                <p class="form-footnote">
                    Shown once — it is stored hashed, so it cannot be read back. Works once, and expires
                    @if (_issuedExpiresAt is { } expiresAt)
                    {
                        <text>at <strong>@RestaurantClock.TimeWithSeconds(expiresAt)</strong>.</text>
                    }
                    else
                    {
                        <text>shortly.</text>
                    }
                </p>
            </div>
        }

        @if (_table.IsActive)
        {
            <p class="lede">
                Generate a one-time code with the button above, then open <code>@PairingUrl</code> on the
                tablet and type it in. Codes last @Options.TableDisplayPairingCodeMinutes
                minute@(Options.TableDisplayPairingCodeMinutes == 1 ? "" : "s"), work once, and the
                pairing page is rate-limited to @DisplayRoutes.PairingAttemptsPerWindow attempts a minute
                per device.
            </p>
        }
        else
        {
            <p class="lede">
                This table is deactivated, so it takes no new displays and renders no join code.
                Reactivate it first.
            </p>
        }

        <hr class="manage-rule" />

        <h2 class="manage-heading">Paired displays</h2>
        @if (_devices.Count == 0)
        {
            <p class="record-empty">No display has ever been paired to this table.</p>
        }
        else
        {
            <div class="record-list">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Display</th>
                            <th scope="col">Status</th>
                            <th scope="col">Paired</th>
                            <th scope="col">Last seen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (TableDisplayDeviceSummary device in _devices)
                        {
                            <tr @key="device.DeviceIdentifier">
                                <td class="record-primary" data-label="">@device.DeviceLabel</td>
                                <td data-label="">
                                    @if (device.IsRevoked)
                                    {
                                        <span class="chip chip-warn">Revoked</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-ok">Live</span>
                                    }
                                </td>
                                <td data-label="Paired">
                                    @RestaurantClock.DateAndTime(device.PairedAt)
                                    <span class="record-secondary">by @device.PairedByUsername</span>
                                </td>
                                <td data-label="Last seen">
                                    @if (device.IsRevoked && device.RevokedAt is { } revokedAt)
                                    {
                                        <span class="record-secondary">
                                            revoked @RestaurantClock.DateAndTime(revokedAt)
                                            @if (device.RevokedByUsername is { } revokedBy)
                                            {
                                                <text> by @revokedBy</text>
                                            }
                                        </span>
                                    }
                                    else if (device.LastSeenAt is { } lastSeenAt)
                                    {
                                        <span>@RestaurantClock.DateAndTime(lastSeenAt)</span>
                                    }
                                    else
                                    {
                                        <span class="record-secondary">Never</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_revocableDevices.Count > 0)
            {
                <h2 class="manage-heading">Revoke a display</h2>

                <EditForm Model="RevokeInput" method="post" OnValidSubmit="RevokeDeviceAsync"
                          FormName="display-revoke" class="manage-inline-form">
                    <label class="visually-hidden" for="revoke-display">Display to revoke</label>
                    <InputSelect id="revoke-display" @bind-Value="RevokeInput.DeviceIdentifier">
                        <option value="">Choose a display…</option>
                        @foreach (TableDisplayDeviceSummary device in _revocableDevices)
                        {
                            <option value="@device.DeviceIdentifier">@device.DeviceLabel</option>
                        }
                    </InputSelect>
                    <button type="submit" class="link-button danger">Revoke display</button>
                </EditForm>

                <p class="form-footnote">
                    Revoking kills the credential on the device's next request or circuit revalidation.
                    Nothing is deleted, so the record of which screen showed this table stays. If a
                    display walked away, consider rotating the join secret too — every in-flight QR dies
                    instantly and the replacement picks up the new sequence on its next window.
                </p>
            }
        }

        <p class="manage-back"><a href="@ManagePath">Back to @_table.Label</a></p>
    </section>
}

<style>
    .pairing-issued {
        margin: 1rem 0;
        padding: 1rem;
        border: 1px solid var(--hairline);
        border-radius: 0.6rem;
        background-color: var(--surface);
        text-align: center;
    }

    .pairing-issued-label {
        margin: 0;
        font-size: 0.85rem;
        color: var(--ink-soft);
    }

    .pairing-code {
        margin: 0.35rem 0 0.5rem;
        font-family: var(--font-monospace);
        font-size: clamp(1.75rem, 6vw, 2.5rem);
        font-weight: 700;
        letter-spacing: 0.22em;
    }
</style>

@code {
    private RestaurantTableSummary? _table;
    private IReadOnlyList<TableDisplayDeviceSummary> _devices = [];
    private IReadOnlyList<TableDisplayDeviceSummary> _revocableDevices = [];
    private string? _issuedCode;
    private DateTimeOffset? _issuedExpiresAt;
    private string? _flashMessage;
    private string? _errorMessage;

    [Parameter]
    public Guid TableId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "display-revoke")]
    private RevokeInputModel RevokeInput { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Done { get; set; }

    private string ManagePath => $"/administration/tables/{TableId}";

    private string DisplaysPath => $"/administration/tables/{TableId}/displays";

    private string PairingUrl => $"{Options.PublicOrigin.TrimEnd('/')}{DisplayRoutes.Pair}";

    protected override async Task OnInitializedAsync()
    {
        RevokeInput ??= new();

        _table = await TableDirectory.GetTableAsync(TableId, HttpContext.RequestAborted);
        if (_table is null)
        {
            return;
        }

        await LoadDevicesAsync();

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            _flashMessage = FlashFor(Done);
        }
    }

    private async Task LoadDevicesAsync()
    {
        _devices = await DisplayDevices.ListDevicesForTableAsync(TableId, HttpContext.RequestAborted);
        _revocableDevices = _devices.Where(device => !device.IsRevoked).ToArray();
    }

    private async Task GenerateCodeAsync()
    {
        if (_table is null)
        {
            Navigation.NavigateTo("/administration/tables");
            return;
        }

        if (PersonPrincipal.IdentifierFor(HttpContext.User) is not { } administrator)
        {
            _errorMessage = "Your session could not be identified. Sign in again and retry.";
            return;
        }

        IssuePairingCodeResult result = await Pairing.IssuePairingCodeAsync(
            TableId,
            administrator,
            TimeSpan.FromMinutes(Options.TableDisplayPairingCodeMinutes),
            HttpContext.RequestAborted);

        if (result.Outcome == IssuePairingCodeOutcome.Issued)
        {
            _issuedCode = result.Code;
            _issuedExpiresAt = result.ExpiresAt;
            return;
        }

        _errorMessage = "This table is deactivated, so it cannot take a new display. Reactivate it first.";
    }

    private async Task RevokeDeviceAsync()
    {
        if (_table is null)
        {
            Navigation.NavigateTo("/administration/tables");
            return;
        }

        if (!Guid.TryParse(RevokeInput.DeviceIdentifier, out Guid deviceIdentifier))
        {
            _errorMessage = "Choose which display to revoke.";
            return;
        }

        if (PersonPrincipal.IdentifierFor(HttpContext.User) is not { } administrator)
        {
            _errorMessage = "Your session could not be identified. Sign in again and retry.";
            return;
        }

        RevokeDisplayDeviceOutcome outcome = await Pairing.RevokeDeviceAsync(
            deviceIdentifier, administrator, HttpContext.RequestAborted);

        switch (outcome)
        {
            case RevokeDisplayDeviceOutcome.Revoked:
                Navigation.NavigateTo($"{DisplaysPath}?done=revoked");
                break;
            case RevokeDisplayDeviceOutcome.AlreadyRevoked:
                Navigation.NavigateTo($"{DisplaysPath}?done=already-revoked");
                break;
            case RevokeDisplayDeviceOutcome.DeviceNotFound:
                _errorMessage = "That display no longer exists.";
                await LoadDevicesAsync();
                break;
        }
    }

    private static string? FlashFor(string? outcome) => outcome switch
    {
        "revoked" => "Display revoked. Its credential stops working on the device's next request.",
        "already-revoked" => "That display had already been revoked — nothing changed.",
        _ => null,
    };

    private sealed class RevokeInputModel
    {
        [Required(ErrorMessage = "Choose which display to revoke.")]
        public string DeviceIdentifier { get; set; } = string.Empty;
    }
}
