@page "/display/pair"
@using Microsoft.AspNetCore.RateLimiting
@using MyRestaurant.DataAccess.Displays
@using MyRestaurant.WebApplication.Displays
@using MyRestaurant.WebApplication.Security
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(RateLimitedSurfaces.PairingPolicy)]
@layout DisplayLayout
@inject IDisplayDevicePairing Pairing
@inject RestaurantOptions Options
@inject NavigationManager Navigation

<PageTitle>Pair this display</PageTitle>

<section class="display-card">
    <p class="display-eyebrow">@Options.RestaurantName</p>

    @if (_pairedTable is { } pairedTable)
    {
        <h1>This display is paired</h1>
        <p class="display-lede">
            It is already showing <strong>@(_pairedTableLabel ?? "a table")</strong>. There is nothing to
            do here — open the display, or ask an administrator to revoke this device first if it needs
            to move to another table.
        </p>
        <div class="form-actions display-actions">
            <a class="button-primary" href="@DisplayRoutes.ForTable(pairedTable)">Open the display</a>
        </div>
    }
    else
    {
        <h1>Pair this display</h1>

        @if (_wasDisconnected)
        {
            <p class="status-error" role="alert">
                This display was disconnected. Ask an administrator for a new pairing code to bring it
                back.
            </p>
        }

        <p class="display-lede">
            An administrator generates a one-time code from Administration → Tables → the table →
            <strong>Display devices</strong>. Type it in below. Codes last
            @Options.TableDisplayPairingCodeMinutes
            minute@(Options.TableDisplayPairingCodeMinutes == 1 ? "" : "s") and work once.
        </p>

        @if (_errorMessage is not null)
        {
            <p class="status-error" role="alert">@_errorMessage</p>
        }

        <EditForm Model="PairInput" method="post" OnValidSubmit="PairAsync" FormName="display-pair" class="display-form">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="pairing-code">Pairing code</label>
                <InputText id="pairing-code" class="pairing-code-input" @bind-Value="PairInput.Code"
                           autocomplete="off" autocapitalize="characters" autocorrect="off"
                           spellcheck="false" inputmode="text" maxlength="32" />
                <ValidationMessage For="@(() => PairInput.Code)" />
            </div>

            <div class="form-field">
                <label for="device-label">Name this display <span class="optional">(optional)</span></label>
                <InputText id="device-label" @bind-Value="PairInput.DeviceLabel"
                           placeholder="Window tablet" autocomplete="off" maxlength="120" />
                <ValidationMessage For="@(() => PairInput.DeviceLabel)" />
            </div>

            <div class="form-actions display-actions">
                <button type="submit" class="button-primary">Pair this display</button>
            </div>
        </EditForm>

        <p class="form-footnote">
            Pairing stores a long-lived credential on this device. If the tablet is lost or replaced, an
            administrator revokes it and the credential dies on its next request — the table's join
            secret never leaves the server, so the screen itself holds nothing worth taking.
        </p>
    }
</section>

<style>
    .display-form {
        margin: 1.25rem auto 0;
        max-width: 24rem;
        text-align: left;
    }

    .display-actions {
        justify-content: center;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .pairing-code-input {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 1.5rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }
</style>

@code {
    private string? _errorMessage;
    private bool _wasDisconnected;
    private Guid? _pairedTable;
    private string? _pairedTableLabel;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "display-pair")]
    private PairInputModel PairInput { get; set; } = default!;

    protected override void OnInitialized()
    {
        PairInput ??= new();

        _pairedTable = DisplayDevicePrincipal.TableIdentifierFor(HttpContext.User);
        _pairedTableLabel = DisplayDevicePrincipal.TableLabelFor(HttpContext.User);
        _wasDisconnected = _pairedTable is null && DisplayDeviceCookie.WasPresented(HttpContext.Request);
    }

    private async Task PairAsync()
    {
        RedeemPairingCodeResult result = await Pairing.RedeemPairingCodeAsync(
            PairInput.Code, PairInput.DeviceLabel, HttpContext.RequestAborted);

        if (result.Outcome == RedeemPairingCodeOutcome.Paired
            && result.DeviceIdentifier is { } device
            && result.TableIdentifier is { } table
            && result.DeviceSecret is { } secret)
        {
            DisplayDeviceCookie.Write(HttpContext.Response, device, secret);
            Navigation.NavigateTo(DisplayRoutes.ForTable(table));
            return;
        }

        _errorMessage = "That code was not recognised. Codes work once and expire quickly — ask for a "
            + "fresh one and try again.";
    }

    private sealed class PairInputModel
    {
        [Required(ErrorMessage = "Enter the pairing code.")]
        [StringLength(32, MinimumLength = 8, ErrorMessage = "A pairing code is 8 characters.")]
        public string Code { get; set; } = string.Empty;

        [StringLength(120, ErrorMessage = "Keep the name under 120 characters.")]
        public string? DeviceLabel { get; set; }
    }
}
