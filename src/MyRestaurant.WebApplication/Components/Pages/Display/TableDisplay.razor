@page "/display/{TableId:guid}"
@using MyRestaurant.DataAccess.Displays
@using MyRestaurant.DataAccess.Sittings
@using MyRestaurant.Domain.LiveUpdates
@using MyRestaurant.Domain.Time
@using MyRestaurant.WebApplication.Displays
@using MyRestaurant.WebApplication.Tables
@layout DisplayLayout
@implements IDisposable
@inject IDisplayDeviceAuthenticator Devices
@inject ITableJoinTokens JoinTokens
@inject ISittingDirectory Sittings
@inject IDomainEventBroadcaster Broadcaster
@inject IClock Clock
@inject RestaurantOptions Options
@inject NavigationManager Navigation
@inject ILogger<TableDisplay> Logger

@* The table display surface (TECHNICAL_SPECIFICATION §4.3, §11.5).

   Interactive server, unlike every other cookie-adjacent page here, because §11.5 asks for three live
   things: a QR that re-renders on the rotation boundary, a party-size chip fed by SittingMemberJoined,
   and a connection state that must never let a frozen code masquerade as a fresh one.

   ANONYMOUS at the endpoint, gated in the component. §11.5 says an unpaired device is *redirected* to
   /display/pair, and [Authorize] cannot produce that: a failed policy challenges the default scheme and
   lands the screen on /sign-in, which is meaningless for a tablet. The device principal itself is
   installed by DisplayDeviceAuthenticationMiddleware and reaches the circuit through the cascading
   authentication state, so the gate below is reading a server-set principal, never anything the browser
   claimed. §3.7's "table claim matches {table}" is a comparison against a route value, which likewise
   belongs in the surface — the same place §3.7 already leaves /table's per-sitting membership check.

   Rotation is continuous and independent of sitting state (§4.3), so the timer runs whether or not the
   table has anyone at it. Deactivating the table stops rendering (§4.1) without unpairing the device.

   Everything §11.5 asks for beyond the first paint depends on interactivity actually arriving. If
   /_framework/blazor.web.js cannot be fetched, this page is prerendered HTML and nothing else: the code
   painted at page load stays on the glass indefinitely, looking exactly like a live one. That is why the
   surface publishes data-live (see IsLiveAttributeValue) and why Program.cs asks for the build-time
   static web assets manifest outside Development. *@

<PageTitle>@PageTitleText</PageTitle>

@if (_stage == DisplayStage.WrongTable && _deviceTable is { } ownTable)
{
    <section class="display-card">
        <p class="display-eyebrow">@Options.RestaurantName</p>
        <h1>Wrong table</h1>
        <p class="display-lede">
            This display is paired to <strong>@(_deviceTableLabel ?? "another table")</strong>, so it will
            not show a join code for this one. Open its own table, or ask an administrator to revoke and
            re-pair it.
        </p>
        <div class="display-actions">
            <a class="button-primary" href="@DisplayRoutes.ForTable(ownTable)">Open @(_deviceTableLabel ?? "its table")</a>
        </div>
    </section>
}
else if (_stage == DisplayStage.NotPaired)
{
    <section class="display-card">
        <p class="display-eyebrow">@Options.RestaurantName</p>
        <h1>This display is not paired</h1>
        <p class="display-lede">
            Ask an administrator for a pairing code, then enter it on the pairing screen.
        </p>
        <div class="display-actions">
            <a class="button-primary" href="@DisplayRoutes.Pair">Go to pairing</a>
        </div>
    </section>
}
else if (_stage == DisplayStage.TableOutOfService)
{
    <section class="display-card">
        <p class="display-eyebrow">@Options.RestaurantName</p>
        <h1>@_tableLabel</h1>
        <p class="display-lede">
            This table is out of service, so it is not showing a join code. Please speak to the counter.
        </p>
    </section>
}
else if (_qr is not null)
{
    @* data-refresh-token / data-fresh-for-ms drive js/display.js: it measures the deadline from when it
       observes the token change, so a kiosk with a badly wrong clock still detects a dead circuit.
       data-live says whether a circuit produced this markup at all — see IsLiveAttributeValue. *@
    <section class="display-card display-surface" id="table-display-surface"
             data-refresh-token="@_refreshSequence" data-fresh-for-ms="@FreshForMilliseconds"
             data-live="@IsLiveAttributeValue">
        <p class="display-eyebrow">@Options.RestaurantName</p>
        <h1>@_tableLabel</h1>

        <p class="display-lede">Scan to join this table and order from your phone.</p>

        <div class="display-qr">
            @((MarkupString)_qr.QrCodeSvg)
            <div class="display-offline" role="status">
                <p class="display-offline-title">Reconnecting…</p>
                <p class="display-offline-body">
                    This code may have expired. Please ask at the counter for a fresh one.
                </p>
            </div>
        </div>

        @if (_partySize > 0)
        {
            <p class="display-party">
                <span class="display-chip">
                    @_partySize @(_partySize == 1 ? "person" : "people") seated
                </span>
            </p>
        }
        else
        {
            <p class="display-party"><span class="display-chip display-chip-quiet">Table free</span></p>
        }
    </section>
}
else
{
    @* Active table, no code back. Transient rather than fatal — the refresh loop will try again on the
       next boundary — so say so plainly instead of dereferencing a null or showing a blank screen. *@
    <section class="display-card display-surface" id="table-display-surface"
             data-refresh-token="@_refreshSequence" data-fresh-for-ms="@FreshForMilliseconds"
             data-live="@IsLiveAttributeValue">
        <p class="display-eyebrow">@Options.RestaurantName</p>
        <h1>@_tableLabel</h1>
        <p class="display-lede">Preparing the join code…</p>
    </section>
}

<style>
    .display-qr {
        position: relative;
        display: flex;
        justify-content: center;
        margin: 1rem auto 0.5rem;
        max-width: min(70vh, 26rem);
    }

    .display-qr .join-qr-svg {
        width: 100%;
        height: auto;
        border-radius: 0.75rem;
        border: 1px solid var(--hairline, #e2e6ec);
    }

    /* Raised only when js/display.js sets .is-stale on the surface. */
    .display-offline {
        display: none;
    }

    .display-surface.is-stale .display-offline {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        padding: 1rem;
        border-radius: 0.75rem;
        background: rgba(127, 29, 29, 0.94);
        color: #ffffff;
        text-align: center;
    }

    .display-offline-title {
        margin: 0;
        font-size: clamp(1.25rem, 4vw, 1.9rem);
        font-weight: 700;
    }

    .display-offline-body {
        margin: 0;
        max-width: 20rem;
        font-size: 0.95rem;
    }

    .display-party {
        margin: 0.75rem 0 0;
    }

    .display-chip {
        display: inline-block;
        padding: 0.3rem 0.9rem;
        border-radius: 999px;
        background: #e6f4ea;
        color: #1e7a37;
        font-weight: 700;
        font-size: clamp(0.95rem, 2.5vw, 1.15rem);
    }

    .display-chip-quiet {
        background: var(--surface, #f7f8fa);
        color: var(--ink-soft, #55636f);
        font-weight: 600;
    }

    .display-actions {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }
</style>

@code {
    /// <summary>Which of the §11.5 states this display resolved to.</summary>
    private enum DisplayStage
    {
        /// <summary>No live device credential: §11.5 sends the screen to the pairing surface.</summary>
        NotPaired,

        /// <summary>A live device, but it belongs to a different table (§3.7's table-claim rule).</summary>
        WrongTable,

        /// <summary>Paired and correct, but the table is deactivated — no code renders (§4.1).</summary>
        TableOutOfService,

        /// <summary>Paired, correct, and in service: the rotating QR.</summary>
        Live,
    }

    private DisplayStage _stage = DisplayStage.NotPaired;
    private Guid? _deviceIdentifier;
    private Guid? _deviceTable;
    private string? _deviceTableLabel;
    private string _tableLabel = string.Empty;
    private TableJoinQrCode? _qr;
    private int _partySize;
    private int _refreshSequence;

    // Captured once, so nothing ever touches _lifetime.Token after Dispose has run.
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationToken _stopping;
    private IDisposable? _subscription;
    private bool _liveWorkStarted;
    private bool _disposed;

    [Parameter]
    public Guid TableId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string PageTitleText => _stage == DisplayStage.NotPaired
        ? "Pair this display"
        : string.IsNullOrEmpty(_tableLabel) ? "Table display" : _tableLabel;

    /// <summary>
    /// How long a rendered code stays trustworthy, for js/display.js (§11.5). The arithmetic lives in
    /// <see cref="DisplayRefreshSchedule"/> so it can be tested without a circuit.
    /// </summary>
    private int FreshForMilliseconds
        => DisplayRefreshSchedule.FreshForMilliseconds(Options.TableJoinTokenRotationSeconds);

    /// <summary>
    /// Whether a live circuit produced this markup — <c>"true"</c> only in interactive-server rendering,
    /// <c>"false"</c> during the prerender pass.
    ///
    /// <para>Published because §11.5's central hazard is that <em>a frozen QR looks exactly like a live
    /// one</em>, and the most complete way for it to freeze is for interactivity never to arrive at all:
    /// if <c>/_framework/blazor.web.js</c> cannot be fetched, the prerendered code sits on the glass for
    /// as long as the tablet is left alone, and nothing else on the page differs by so much as a pixel.
    /// One attribute turns that into something an operator can read in dev tools and something the §16.3
    /// scenarios can wait for, instead of a display that simply never advances.</para>
    ///
    /// <para><c>js/display.js</c> does not need it: the staleness curtain already covers a circuit that
    /// dies <em>later</em>, because <c>data-refresh-token</c> stops changing. This covers the case where
    /// it never lived.</para>
    /// </summary>
    private string IsLiveAttributeValue => RendererInfo.IsInteractive ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        _stopping = _lifetime.Token;

        if (AuthenticationStateTask is null)
        {
            _stage = DisplayStage.NotPaired;
            return;
        }

        // The cascading authentication state is the circuit-safe way to read the principal: there is no
        // HttpContext once the component is interactive, and it works identically during the prerender
        // pass. The device principal reaches both because the middleware runs on /display AND /_blazor.
        AuthenticationState state = await AuthenticationStateTask;

        _deviceIdentifier = DisplayDevicePrincipal.DeviceIdentifierFor(state.User);
        _deviceTable = DisplayDevicePrincipal.TableIdentifierFor(state.User);
        _deviceTableLabel = DisplayDevicePrincipal.TableLabelFor(state.User);

        if (_deviceIdentifier is null || _deviceTable is null)
        {
            // §11.5: "Unpaired device → redirect /display/pair". During the prerender pass this becomes
            // an HTTP redirect and the circuit never starts; on the circuit it is a navigation. The
            // rendered not-paired card above stands behind it either way.
            _stage = DisplayStage.NotPaired;
            Navigation.NavigateTo(DisplayRoutes.Pair);
            return;
        }

        if (_deviceTable.Value != TableId)
        {
            _stage = DisplayStage.WrongTable;
            return;
        }

        _tableLabel = _deviceTableLabel ?? string.Empty;
        await LoadAsync();

        StartLiveWorkIfNeeded();
    }

    // A safety net, not the primary path: OnInitializedAsync above starts the live work as soon as it knows
    // the stage, which needs no render at all. This catches any future edit that returns early and still
    // ends up in a stage worth refreshing. firstRender is deliberately ignored — see below.
    protected override void OnAfterRender(bool firstRender)
        => StartLiveWorkIfNeeded();

    /// <summary>
    /// Starts the §4.3 refresh timer and the §9 subscription, once, as soon as this component is both
    /// interactive and past the point of knowing which §11.5 state it is in.
    ///
    /// <para><b>Deliberately not gated on <c>firstRender</c>, which is the bug this replaces.</b>
    /// <c>ComponentBase</c> calls <c>StateHasChanged()</c> the moment <c>OnInitializedAsync</c> yields,
    /// and it yields on the first of four database round trips inside <see cref="LoadAsync"/>. The
    /// client's acknowledgement of that first (empty) batch is one loopback message and routinely beats
    /// them, so <c>OnAfterRender(firstRender: true)</c> arrives while <c>_stage</c> is still its default
    /// <c>NotPaired</c> — a state the old guard rejected. <c>firstRender</c> is never true again, so the
    /// refresh loop was never started at all, and the display sat frozen on the code it was born with for
    /// as long as the tablet was left alone. Intermittent by construction: it turns on which of a
    /// WebSocket round trip and four queries finishes first.</para>
    ///
    /// <para>Idempotence comes from <c>_liveWorkStarted</c> rather than from the lifecycle, so it does not
    /// matter how many times or from where this is called. <c>RendererInfo.IsInteractive</c> is what keeps
    /// the prerender pass from starting a timer on a render that is about to be thrown away — the honest
    /// question, and the one <c>firstRender</c> was standing in for.</para>
    /// </summary>
    private void StartLiveWorkIfNeeded()
    {
        if (_liveWorkStarted || _disposed || !RendererInfo.IsInteractive)
        {
            return;
        }

        // Nothing to keep fresh, and nothing that will ever become fresh: an unpaired device is on its way
        // to /display/pair, and a device on the wrong table renders no code by design (§3.7). Not latched,
        // because both are terminal for this component instance — a re-pair is a new page load.
        if (_stage is DisplayStage.NotPaired or DisplayStage.WrongTable)
        {
            return;
        }

        _liveWorkStarted = true;
        _subscription = Broadcaster.Subscribe(OnDomainNotification);
        _ = RunRefreshLoopAsync();
    }

    /// <summary>
    /// Re-reads everything the surface shows. Revalidating the device on every pass is what makes §4.2's
    /// "revocation kills the device on its next request <b>or circuit revalidation</b>" true for a screen
    /// that may sit on one circuit for a week — and it doubles as the <c>last_seen_at</c> heartbeat,
    /// since that touch is rate-limited to once a minute inside the authenticator.
    /// </summary>
    private async Task LoadAsync()
    {
        DisplayDeviceSession? session = await Devices.RevalidateAsync(_deviceIdentifier!.Value, _stopping);
        if (session is null)
        {
            _stage = DisplayStage.NotPaired;
            _qr = null;
            return;
        }

        _tableLabel = session.TableLabel;
        _deviceTableLabel = session.TableLabel;

        if (!session.TableIsActive)
        {
            // §4.1: deactivating a table stops its display rendering. The device stays paired.
            _stage = DisplayStage.TableOutOfService;
            _qr = null;
            return;
        }

        _stage = DisplayStage.Live;
        _qr = await JoinTokens.DescribeCurrentAsync(TableId, _stopping);

        TableSittingSummary? sitting = await Sittings.GetOpenSittingAsync(TableId, _stopping);
        _partySize = sitting?.MemberCount ?? 0;
        _refreshSequence++;
    }

    /// <summary>
    /// The window-aligned refresh (§4.3: "the display re-renders on a server timer aligned to the window
    /// boundary — fire at <c>(window_index+1) × rotation</c>"). The next boundary comes from the code
    /// just rendered, so the loop stays aligned without keeping its own notion of the window.
    ///
    /// <para><b>Why the broad catch.</b> This loop is fire-and-forget, so an exception escaping it becomes
    /// an unobserved task exception: the loop stops, nothing is logged, and the screen keeps showing the
    /// last code it managed to render — forever, and identically to a healthy one. A dropped connection or
    /// a moment of database unavailability, neither of them the display's fault, would permanently freeze a
    /// screen the restaurant is trusting. Absorbing it and waiting for the next boundary is the behaviour
    /// §11.5 actually wants, and it is not a swallow: it is logged, and <c>_refreshSequence</c> stops
    /// advancing, so <c>js/display.js</c> raises the offline curtain if the trouble outlasts
    /// <c>data-fresh-for-ms</c>. Cancellation and disposal still end the loop, because those mean the
    /// circuit is genuinely gone.</para>
    /// </summary>
    private async Task RunRefreshLoopAsync()
    {
        while (!_stopping.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(DelayUntilNextWindow(), _stopping);
                await InvokeAsync(RefreshAsync);
            }
            catch (OperationCanceledException)
            {
                return; // the circuit went away
            }
            catch (ObjectDisposedException)
            {
                return; // torn down mid-flight
            }
            catch (Exception exception)
            {
                Logger.LogWarning(
                    exception,
                    "Refreshing the display surface for table {TableIdentifier} failed; retrying at the next rotation boundary.",
                    TableId);
            }
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();

        if (_stage == DisplayStage.NotPaired)
        {
            // Revoked while we were watching. A full-page navigation re-runs the middleware, which
            // clears the dead cookie, so the pairing screen greets it with "this display was
            // disconnected" rather than a bare form (§11.5).
            Navigation.NavigateTo(DisplayRoutes.Pair, forceLoad: true);
            return;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Time until just after the next rotation boundary, taken from the code currently on screen so the
    /// loop stays aligned without keeping its own notion of the window. The arithmetic — the overshoot,
    /// the floor, and the ceiling that defends against a clock jump — lives in
    /// <see cref="DisplayRefreshSchedule"/>, where it is unit-tested.
    /// </summary>
    private TimeSpan DelayUntilNextWindow()
        => DisplayRefreshSchedule.DelayUntilNextRefresh(
            Clock.UtcNow,
            _qr?.NextRotationAt,
            Options.TableJoinTokenRotationSeconds);

    /// <summary>
    /// §9 attaches the party-size chip to <c>SittingMemberJoined</c>, and a close empties the table, so
    /// both are re-read. The sitting identifier is deliberately not compared: the very notification that
    /// matters most — the first person joining — announces a sitting this surface has never seen, so
    /// filtering on a known id would drop it. One cheap scoped query per table event is the right trade.
    /// </summary>
    private void OnDomainNotification(DomainNotification notification)
    {
        if (notification is not SittingMemberJoined && notification is not SittingClosed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                TableSittingSummary? sitting = await Sittings.GetOpenSittingAsync(TableId, _stopping);
                _partySize = sitting?.MemberCount ?? 0;
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
                // Disposed between the broadcast and the query; nothing to update.
            }
            catch (ObjectDisposedException)
            {
                // Same, one layer down.
            }
        });
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _subscription?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
