@page "/counter/sittings/{SittingId:guid}"
@attribute [Authorize(Policy = AuthorizationPolicies.Counter)]
@using System.Globalization
@using MyRestaurant.DataAccess.Menu
@using MyRestaurant.DataAccess.Orders
@using MyRestaurant.DataAccess.Sittings
@using MyRestaurant.Domain.Identifiers
@using MyRestaurant.Domain.LiveUpdates
@using MyRestaurant.Domain.Orders
@using MyRestaurant.WebApplication.Orders
@using MyRestaurant.WebApplication.Sittings
@implements IDisposable
@inject ICounterBoardReads CounterReads
@inject IOrderReadModel OrderReads
@inject ISittingDirectory SittingDirectory
@inject IMenuDirectory MenuDirectory
@inject IOrderWorkflow Workflow
@inject ISittingWorkflow Settlement
@inject IIdentifierFactory Identifiers
@inject IDomainEventBroadcaster Broadcaster
@inject RestaurantOptions Options
@inject RestaurantTime RestaurantClock

@* One sitting, at the till (TECHNICAL_SPECIFICATION §11.3, §5.3, §6.7).

   Everything §11.3 asks for on this screen: per-person and table totals from sitting_bill, the lines
   with their states, a price-adjustment dialog that demands a reason, staff add and remove, the
   pending-lines warning, and Close & settle.

   Nothing here enforces §6.5 or §5.3. Every button goes through IOrderWorkflow or ISittingWorkflow to
   the one transaction, which re-decides under the lock (§6.6) — so a guest sending while the counter
   presses Close produces one winner and one plainly-reported refusal, rather than a total computed over
   a half-written order. What this surface refuses on its own it refuses only to make the answer
   immediate.

   Once the sitting is closed the controls disappear, and that is §11.3's "closed-sitting lookup
   (read-only)" rather than a second page: §6.5.8 admits nothing but an administrator's corrective events
   after a close, so a counter's Adjust button there would be a door that only ever answers no. Both the
   stamped settled total and — when §6.7 corrections exist — the current corrected total are shown, which
   is what §5.3 requires. *@

<PageTitle>@(_sitting is null ? "Sitting" : $"Counter — {_sitting.TableLabel}")</PageTitle>

@* §11.10's pair. data-live says whether a circuit produced this markup at all; data-loaded whether
   the queries behind the bill have answered — see IsLiveAttributeValue and IsLoadedAttributeValue. *@
<section class="panel counter-sitting-page" id="counter-sitting-surface"
         data-live="@IsLiveAttributeValue"
         data-loaded="@IsLoadedAttributeValue">
    <p class="eyebrow">Counter</p>

    @if (!_loaded)
    {
        <h1>Loading…</h1>
    }
    else if (_sitting is null)
    {
        <h1>Sitting not found</h1>
        <p class="lede">No sitting exists with that identifier. It may have never existed, or the link is stale.</p>
        <p><a href="/counter">Back to the counter</a></p>
    }
    else
    {
        <div class="counter-detail-header">
            <div>
                <h1>@_sitting.TableLabel</h1>
                <p class="counter-detail-meta">
                    opened @RestaurantClock.DateAndTime(_sitting.OpenedAt) ·
                    @_sitting.MemberCount @(_sitting.MemberCount == 1 ? "guest" : "guests")@SettledSuffix
                </p>
            </div>
            <div class="counter-detail-total">
                <span class="counter-detail-total-label">
                    @(_sitting.IsOpen ? "Running total" : "Settled total")
                </span>
                <span class="counter-detail-total-amount">@Money(_sitting.AmountToShow)</span>
                @if (_sitting.HasPostCloseCorrections)
                {
                    @* §5.3: the stamped total is never rewritten; when §6.7 corrections exist both
                       numbers are shown, because they answer two different questions — what was charged,
                       and what the record now says is owed. *@
                    <span class="counter-detail-corrected">
                        corrected to @Money(_sitting.CurrentTotalAmount)
                    </span>
                }
            </div>
        </div>

        @if (_notice is { } notice)
        {
            <p class="status-success" role="status">@notice</p>
        }

        @if (_problem is { } problem)
        {
            <p class="status-error" role="alert">@problem</p>
        }

        @if (_rejectionReasons.Count > 0)
        {
            @* §6.5.9 is all-or-nothing at the granularity of the event, so a refusal names every reason
               rather than only the first. *@
            <ul class="counter-rejection">
                @foreach (string reason in _rejectionReasons)
                {
                    <li>@reason</li>
                }
            </ul>
        }

        @if (!_sitting.IsOpen)
        {
            <p class="counter-readonly" role="note">
                This sitting is settled, so nothing more can be recorded against it from here. Corrections
                after a close are an administrator's, and appear beside the settled total rather than
                changing it (§5.3, §6.7).
            </p>
        }

        @* ---- the bill, person by person (§8.3, §11.3) -------------------------------------------- *@
        @if (_bill.Count == 0)
        {
            <p class="lede">Nobody at this table has ordered anything yet.</p>
        }

        @foreach (SittingBillEntry entry in _bill)
        {
            <article class="counter-person" @key="entry.GuestOrderIdentifier">
                <header class="counter-person-header">
                    <h2>@entry.BillName</h2>
                    <span class="counter-person-total">@Money(entry.PersonTotalAmount)</span>
                </header>

                @if (LinesFor(entry.GuestOrderIdentifier).Count == 0)
                {
                    <p class="muted">Nothing on this order right now.</p>
                }
                else
                {
                    <ul class="counter-lines">
                        @foreach (OrderLineView line in LinesFor(entry.GuestOrderIdentifier))
                        {
                            <li class="counter-line" @key="line.OrderLineIdentifier">
                                <div class="counter-line-main">
                                    <span class="counter-line-quantity">@line.Quantity×</span>
                                    <span class="counter-line-name">@line.MenuItemName</span>
                                    <span class="counter-line-price">
                                        @Money(line.LineTotalAmount)
                                        <span class="counter-line-unit">@Money(line.CurrentUnitPriceAmount) each</span>
                                    </span>
                                </div>

                                <div class="counter-line-badges">
                                    <span class="chip @(line.IsFulfilled ? "chip-ok" : "chip-warn")">
                                        @(line.IsFulfilled ? "delivered" : "with the kitchen")
                                    </span>
                                    <span class="counter-line-when">added @RestaurantClock.Time(line.AddedAt)</span>
                                </div>

                                @if (line.CustomizationNote is { } note)
                                {
                                    <p class="counter-line-note">@note</p>
                                }

                                @if (_sitting.IsOpen)
                                {
                                    <div class="counter-line-actions">
                                        <button type="button" class="link-button" disabled="@_busy"
                                                @onclick="() => StartAdjust(line)">
                                            Adjust price
                                        </button>
                                        <button type="button" class="link-button" disabled="@_busy"
                                                @onclick="() => StartRemove(line)">
                                            Remove
                                        </button>
                                    </div>
                                }

                                @if (_adjustingLine == line.OrderLineIdentifier)
                                {
                                    @* §11.3's "price adjustment dialog (new price + required reason)". The
                                       reason is required by §6.5.7 and by the table's own CHECK, so it is
                                       demanded here rather than discovered on refusal. *@
                                    <div class="counter-editor">
                                        <p class="counter-editor-heading">Adjust the unit price</p>
                                        @* Both inputs carry an id, and only these two do. Only one
                                           editor is ever open (StartAdjust calls CancelEditors first,
                                           and _adjustingLine holds a single line), so an id here is
                                           unique in the document — while without one the two are
                                           distinguishable only by inputmode and maxlength, which is
                                           not a thing anything outside this markup should have to
                                           know. The wrapping label still associates each one
                                           implicitly, so nothing about the accessible name changes. *@
                                        <label class="form-field">
                                            <span>New unit price (@Options.CurrencyCode)</span>
                                            <input id="counter-adjust-price" type="text"
                                                   inputmode="decimal" disabled="@_busy"
                                                   @bind="_adjustPriceText" @bind:event="oninput" />
                                        </label>
                                        <label class="form-field">
                                            <span>Reason (shown on the bill)</span>
                                            <input id="counter-adjust-reason" type="text"
                                                   maxlength="200" disabled="@_busy"
                                                   @bind="_adjustReason" @bind:event="oninput" />
                                        </label>
                                        <div class="form-actions">
                                            <button type="button" class="button-primary" disabled="@_busy"
                                                    @onclick="() => AdjustPriceAsync(line)">
                                                Adjust
                                            </button>
                                            <button type="button" class="button-secondary" disabled="@_busy"
                                                    @onclick="CancelEditors">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                }

                                @if (_removingLine == line.OrderLineIdentifier)
                                {
                                    <div class="counter-editor">
                                        <p class="counter-editor-heading">Take this line off the bill</p>
                                        <label class="form-field">
                                            <span>Reason (optional)</span>
                                            <input type="text" maxlength="200" disabled="@_busy"
                                                   @bind="_removeReason" @bind:event="oninput" />
                                        </label>
                                        <p class="form-footnote">
                                            Removal is terminal. The line stays in the record with whoever
                                            removed it and why; it simply stops being on the bill.
                                        </p>
                                        <div class="form-actions">
                                            <button type="button" class="button-primary" disabled="@_busy"
                                                    @onclick="() => RemoveLineAsync(line)">
                                                Remove the line
                                            </button>
                                            <button type="button" class="button-secondary" disabled="@_busy"
                                                    @onclick="CancelEditors">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </article>
        }

        @* ---- people at the table who have not ordered (§5.1, §11.3) ------------------------------ *@
        @if (MembersWithoutAnOrder.Count > 0)
        {
            <section class="counter-yet-to-order">
                <h2 class="counter-section-heading">At the table, nothing ordered</h2>
                <ul class="counter-name-list">
                    @foreach (SittingMemberSummary member in MembersWithoutAnOrder)
                    {
                        <li @key="member.PersonIdentifier">@member.RosterName</li>
                    }
                </ul>
            </section>
        }

        @* ---- staff add (§6.3, §11.3) ------------------------------------------------------------- *@
        @if (_sitting.IsOpen)
        {
            <section class="counter-add">
                <h2 class="counter-section-heading">Add an item</h2>
                <p class="muted">
                    For the guest who orders by talking to a person instead of to a phone. It goes on their
                    bill, the kitchen is alerted exactly as it would be for their own send (§10.1), and the
                    log records the counter as the actor.
                </p>

                <label class="form-field">
                    <span>For</span>
                    <select disabled="@_busy" @bind="_addPersonText">
                        <option value="">Choose a guest…</option>
                        @foreach (BillablePerson person in PeopleAtTheTable)
                        {
                            <option value="@person.PersonIdentifier">@person.Name</option>
                        }
                    </select>
                </label>

                <label class="form-field">
                    <span>Item</span>
                    <select disabled="@_busy" @bind="_addMenuItemText">
                        <option value="">Choose an item…</option>
                        @foreach (MenuItemSummary item in _menu)
                        {
                            <option value="@item.MenuItemIdentifier" disabled="@(!item.IsActive)">
                                @ItemOptionLabel(item)
                            </option>
                        }
                    </select>
                </label>

                <label class="form-field">
                    <span>Quantity</span>
                    <input type="number" min="1" max="100" disabled="@_busy" @bind="_addQuantity" />
                </label>

                <label class="form-field">
                    <span>Note for the kitchen (optional)</span>
                    <input type="text" maxlength="500" disabled="@_busy"
                           @bind="_addNote" @bind:event="oninput" />
                </label>

                <p class="form-footnote">
                    The price comes from the menu at the moment this is written, not from this screen
                    (§6.5.4). To charge something else, add it and then adjust the price with a reason.
                </p>

                <div class="form-actions">
                    <button type="button" class="button-primary" disabled="@_busy" @onclick="AddLineAsync">
                        Add to the bill
                    </button>
                </div>
            </section>
        }

        @* ---- close and settle (§5.3) ------------------------------------------------------------- *@
        <section class="counter-settle">
            <div class="counter-settle-total">
                <span>Table total</span>
                <strong>@Money(TableTotal)</strong>
            </div>

            @if (_sitting.IsOpen)
            {
                @if (_sitting.HasPendingLines)
                {
                    @* §5.3: "The counter UI must surface still-pending lines prominently before offering
                       Close (remove with reason, or knowingly charge)." *@
                    <p class="counter-pending-warning" role="alert">
                        <strong>
                            @_sitting.PendingLineCount @(_sitting.PendingLineCount == 1 ? "line is" : "lines are")
                            still with the kitchen.
                        </strong>
                        Settle anyway and the table is charged for them. To take one off instead, use
                        <em>Remove</em> on the line above — a reason is optional, but is worth writing.
                    </p>
                }

                @if (_confirmingClose)
                {
                    <p class="counter-settle-confirm" role="alert">
                        Settle @_sitting.TableLabel at <strong>@Money(_sitting.CurrentTotalAmount)</strong>?
                        This stamps the total and stops the table ordering. It cannot be undone from here.
                    </p>
                    @* Both close buttons carry an id, and the reason is that they are otherwise the
                       same selector: "the primary button in the settle section" is Close & settle
                       before the prompt and Yes — close & settle after it. Nothing outside this
                       markup could tell "I opened the confirmation" from "I settled the table", and
                       a close cannot be undone (§5.3) — which makes this the one place in the
                       application where that distinction is most worth having in the markup. The two
                       live in exclusive branches, so each is unique in the document, and neither is
                       styled by its id. *@
                    <div class="form-actions">
                        <button id="counter-close-confirm" type="button" class="button-primary"
                                disabled="@_busy" @onclick="CloseAndSettleAsync">
                            Yes — close &amp; settle
                        </button>
                        <button type="button" class="button-secondary" disabled="@_busy"
                                @onclick="AbandonClose">
                            Not yet
                        </button>
                    </div>
                }
                else
                {
                    <div class="form-actions">
                        <button id="counter-close" type="button" class="button-primary"
                                disabled="@_busy" @onclick="BeginClose">
                            Close &amp; settle
                        </button>
                        <a class="button-secondary" href="@JoinCodePath">Show join code</a>
                    </div>
                }
            }
        </section>

        <p class="counter-back"><a href="/counter">Back to the counter</a></p>
    }
</section>

<style>
