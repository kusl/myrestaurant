@code {
    /// <summary>Somebody the counter can put a line against: a member, or anyone who already has an order.</summary>
    private sealed record BillablePerson(Guid PersonIdentifier, string Name);

    // Captured once, so nothing touches _lifetime.Token after Dispose.
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationToken _stopping;
    private IDisposable? _subscription;
    private bool _disposed;

    private Guid? _person;
    private OrderActorRole _actorRole = OrderActorRole.Counter;
    private bool _loaded;
    private bool _busy;

    private CounterSittingSummary? _sitting;
    private IReadOnlyList<SittingBillEntry> _bill = [];
    private IReadOnlyList<OrderLineView> _lines = [];
    private IReadOnlyList<SittingMemberSummary> _members = [];
    private IReadOnlyList<MenuItemSummary> _menu = [];

    private string? _notice;
    private string? _problem;
    private IReadOnlyList<string> _rejectionReasons = [];

    private Guid? _adjustingLine;
    private string _adjustPriceText = string.Empty;
    private string _adjustReason = string.Empty;

    private Guid? _removingLine;
    private string _removeReason = string.Empty;

    private string _addPersonText = string.Empty;
    private string _addMenuItemText = string.Empty;
    private int _addQuantity = 1;
    private string _addNote = string.Empty;

    private bool _confirmingClose;

    /// <summary>The sitting this screen bills. Every query is scoped by it, never by the table.</summary>
    [Parameter]
    [EditorRequired]
    public Guid SittingId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private decimal TableTotal => _bill.Sum(entry => entry.PersonTotalAmount);

    /// <summary>
    /// People who joined the sitting (§5.1) but have no living order yet (§6.1) — and so no
    /// <c>sitting_bill</c> row, because that view is built from <c>guest_order</c>.
    /// </summary>
    private IReadOnlyList<SittingMemberSummary> MembersWithoutAnOrder
        => _members
            .Where(member => !_bill.Any(entry => entry.PersonIdentifier == member.PersonIdentifier))
            .ToArray();

    /// <summary>
    /// Everyone a line can be added for: the roster, plus anyone who somehow has an order without a
    /// membership row. The union rather than the roster alone, because the picker must never be unable
    /// to name somebody whose bill is on the screen directly above it.
    /// </summary>
    private IReadOnlyList<BillablePerson> PeopleAtTheTable
    {
        get
        {
            List<BillablePerson> people = _members
                .Select(member => new BillablePerson(member.PersonIdentifier, member.RosterName))
                .ToList();

            foreach (SittingBillEntry entry in _bill)
            {
                if (!people.Any(person => person.PersonIdentifier == entry.PersonIdentifier))
                {
                    people.Add(new BillablePerson(entry.PersonIdentifier, entry.BillName));
                }
            }

            return people;
        }
    }

    /// <summary>
    /// The " · settled 3:04 PM by Cass" tail of the header line, built here rather than as nested
    /// conditionals in the markup — it is one sentence, and it reads like one in the source too.
    /// </summary>
    private string SettledSuffix
    {
        get
        {
            if (_sitting is not { ClosedAt: { } closedAt })
            {
                return string.Empty;
            }

            string by = string.IsNullOrWhiteSpace(_sitting.ClosedByName)
                ? string.Empty
                : $" by {_sitting.ClosedByName}";

            return $" · settled {RestaurantClock.DateAndTime(closedAt)}{by}";
        }
    }

    private string JoinCodePath
        => _sitting is null ? "/counter" : $"/counter/tables/{_sitting.TableIdentifier}/join-code";

    /// <summary>
    /// <c>"true"</c> when a circuit rendered this markup, <c>"false"</c> during the prerender pass. The
    /// same attribute, for the same reason, as <c>KitchenBoard</c>'s and <c>TableOrderSurface</c>'s.
    ///
    /// <para>A prerendered till is the dangerous kind of broken, because it is the kind that looks
    /// right: the bill is correct as of the request, every total adds up, and Adjust price, Remove, Add
    /// to the bill and Close &amp; settle are all <c>@onclick</c> handlers with no circuit behind them.
    /// Pressing any of them does nothing at all — no refusal, no flash, no error — and the screen also
    /// never hears §9, so a guest sending while somebody stands at the till changes nothing on it. The
    /// attribute costs eight characters and turns that into something an operator can see in dev tools
    /// and a scenario can name in one sentence.</para>
    /// </summary>
    private string IsLiveAttributeValue => RendererInfo.IsInteractive ? "true" : "false";

    /// <summary>
    /// Whether <see cref="LoadAsync"/> has answered, published alongside <c>data-live</c> — §11.10's
    /// second bit, and the half this surface was missing until M6 Slice 23.
    ///
    /// <para>The circuit's first render is <c>data-live="true"</c> with <c>_loaded</c> still false, and
    /// this page renders <c>&lt;h1&gt;Loading…&lt;/h1&gt;</c> in that state — no bill, no totals, no
    /// controls. Waiting on <c>data-live</c> alone is therefore a wait that lands on the one render
    /// where none of the things a caller came for exist. That is worse than harmless here, because the
    /// state immediately below it in the markup is <em>"Sitting not found"</em>: a reader that arrived
    /// early and asked what the page says would be told the identifier is stale.</para>
    ///
    /// <para>Not the prerender — that emits fully loaded markup. The hand-over, where the component is
    /// rebuilt from nothing and the DOM returns to loading for as long as the reads take (F-44).</para>
    /// </summary>
    private string IsLoadedAttributeValue => _loaded ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        _stopping = _lifetime.Token;

        if (AuthenticationStateTask is not null)
        {
            AuthenticationState state = await AuthenticationStateTask;
            _person = PersonPrincipal.IdentifierFor(state.User);

            // §6.2: a staff_edit or price_adjustment may be authored by counter or administrator.
            // Record what the person actually is — counter wins when they hold both, because that is
            // the capacity they are standing at this screen in.
            _actorRole = state.User.IsInRole(RestaurantRoles.Counter)
                ? OrderActorRole.Counter
                : OrderActorRole.Administrator;
        }

        await LoadAsync();
        _loaded = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Only on the circuit: OnAfterRender does not run during prerendering, so no subscription is
            // created for a render about to be thrown away.
            _subscription = Broadcaster.Subscribe(OnDomainNotification);
        }
    }

    /// <summary>Everything the screen shows, re-read in one pass. Small, indexed queries.</summary>
    private async Task LoadAsync()
    {
        _sitting = await CounterReads.GetSittingAsync(SittingId, _stopping);

        if (_sitting is null)
        {
            _bill = [];
            _lines = [];
            _members = [];
            return;
        }

        _bill = await OrderReads.ListSittingBillAsync(SittingId, _stopping);
        _lines = await OrderReads.ListLinesForSittingAsync(SittingId, _stopping);
        _members = await SittingDirectory.ListMembersAsync(SittingId, _stopping);
        _menu = await MenuDirectory.ListAsync(_stopping);
    }

    private IReadOnlyList<OrderLineView> LinesFor(Guid guestOrderIdentifier)
        => _lines.Where(line => line.GuestOrderIdentifier == guestOrderIdentifier).ToArray();

    private string ItemOptionLabel(MenuItemSummary item)
        => item.IsActive
            ? $"{item.Name} — {Money(item.PriceAmount)}"
            : $"{item.Name} — {Money(item.PriceAmount)} (currently unavailable)";

    private void StartAdjust(OrderLineView line)
    {
        CancelEditors();
        _adjustingLine = line.OrderLineIdentifier;
        _adjustPriceText = line.CurrentUnitPriceAmount.ToString("0.00", CultureInfo.InvariantCulture);
        _adjustReason = string.Empty;
    }

    private void StartRemove(OrderLineView line)
    {
        CancelEditors();
        _removingLine = line.OrderLineIdentifier;
        _removeReason = string.Empty;
    }

    private void CancelEditors()
    {
        _adjustingLine = null;
        _removingLine = null;
        _confirmingClose = false;
    }

    private void BeginClose()
    {
        CancelEditors();
        _confirmingClose = true;
    }

    private void AbandonClose()
    {
        _confirmingClose = false;
    }

    /// <summary>§11.3: "price adjustment dialog (new price + required reason)".</summary>
    private async Task AdjustPriceAsync(OrderLineView line)
    {
        ClearMessages();

        // Parsed invariantly for the reason MoneyText formats invariantly: the amount is a
        // numeric(10,2), and which separator the container's locale happens to use is not a decision
        // anybody made about this restaurant.
        if (!decimal.TryParse(
                _adjustPriceText,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out decimal newUnitPrice)
            || newUnitPrice < 0m)
        {
            _problem = "Enter the new unit price as a plain number, for example 12.50.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_adjustReason))
        {
            _problem = "A price adjustment needs a reason — it is shown beside the change on the bill.";
            return;
        }

        newUnitPrice = Math.Round(newUnitPrice, 2, MidpointRounding.AwayFromZero);

        bool appended = await AppendToOrderAsync(
            line.GuestOrderIdentifier,
            OrderEventType.PriceAdjustment,
            [new LinePriceAdjustedOperation(line.OrderLineIdentifier, newUnitPrice, _adjustReason.Trim())],
            $"{line.MenuItemName} is now {Money(newUnitPrice)} each.");

        if (appended)
        {
            CancelEditors();
        }
    }

    /// <summary>§11.3: "add/remove line (staff edit, optional reason on removal)".</summary>
    private async Task RemoveLineAsync(OrderLineView line)
    {
        bool appended = await AppendToOrderAsync(
            line.GuestOrderIdentifier,
            OrderEventType.StaffEdit,
            [new LineRemovedOperation(line.OrderLineIdentifier, Blank(_removeReason))],
            $"{line.Quantity} × {line.MenuItemName} is off the bill.");

        if (appended)
        {
            CancelEditors();
        }
    }

    /// <summary>
    /// §11.3's staff add, through the living-order path so it works for a member who has never sent
    /// anything — their order is created inside the same transaction (§6.1).
    /// </summary>
    private async Task AddLineAsync()
    {
        ClearMessages();

        if (!Guid.TryParse(_addPersonText, out Guid personIdentifier))
        {
            _problem = "Choose which guest this is for.";
            return;
        }

        BillablePerson? recipient = PeopleAtTheTable
            .FirstOrDefault(person => person.PersonIdentifier == personIdentifier);

        if (recipient is null)
        {
            _problem = "That guest is no longer at this table.";
            return;
        }

        if (!Guid.TryParse(_addMenuItemText, out Guid menuItemIdentifier))
        {
            _problem = "Choose an item to add.";
            return;
        }

        MenuItemSummary? item = _menu
            .FirstOrDefault(candidate => candidate.MenuItemIdentifier == menuItemIdentifier);

        if (item is null)
        {
            _problem = "That item is no longer on the menu.";
            return;
        }

        // §7 keeps a deactivated item visible and unorderable; the transaction re-checks the flag under
        // its own lock (§6.5.4), so this only makes the answer immediate.
        if (!item.IsActive)
        {
            _problem = $"{item.Name} is currently unavailable, so it cannot be added.";
            return;
        }

        if (_addQuantity is < 1 or > 100)
        {
            _problem = "Quantity must be between 1 and 100.";
            return;
        }

        // The line's own identity, UUIDv7 like every other key (ADR-0011). The unit price sent here is
        // ignored: the transaction prices the line from the menu row it reads under the lock (§6.5.4).
        LineAddedOperation added = new(
            Identifiers.Create(),
            menuItemIdentifier,
            _addQuantity,
            item.PriceAmount,
            Blank(_addNote));

        bool appended = await AppendToLivingOrderAsync(
            personIdentifier,
            OrderEventType.StaffEdit,
            [added],
            $"{_addQuantity} × {item.Name} added to {recipient.Name}'s order.");

        if (appended)
        {
            _addMenuItemText = string.Empty;
            _addQuantity = 1;
            _addNote = string.Empty;
        }
    }

    /// <summary>§5.3, through the workflow so the close is counted (§12) and announced (§9).</summary>
    private async Task CloseAndSettleAsync()
    {
        if (_person is not { } person || _busy)
        {
            return;
        }

        _busy = true;
        ClearMessages();

        try
        {
            CloseSittingResult result = await Settlement.CloseAndSettleAsync(SittingId, person, _stopping);

            _confirmingClose = false;

            switch (result.Outcome)
            {
                case CloseSittingOutcome.Closed when result.PendingLineCountAtClose > 0:
                    _notice =
                        $"Settled at {Money(result.SettledTotalAmount ?? 0m)} — with " +
                        $"{result.PendingLineCountAtClose} " +
                        $"{(result.PendingLineCountAtClose == 1 ? "line" : "lines")} still with the kitchen.";
                    break;

                case CloseSittingOutcome.Closed:
                    _notice = $"Settled at {Money(result.SettledTotalAmount ?? 0m)}.";
                    break;

                case CloseSittingOutcome.AlreadyClosed:
                    _notice = $"This table had already been settled at {Money(result.SettledTotalAmount ?? 0m)}.";
                    break;

                default:
                    _problem = "That sitting no longer exists.";
                    break;
            }

            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
            // The circuit went away mid-write. The transaction either committed or did not; either way
            // there is nobody left to tell.
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> AppendToOrderAsync(
        Guid guestOrderIdentifier,
        OrderEventType eventType,
        IReadOnlyList<OrderOperation> operations,
        string successMessage)
    {
        if (_person is not { } person || _busy)
        {
            return false;
        }

        _busy = true;
        ClearMessages();

        try
        {
            AppendOrderEventResult result = await Workflow.AppendStaffEventAsync(
                guestOrderIdentifier,
                new ProposedOrderEvent(eventType, person, _actorRole, operations),
                _stopping);

            return await ReportAsync(result, successMessage);
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> AppendToLivingOrderAsync(
        Guid orderOwnerPersonIdentifier,
        OrderEventType eventType,
        IReadOnlyList<OrderOperation> operations,
        string successMessage)
    {
        if (_person is not { } person || _busy)
        {
            return false;
        }

        _busy = true;

        try
        {
            AppendOrderEventResult result = await Workflow.AppendStaffEventToLivingOrderAsync(
                SittingId,
                orderOwnerPersonIdentifier,
                new ProposedOrderEvent(eventType, person, _actorRole, operations),
                _stopping);

            return await ReportAsync(result, successMessage);
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> ReportAsync(AppendOrderEventResult result, string successMessage)
    {
        if (result.IsAppended)
        {
            _notice = successMessage;
        }
        else
        {
            _problem = DescribeRefusal(result);
            _rejectionReasons = result.Errors.Select(error => error.Reason).ToArray();
        }

        await LoadAsync();
        return result.IsAppended;
    }

    /// <summary>
    /// A refusal in plain words. The likely causes here are races — a guest sending, the kitchen
    /// fulfilling, or somebody else closing a second earlier — so the message says what happened rather
    /// than reading like a fault, and the bill has already been refreshed by the time it is shown.
    /// </summary>
    private static string DescribeRefusal(AppendOrderEventResult result)
    {
        if (result.Outcome is AppendOrderEventOutcome.SittingNotFound)
        {
            return "That sitting no longer exists. Nothing was changed.";
        }

        if (result.Outcome is AppendOrderEventOutcome.OrderNotFound)
        {
            return "There is no order to change here — the table may have been settled. Nothing was changed.";
        }

        return "Nothing was changed. The bill below has been refreshed.";
    }

    private void ClearMessages()
    {
        _notice = null;
        _problem = null;
        _rejectionReasons = [];
    }

    /// <summary>
    /// §9 scopes every relevant notification by sitting, so this filters rather than re-reading on every
    /// event anywhere in the restaurant. <c>MenuChanged</c> is unscoped by construction and matters here
    /// because the add-an-item picker lists the menu (§7).
    /// </summary>
    private void OnDomainNotification(DomainNotification notification)
    {
        bool concernsThisSitting = notification switch
        {
            OrderLinesChanged changed => changed.SittingIdentifier == SittingId,
            LineFulfillmentChanged fulfilled => fulfilled.SittingIdentifier == SittingId,
            SittingMemberJoined joined => joined.SittingIdentifier == SittingId,
            SittingClosed closed => closed.SittingIdentifier == SittingId,
            MenuChanged => true,
            _ => false,
        };

        if (!concernsThisSitting)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            try
            {
                await LoadAsync();
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
                // Disposed between the broadcast and the query; nothing to update.
            }
            catch (ObjectDisposedException)
            {
                // Same, one layer down.
            }
        });
    }

    private string Money(decimal amount) => MoneyText.Format(amount, Options.CurrencyCode);

    private static string? Blank(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _subscription?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
