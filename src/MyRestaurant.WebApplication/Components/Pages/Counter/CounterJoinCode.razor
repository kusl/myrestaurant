@page "/counter/tables/{TableId:guid}/join-code"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = AuthorizationPolicies.Counter)]
@using MyRestaurant.DataAccess.Tables
@using MyRestaurant.WebApplication.Tables
@inject ITableDirectory TableDirectory
@inject ITableJoinTokens JoinTokens
@inject RestaurantOptions Options
@inject RestaurantTime RestaurantClock

<PageTitle>@(_table is null ? "Join code" : $"Join code — {_table.Label}")</PageTitle>

@if (_table is null)
{
    <section class="panel account-panel">
        <p class="eyebrow">Counter</p>
        <h1>Table not found</h1>
        <p class="lede">No table exists with that identifier. It may have never existed, or the link is stale.</p>
        <p><a href="/counter">Back to the counter</a></p>
    </section>
}
else if (!_table.IsActive)
{
    <section class="panel account-panel">
        <p class="eyebrow">Counter</p>
        <h1>@_table.Label</h1>
        <p class="lede">
            This table is deactivated, so its join code does not render and its tokens do not validate
            (§4.1). An administrator can reactivate it from the administration area.
        </p>
        <p class="counter-code-back"><a href="/counter">Back to the counter</a></p>
    </section>
}
else if (_qr is null)
{
    <section class="panel account-panel">
        <p class="eyebrow">Counter</p>
        <h1>@_table.Label</h1>
        <p class="status-error" role="alert">The join code could not be generated just now. Try again.</p>
        <p class="counter-code-back"><a href="@JoinCodePath">Try again</a></p>
    </section>
}
else
{
    <section class="panel account-panel counter-code-panel">
        <p class="eyebrow">Counter — join code</p>
        <h1>@_table.Label</h1>
        <p class="lede">
            Hold this up for the guest to scan. It is the same rotating code @_table.Label's own display
            shows (§4.5) — use it when that display is down. The private join secret never leaves the
            server.
        </p>

        <div class="counter-qr">
            @((MarkupString)_qr.QrCodeSvg)
        </div>

        <p class="counter-code-url-label">The code links to:</p>
        <p class="counter-code-url">@_qr.JoinUrl</p>

        <p class="counter-code-rotation">
            Rotates every @Options.TableJoinTokenRotationSeconds seconds — next at
            <strong>@RestaurantClock.TimeWithSeconds(_qr.NextRotationAt)</strong>
            (about @SecondsUntilRotation second@(SecondsUntilRotation == 1 ? "" : "s") from now). A code
            that has just been scanned keeps working for up to about
            @(Options.TableJoinTokenRotationSeconds * 2) seconds, so it will not stop working while a
            guest is pointing a phone at it.
        </p>

        <div class="form-actions">
            <a class="button-primary" href="@JoinCodePath">Show a fresh code</a>
            <a class="button-secondary" href="/counter">Back to the counter</a>
        </div>
    </section>
}

<style>
    .counter-code-panel .counter-qr {
        display: flex;
        justify-content: center;
        margin: 1.25rem 0;
    }

    .counter-code-panel .join-qr-svg {
        width: 100%;
        max-width: 26rem;
        height: auto;
        border-radius: 0.5rem;
        border: 1px solid var(--hairline);
    }

    .counter-code-url-label {
        margin: 0.75rem 0 0.25rem;
        font-size: 0.85rem;
        color: var(--ink-soft);
    }

    .counter-code-url {
        margin: 0 0 1rem;
        padding: 0.5rem 0.65rem;
        border-radius: 0.4rem;
        background: var(--surface);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85rem;
        word-break: break-all;
    }

    .counter-code-rotation {
        margin: 0 0 1.25rem;
        color: var(--ink-soft);
        font-size: 0.9rem;
    }

    .counter-code-back {
        margin-top: 1.5rem;
    }
</style>

@code {
    private RestaurantTableSummary? _table;
    private TableJoinQrCode? _qr;

    [Parameter]
    public Guid TableId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string JoinCodePath => $"/counter/tables/{TableId}/join-code";

    private int SecondsUntilRotation => _qr is null
        ? 0
        : Math.Max(0, (int)Math.Ceiling((_qr.NextRotationAt - _qr.GeneratedAt).TotalSeconds));

    protected override async Task OnInitializedAsync()
    {
        _table = await TableDirectory.GetTableAsync(TableId, HttpContext.RequestAborted);

        if (_table is null || !_table.IsActive)
        {
            return;
        }

        _qr = await JoinTokens.DescribeCurrentAsync(TableId, HttpContext.RequestAborted);
    }
}
