@using System.Globalization
@using MyRestaurant.Domain.Time
@inject IClock Clock
@inject RestaurantTime RestaurantClock

<footer class="app-footer">
    <p class="restaurant-clock"
       id="@ElementId"
       data-epoch-milliseconds="@_epochMilliseconds"
       data-utc-offset-minutes="@_utcOffsetMinutes"
       data-next-transition-epoch-milliseconds="@_nextTransitionEpochMilliseconds"
       data-next-utc-offset-minutes="@_nextUtcOffsetMinutes"
       data-twelve-hour-clock="@_twelveHourClock"
       data-snapshot-url="@RestaurantClockRoutes.Snapshot">
        <span class="restaurant-clock-label">Restaurant time</span>
        <time class="restaurant-clock-reading"
              data-restaurant-clock-reading="true"
              datetime="@_machineReadable">@_reading</time>
        <span class="restaurant-clock-zone" title="@_zoneIdentifier">@_zoneLabel</span>
    </p>
</footer>

@code {
    public const string ElementId = "restaurant-clock";

    private string _epochMilliseconds = string.Empty;
    private string _utcOffsetMinutes = string.Empty;
    private string _nextTransitionEpochMilliseconds = string.Empty;
    private string _nextUtcOffsetMinutes = string.Empty;
    private string _twelveHourClock = "true";
    private string _machineReadable = string.Empty;
    private string _reading = string.Empty;
    private string _zoneLabel = string.Empty;
    private string _zoneIdentifier = string.Empty;

    protected override void OnInitialized()
    {
        DateTimeOffset now = Clock.UtcNow;
        RestaurantClockSnapshot snapshot = RestaurantClock.Snapshot(now);

        _epochMilliseconds = snapshot.EpochMilliseconds.ToString(CultureInfo.InvariantCulture);
        _utcOffsetMinutes = snapshot.UtcOffsetMinutes.ToString(CultureInfo.InvariantCulture);
        _nextTransitionEpochMilliseconds =
            snapshot.NextTransitionEpochMilliseconds?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        _nextUtcOffsetMinutes =
            snapshot.NextUtcOffsetMinutes?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        _twelveHourClock = snapshot.UsesTwelveHourClock ? "true" : "false";

        _reading = RestaurantClock.DateAndTimeWithSeconds(now);
        _machineReadable = RestaurantClock.MachineReadable(now);
        _zoneLabel = snapshot.ZoneLabel;
        _zoneIdentifier = snapshot.ZoneIdentifier;
    }

    protected override bool ShouldRender() => false;
}
