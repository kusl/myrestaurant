@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="app-brand" href="/">MyRestaurant</a>
        <nav class="app-session" aria-label="Session">
            <AuthorizeView>
                <Authorized>
                    <span class="session-name">@context.User.Identity?.Name</span>
                    <AuthorizeView Roles="administrator" Context="administrator">
                        <a class="session-link" href="/administration">Administration</a>
                    </AuthorizeView>
                    <AuthorizeView Roles="kitchen" Context="kitchen">
                        <a class="session-link" href="/kitchen">Kitchen</a>
                    </AuthorizeView>
                    <AuthorizeView Roles="counter" Context="counter">
                        <a class="session-link" href="/counter">Counter</a>
                    </AuthorizeView>
                    <a class="session-link" href="@AccountRoutes.Profile">Account</a>
                    <form class="sign-out-form" method="post" action="@AccountRoutes.SignOut">
                        <AntiforgeryToken />
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="session-link" href="@AccountRoutes.SignIn">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>

    <RestaurantClockFooter />

    <AppColophon />
</div>
