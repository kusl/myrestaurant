@inherits LayoutComponentBase

@* The shared shell. The session header uses a plain HTML form for sign-out — a full-page POST to
   the /sign-out endpoint with the antiforgery token — so it behaves identically whether the hosting
   page renders as static SSR (the account pages) or over an interactive circuit. The Administration
   link is shown only to the administrator role: <AuthorizeView Roles="administrator"> matches the role
   claim the RestaurantClaimsPrincipalFactory emits under the configured RoleClaimType, the same claim
   the area.administration policy checks (§3.7).

   One Account link rather than one per credential surface: the profile page (§11.6) is the hub for the display name, contact
   details, password, authenticator, and passkeys. The header is the only chrome the phone-sized
   guest surface has, and four session links plus a name wrapped onto three rows at 375px.

   The Kitchen link is shown to the kitchen role ONLY, not to administrators, even though
   area.kitchen admits both (§3.7). An administrator already carries an Administration link, and
   adding a second area link would put five items in a header that wrapped onto three rows at 375px
   the last time it held four. Administrators reach the board from the landing page's area links
   instead — see Pages/Home.razor. *@
<div class="app-shell">
    <header class="app-header">
        <a class="app-brand" href="/">MyRestaurant</a>
        <nav class="app-session" aria-label="Session">
            <AuthorizeView>
                <Authorized>
                    <span class="session-name">@context.User.Identity?.Name</span>
                    <AuthorizeView Roles="administrator" Context="administrator">
                        <a class="session-link" href="/administration">Administration</a>
                    </AuthorizeView>
                    <AuthorizeView Roles="kitchen" Context="kitchen">
                        <a class="session-link" href="/kitchen">Kitchen</a>
                    </AuthorizeView>
                    <a class="session-link" href="@AccountRoutes.Profile">Account</a>
                    <form class="sign-out-form" method="post" action="@AccountRoutes.SignOut">
                        <AntiforgeryToken />
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="session-link" href="@AccountRoutes.SignIn">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>

    @* Every instant on every surface is rendered in RESTAURANT_TIME_ZONE, never the reader's own
       (§8.1). This says so, and keeps saying what time it is there. On every page, in both layouts. *@
    <RestaurantClockFooter />
</div>
