<Project>

  <!--
    Solution-wide build settings. Package *versions* live in Directory.Packages.props
    (central package management); nothing else in the tree pins a version (REQUIREMENTS §2,
    TECHNICAL_SPECIFICATION §16). Keep this file free of per-package references.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      The application resolves RESTAURANT_TIME_ZONE through TimeZoneInfo, so globalization
      must stay on and the runtime container installs tzdata (BUILD_PROGRESS: known caveats).
      Do not set InvariantGlobalization=true.
    -->
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Warnings are not errors for a plain `dotnet build`: a fresh clone on a newer SDK must build
      through analyzer drift rather than refusing at the door (README: known caveats).
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    ...and they ARE errors in CI, which passes -p:ContinuousIntegrationBuild=true
    (.github/workflows/ci.yml, TECHNICAL_SPECIFICATION §16.4). This is the answer to the note this
    file carried from M1 — "flip to true once the first green build is established". The first green
    build is long established; what stayed unresolved is that flipping it globally would make a
    fresh clone on tomorrow's SDK fail at the door, which is a worse outcome than a warning nobody
    read. Conditioning on the property CI already sets gets the strictness where it belongs and
    leaves `dotnet build` on a workstation lenient.

    NuGet audit findings (NU1901-NU1904) stay warnings even there. They appear when an advisory is
    published against a package this tree already depends on — real news, but news that arrives on a
    day nobody touched the repository, and a pipeline that turns red without a commit is a pipeline
    people learn to ignore. CI reports them in a dedicated non-blocking step instead.
  -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Identity of the built assemblies (TECHNICAL_SPECIFICATION §11.9, §12).

    VersionPrefix is what an untagged build reports. `Version` defaults to it, `InformationalVersion`
    defaults to `Version`, and the SDK writes the latter into AssemblyInformationalVersionAttribute —
    which is where WebApplication/Configuration/BuildInformation reads it back out. The release
    pipeline overrides Version from the git tag, so the two can disagree only on main between tags,
    which is correct: a build off main is not the release, and saying so is the point.

    The SDK will also append "+$(SourceRevisionId)" by itself, but only when
    SourceControlInformationFeatureSupported is true — a property SourceLink sets and nothing else in
    the SDK does. Rather than take a package dependency to obtain one string, the Containerfile passes
    InformationalVersion explicitly from its VERSION and SOURCE_REVISION build arguments, and the
    workflows fill those in from the tag and the commit. A build that was told neither reports its
    version with no revision, and the /source page says as much rather than inventing one.

    Bumping VersionPrefix is a step in the release procedure (OPERATIONS §14), not something CI does.
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Product>MyRestaurant</Product>
    <Company>MyRestaurant</Company>
    <Authors>MyRestaurant</Authors>
    <Description>Self-hosted, single-restaurant ordering system.</Description>
    <Copyright>Copyright (C) 2026 the MyRestaurant authors</Copyright>
  </PropertyGroup>

</Project>
