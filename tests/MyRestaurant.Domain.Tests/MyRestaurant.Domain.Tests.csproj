<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure domain tests: no database, no host, deterministic. They pin crypto against precomputed
    vectors and exercise every §6.5 order-mutation invariant. xUnit v3 test projects are console
    apps, hence OutputType=Exe (BUILD_PROGRESS / xUnit v3 requirement).

    THERE IS NO TEST ADAPTER PACKAGE HERE, and there is no longer one in any of the four test
    projects (F-97). `xunit.v3` carries Microsoft.Testing.Platform support natively, the runner is
    selected once for the repository in `global.json`, and `Microsoft.NET.Test.Sdk` plus
    `xunit.runner.visualstudio` — the VSTest half — were deleted rather than pinned back, because
    MTP 2 refuses the VSTest target on the .NET 10 SDK at build time. `dotnet run` in this folder
    runs the tests too; that is what OutputType=Exe means here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MyRestaurant.Domain.Tests</RootNamespace>
    <AssemblyName>MyRestaurant.Domain.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MyRestaurant.Domain/MyRestaurant.Domain.csproj" />
  </ItemGroup>

</Project>
