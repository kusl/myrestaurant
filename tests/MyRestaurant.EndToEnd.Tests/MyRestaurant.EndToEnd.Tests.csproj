<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Playwright end-to-end scenarios covering the §16.3 matrix. The harness arrived at M6 Slice 2:
    each implemented scenario creates its own database on a shared PostgreSQL 17 container
    (Testcontainers), boots the already-built web application as a child process on a free loopback
    port, and drives it through Chromium with a CDP virtual authenticator.

    The scenarios are OPT-IN — they skip unless MYRESTAURANT_E2E=1 — because the first run downloads
    Chromium (~150 MB) into ~/.cache/ms-playwright, and `dotnet test` should not do that by surprise.
    See Harness/RestaurantHarness.cs and `scripts/ci_local.sh - - with-e2e`. (remove space between the two dashes)

    References, in the same explicit spirit as MyRestaurant.WebApplication.Tests:
      • Microsoft.AspNetCore.App, because the WebApplication project reference below is a Web SDK
        project and the tests name AccountRoutes from it (framework-reference propagation across a
        Web SDK reference is not something to lean on);
      • MyRestaurant.WebApplication, for AccountRoutes and DisplayRoutes — the tests assert on the
        very route constants the app routes on, rather than on string literals that can drift. The
        reference also makes the web application a BUILD dependency of this project, which is what
        lets the harness expect its binaries to exist on disk;
      • MyRestaurant.Domain, for the real JoinTokenService / Rfc6238Totp / Base32Text. The harness
        computes tokens and authenticator codes with the same code the server validates them with;
      • Npgsql, to create a per-scenario database and to arrange fixtures (§4.1 rows) directly;
      • Testcontainers.PostgreSql, for the shared PostgreSQL 17 container;
      • Net.Codecrete.QrCodeGenerator, so that Harness/JoinQrCodes.cs can compute the exact SVG path
        a table display must be showing for a given window (§16.3 scenarios 2 and 15). It arrives
        transitively through the web application anyway — CentralPackageTransitivePinningEnabled sees
        to the version — but a file that types `QrCode.EncodeText` should say so itself rather than
        depend on a reference chain that a future refactor could shorten without noticing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MyRestaurant.EndToEnd.Tests</RootNamespace>
    <AssemblyName>MyRestaurant.EndToEnd.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MyRestaurant.WebApplication/MyRestaurant.WebApplication.csproj" />
    <ProjectReference Include="../../src/MyRestaurant.Domain/MyRestaurant.Domain.csproj" />
  </ItemGroup>

</Project>
